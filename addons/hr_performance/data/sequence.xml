<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Reference number for appraisals, e.g. APR/2026/0001 -->
    <record id="seq_hr_performance_appraisal" model="ir.sequence">
        <field name="name">Performance Appraisal Reference</field>
        <field name="code">hr.performance.appraisal</field>
        <field name="prefix">APR/%(year)s/</field>
        <field name="padding">4</field>
        <field name="number_increment">1</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
