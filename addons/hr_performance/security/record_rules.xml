<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         Appraisals
         HR creates every appraisal and sees all of them. Department
         managers only see appraisals they were asked to score; the
         employee only sees their own once it was sent to them.
         Field-level groups hide scores/comments from employees, and
         write() limits what each participant can change at each stage.
         ============================================================ -->

    <record id="rule_hr_performance_appraisal_hr_manager" model="ir.rule">
        <field name="name">Performance Appraisal: HR Manager (all)</field>
        <field name="model_id" ref="model_hr_performance_appraisal"/>
        <field name="groups" eval="[(4, ref('group_hr_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_hr_performance_appraisal_dept_manager" model="ir.rule">
        <field name="name">Performance Appraisal: Assigned Department Manager</field>
        <field name="model_id" ref="model_hr_performance_appraisal"/>
        <field name="groups" eval="[(4, ref('group_dept_manager'))]"/>
        <field name="domain_force">
            [('include_dept_manager', '=', True),
             ('manager_id.user_id', '=', user.id),
             ('state', '!=', 'draft')]
        </field>
    </record>

    <record id="rule_hr_performance_appraisal_ceo" model="ir.rule">
        <field name="name">Performance Appraisal: CEO (non-draft)</field>
        <field name="model_id" ref="model_hr_performance_appraisal"/>
        <field name="groups" eval="[(4, ref('group_ceo'))]"/>
        <field name="domain_force">[('state', '!=', 'draft')]</field>
    </record>

    <record id="rule_hr_performance_appraisal_employee" model="ir.rule">
        <field name="name">Performance Appraisal: Own Appraisal (Employee)</field>
        <field name="model_id" ref="model_hr_performance_appraisal"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">
            [('include_employee', '=', True),
             ('employee_id.user_id', '=', user.id),
             ('state', '!=', 'draft')]
        </field>
    </record>

    <!-- ============================================================
         Appraisal lines: same visibility as their appraisal
         ============================================================ -->

    <record id="rule_hr_performance_appraisal_line_hr" model="ir.rule">
        <field name="name">Performance Appraisal Line: HR Manager (all)</field>
        <field name="model_id" ref="model_hr_performance_appraisal_line"/>
        <field name="groups" eval="[(4, ref('group_hr_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_hr_performance_appraisal_line_dept_manager" model="ir.rule">
        <field name="name">Performance Appraisal Line: Assigned Department Manager</field>
        <field name="model_id" ref="model_hr_performance_appraisal_line"/>
        <field name="groups" eval="[(4, ref('group_dept_manager'))]"/>
        <field name="domain_force">
            [('appraisal_id.include_dept_manager', '=', True),
             ('appraisal_id.manager_id.user_id', '=', user.id),
             ('appraisal_id.state', '!=', 'draft')]
        </field>
    </record>

    <record id="rule_hr_performance_appraisal_line_ceo" model="ir.rule">
        <field name="name">Performance Appraisal Line: CEO (non-draft)</field>
        <field name="model_id" ref="model_hr_performance_appraisal_line"/>
        <field name="groups" eval="[(4, ref('group_ceo'))]"/>
        <field name="domain_force">[('appraisal_id.state', '!=', 'draft')]</field>
    </record>

    <record id="rule_hr_performance_appraisal_line_employee" model="ir.rule">
        <field name="name">Performance Appraisal Line: Own Appraisal (Employee)</field>
        <field name="model_id" ref="model_hr_performance_appraisal_line"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">
            [('appraisal_id.include_employee', '=', True),
             ('appraisal_id.employee_id.user_id', '=', user.id),
             ('appraisal_id.state', '!=', 'draft')]
        </field>
    </record>

    <!-- ============================================================
         Employees (formerly create_data's restrictive rule)
         ============================================================ -->

    <!-- Department Managers only see employees of their own department
         (including sub-departments) and their own employee record. -->
    <record id="rule_hr_employee_dept_manager" model="ir.rule">
        <field name="name">Employee: Department Manager sees own department</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="groups" eval="[(4, ref('group_dept_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="domain_force">
            ['|',
                ('user_id', '=', user.id),
                ('department_id', 'child_of', user.employee_id.department_id.ids)
            ]
        </field>
    </record>

    <!-- HR Manager and CEO see all employees (keeps them unrestricted
         even if they also hold the Department Manager role). -->
    <record id="rule_hr_employee_hr_ceo_all" model="ir.rule">
        <field name="name">Employee: HR Manager / CEO see all</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="groups" eval="[(4, ref('group_hr_manager')), (4, ref('group_ceo'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- Template: Dept Manager sees only templates for their department -->
    <record id="rule_hr_performance_template_dept_manager" model="ir.rule">
        <field name="name">Performance Template: Department Manager</field>
        <field name="model_id" ref="model_hr_performance_template"/>
        <field name="groups" eval="[(4, ref('group_dept_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="domain_force">
            ['|',
                ('department_ids', 'in', user.employee_id.department_id.ids),
                ('department_ids', '=', False)
            ]
        </field>
    </record>

</odoo>
