<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Sequence for Fleet Fuel Requests -->
        <record id="seq_fleet_fuel_request" model="ir.sequence">
            <field name="name">Fleet Fuel Request</field>
            <field name="code">fleet.fuel.request</field>
