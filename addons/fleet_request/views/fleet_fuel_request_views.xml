<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================================= -->
    <!-- Fuel Request Action                       -->
    <!-- ========================================= -->

    <record id="action_fleet_fuel_request" model="ir.actions.act_window">
        <field name="name">Fuel Requests</field>
        <field name="res_model">fleet.fuel.request</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new fuel request
            </p>
            <p>
                Employees submit fuel requests for their assigned vehicle. The Fleet Manager
                reviews the request, records the receipt and amount, and completes the fuel log.
            </p>
        </field>
    </record>

    <!-- ========================================= -->
    <!-- Fuel Request Views                        -->
    <!-- ========================================= -->

    <record id="view_fleet_fuel_request_form" model="ir.ui.view">
        <field name="name">fleet.fuel.request.form</field>
        <field name="model">fleet.fuel.request</field>
        <field name="arch" type="xml">
            <form string="Fuel Request">
                <header>
                    <button name="action_submit" string="Submit Request" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve" type="object"
                            class="btn-primary" invisible="state != 'submitted'"
                            groups="fleet_operations_pro.group_fleet_manager"/>
                    <button name="action_mark_filled" string="Mark as Filled" type="object"
                            class="btn-primary" invisible="state != 'approved'"
                            groups="fleet_request.group_fuel_filler"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved,filled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" placeholder="Fuel Request Reference"/>
                        </h1>
                    </div>

                    <group>
                        <group name="request_info" string="Request Information">
                            <field name="requested_by" options="{'no_create': True}"
                                   readonly="state != 'draft'"/>
                            <field name="department_id"/>
                            <field name="vehicle_id" options="{'no_create': True}"/>
                            <field name="fuel_type_id" options="{'no_create': True}"/>
                            <field name="request_date"/>
                        </group>

                        <group name="fuel_filler_info" string="Fuel Filler">
                            <field name="receipt_no" readonly="not can_edit_financials"/>
                            <field name="amount" readonly="not can_edit_financials"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="filler_id" invisible="state != 'filled'"/>
                            <field name="filled_date" invisible="state != 'filled'"/>
                        </group>
                    </group>

                    <field name="can_edit_financials" invisible="1"/>

                    <notebook>
                        <page string="Fuel Details" name="fuel_details">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="previous_filled" readonly="1"/>
                                    <field name="previous_odometer" readonly="1"/>
                                    <field name="current_odometer" readonly="request_state != 'draft'"/>
                                    <field name="km_difference" readonly="1"/>
                                    <field name="attachment" filename="attachment_name"
                                           readonly="request_state != 'draft'"/>
                                    <field name="km_per_liter" readonly="1"/>
                                    <field name="current_filled" readonly="not can_edit_filled"/>
                                    <field name="request_state" column_invisible="1"/>
                                    <field name="can_edit_filled" column_invisible="1"/>
                                    <field name="attachment_name" column_invisible="1"/>
                                    <field name="fuel_log_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>

                    <group>
                        <field name="notes" placeholder="Additional notes about this fuel request..."/>
                    </group>

                    <group>
                        <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_fleet_fuel_request_list" model="ir.ui.view">
        <field name="name">fleet.fuel.request.list</field>
        <field name="model">fleet.fuel.request</field>
        <field name="arch" type="xml">
            <list string="Fuel Requests"
                  decoration-success="state == 'filled'"
                  decoration-info="state == 'approved'"
                  decoration-warning="state == 'submitted'">
                <field name="name"/>
                <field name="requested_by"/>
                <field name="vehicle_id"/>
                <field name="fuel_type_id" optional="show"/>
                <field name="request_date"/>
                <field name="receipt_no" optional="show"/>
                <field name="amount" widget="monetary" optional="show"/>
                <field name="filler_id" optional="show"/>
                <field name="state" widget="badge"/>
                <field name="department_id" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_fleet_fuel_request_search" model="ir.ui.view">
        <field name="name">fleet.fuel.request.search</field>
        <field name="model">fleet.fuel.request</field>
        <field name="arch" type="xml">
            <search string="Search Fuel Requests">
                <field name="name" string="Reference"/>
                <field name="requested_by" string="Requested By"/>
                <field name="vehicle_id" string="Vehicle"/>
                <field name="receipt_no" string="Receipt No."/>
                <field name="department_id" string="Department"/>

                <filter name="filter_my_requests" string="My Requests"
                        domain="[('requested_by.user_id', '=', uid)]"/>
                <filter name="filter_to_fill" string="To Fill"
                        domain="[('state', '=', 'approved')]"/>

                <separator/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="submitted" string="Submitted" domain="[('state', '=', 'submitted')]"/>
                <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <filter name="filled" string="Filled" domain="[('state', '=', 'filled')]"/>

                <separator/>
                <filter name="this_month" string="This Month"
                        domain="[('request_date', '&gt;=', context_today().strftime('%Y-%m-01'))]"/>

                <group expand="0" string="Group By">
                    <filter name="group_requested_by" string="Requested By"
                            context="{'group_by': 'requested_by'}"/>
                    <filter name="group_vehicle" string="Vehicle"
                            context="{'group_by': 'vehicle_id'}"/>
                    <filter name="group_department" string="Department"
                            context="{'group_by': 'department_id'}"/>
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_filler" string="Filled By"
                            context="{'group_by': 'filler_id'}"/>
                    <filter name="group_request_date" string="Request Date"
                            context="{'group_by': 'request_date'}"/>
                </group>
            </search>
        </field>
    </record>

</odoo>
