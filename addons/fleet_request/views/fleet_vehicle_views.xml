<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Add Accepted Requests button to the vehicle form -->
    <record id="view_fleet_vehicle_form_inherit_request" model="ir.ui.view">
        <field name="name">fleet.vehicle.form.inherit.request</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet_operations_pro.view_fleet_vehicle_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="%(action_fleet_request_accepted_vehicle)d"
                        type="action"
                        class="oe_stat_button"
                        icon="fa-clipboard-list">
                    <field name="accepted_request_count" widget="statinfo" string="Accepted Requests"/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
