<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="mefs_budget_planning.IncomeCumulativeChart">
        <div class="o_mefs_income_cumulative_chart w-100">
            <div t-if="!series.points.length" class="text-muted text-center py-5">
                Add planned income lines with a date to see the timeline.
            </div>
            <t t-else="">
                <!-- Positioned against the card, level with its title -->
                <button type="button" class="btn btn-light btn-sm o_mefs_download_btn"
                        title="Download as PDF" aria-label="Download as PDF"
                        t-on-click="onDownload">
                    <i class="fa fa-download"/>
                </button>
                <div class="position-relative" style="height: 420px;">
                    <canvas t-ref="canvas"/>
                </div>
            </t>
        </div>
    </t>
</templates>
