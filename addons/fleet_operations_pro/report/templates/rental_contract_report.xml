<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Rental Contract PDF Report Action -->
    <record id="action_report_rental_contract" model="ir.actions.report">
        <field name="name">Rental Contract</field>
        <field name="model">fleet.rental.contract</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">fleet_operations_pro.report_rental_contract_document</field>
        <field name="report_file">fleet_operations_pro.report_rental_contract_document</field>
        <field name="binding_model_id" ref="model_fleet_rental_contract"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Rental Contract - %s' % (object.name)</field>
    </record>
    
    <!-- Rental Contract Template -->
    <template id="report_rental_contract_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <!-- Header -->
                        <div class="text-center mb-4">
                            <h2 style="color: #007bff;">VEHICLE RENTAL CONTRACT</h2>
                            <h4><span t-field="o.name"/></h4>
                        </div>
                        
                        <!-- Contract Information -->
                        <div class="row mt-4">
                            <div class="col-6">
                                <h5 style="color: #6c757d;">Customer Information</h5>
                                <table class="table table-sm table-borderless">
                                    <tr>
                                        <td><strong>Name:</strong></td>
                                        <td><span t-field="o.customer_id.name"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Email:</strong></td>
                                        <td><span t-field="o.customer_id.email"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Phone:</strong></td>
                                        <td><span t-field="o.customer_id.phone"/></td>
                                    </tr>
                                </table>
                            </div>
                            <div class="col-6">
                                <h5 style="color: #6c757d;">Contract Details</h5>
                                <table class="table table-sm table-borderless">
                                    <tr>
                                        <td><strong>Start Date:</strong></td>
                                        <td><span t-field="o.start_date"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>End Date:</strong></td>
                                        <td><span t-field="o.end_date"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Duration:</strong></td>
                                        <td><span t-field="o.duration_days"/> days</td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                        
                        <!-- Vehicles -->
                        <h5 class="mt-4" style="color: #6c757d;">Rental Vehicles</h5>
                        <table class="table table-sm">
                            <thead style="background-color: #f8f9fa;">
                                <tr>
                                    <th>Vehicle</th>
                                    <th>License Plate</th>
                                    <th>Category</th>
                                    <th>Initial Odometer</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.vehicle_ids" t-as="vehicle">
                                    <td><span t-field="vehicle.name"/></td>
                                    <td><span t-field="vehicle.license_plate"/></td>
                                    <td><span t-field="vehicle.category_id.name"/></td>
                                    <td><span t-field="o.initial_odometer"/> km</td>
                                </tr>
                            </tbody>
                        </table>
                        
                        <!-- Financial Terms -->
                        <h5 class="mt-4" style="color: #6c757d;">Financial Terms</h5>
                        <table class="table table-sm">
                            <tr>
                                <td><strong>Rental Amount:</strong></td>
                                <td class="text-end"><span t-field="o.rental_amount" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                            </tr>
                            <tr>
                                <td><strong>Deposit Amount:</strong></td>
                                <td class="text-end"><span t-field="o.deposit_amount" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                            </tr>
                            <tr style="background-color: #f8f9fa; font-size: 16px;">
                                <td><strong>Total Amount:</strong></td>
                                <td class="text-end"><strong><span t-field="o.total_amount" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></strong></td>
                            </tr>
                        </table>
                        
                        <!-- Terms and Conditions -->
                        <h5 class="mt-4" style="color: #6c757d;">Terms and Conditions</h5>
                        <div style="font-size: 11px; line-height: 1.6;">
                            <ol>
                                <li>The renter must possess a valid driver's license.</li>
                                <li>The vehicle must be returned on time and in the same condition as received.</li>
                                <li>The renter is responsible for all traffic violations and fines during the rental period.</li>
                                <li>Fuel policy: <span t-field="o.fuel_recharge_policy"/>. Initial fuel level: <span t-field="o.initial_fuel_percentage"/>%</li>
                                <li>The deposit will be refunded upon satisfactory return of the vehicle.</li>
                                <li>Any damages to the vehicle must be reported immediately.</li>
                                <li>The renter agrees to use the vehicle responsibly and not for any illegal purposes.</li>
                            </ol>
                        </div>
                        
                        <t t-if="o.notes">
                            <h5 class="mt-4" style="color: #6c757d;">Additional Notes</h5>
                            <div style="font-size: 11px;">
                                <span t-field="o.notes"/>
                            </div>
                        </t>
                        
                        <!-- Signatures -->
                        <div class="row mt-5">
                            <div class="col-6">
                                <div style="border-top: 1px solid #000; padding-top: 8px;">
                                    <strong>Customer Signature</strong><br/>
                                    Date: _________________
                                </div>
                            </div>
                            <div class="col-6">
                                <div style="border-top: 1px solid #000; padding-top: 8px;">
                                    <strong>Company Representative</strong><br/>
                                    Date: _________________
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
    
</odoo>
