<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        
        <!-- ====================== -->
        <!-- Trip Demo Data         -->
        <!-- ====================== -->
        
        <!-- Trip 1: Business trip with rental contract -->
        <record id="trip_1" model="fleet.trip">
            <field name="vehicle_id" ref="vehicle_demo_1"/>
            <field name="driver_id" ref="driver_demo_1"/>
            <field name="rental_contract_id" ref="rental_contract_1"/>
            <field name="date" eval="(datetime.now() - timedelta(days=2)).strftime('%Y-%m-%d')"/>
            <field name="start_time" eval="(datetime.now() - timedelta(days=2, hours=2)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="end_time" eval="(datetime.now() - timedelta(days=2, hours=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="departure_location">Downtown Office, City Center</field>
            <field name="destination">Business Park, North District</field>
            <field name="waypoints">Stop at Gas Station, Coffee Shop</field>
            <field name="start_odometer">14900</field>
            <field name="end_odometer">14985</field>
            <field name="purpose">business</field>
            <field name="purpose_description">Client meeting at their office</field>
            <field name="notes">Highway route was faster than city route. Client meeting went well.</field>
        </record>
        
        <!-- Trip 2: Delivery trip -->
        <record id="trip_2" model="fleet.trip">
            <field name="vehicle_id" ref="vehicle_demo_2"/>
            <field name="driver_id" ref="driver_demo_2"/>
            <field name="date" eval="(datetime.now() - timedelta(days=5)).strftime('%Y-%m-%d')"/>
            <field name="start_time" eval="(datetime.now() - timedelta(days=5, hours=6)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="end_time" eval="(datetime.now() - timedelta(days=5, hours=2)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="departure_location">Warehouse, Industrial Zone</field>
            <field name="destination">Customer Location, East Side</field>
            <field name="waypoints">Toll Plaza, Rest Area</field>
            <field name="start_odometer">44500</field>
            <field name="end_odometer">44650</field>
            <field name="purpose">delivery</field>
            <field name="purpose_description">Furniture delivery to customer</field>
            <field name="notes">Delivered on time. Customer was satisfied.</field>
        </record>
        
        <!-- Trip 3: Service call -->
        <record id="trip_3" model="fleet.trip">
            <field name="vehicle_id" ref="vehicle_demo_3"/>
            <field name="driver_id" ref="driver_demo_1"/>
            <field name="date" eval="(datetime.now() - timedelta(days=7)).strftime('%Y-%m-%d')"/>
            <field name="start_time" eval="(datetime.now() - timedelta(days=7, hours=5)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="end_time" eval="(datetime.now() - timedelta(days=7, hours=2, minutes=30)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="departure_location">Head Office, Main Street</field>
            <field name="destination">Client Site, West District</field>
            <field name="start_odometer">249000</field>
            <field name="end_odometer">249120</field>
            <field name="purpose">service</field>
            <field name="purpose_description">On-site equipment maintenance</field>
            <field name="notes">Service completed successfully. Will need follow-up visit next month.</field>
        </record>
        
        <!-- Trip 4: Personal trip -->
        <record id="trip_4" model="fleet.trip">
            <field name="vehicle_id" ref="vehicle_demo_2"/>
            <field name="driver_id" ref="driver_demo_3"/>
            <field name="date" eval="(datetime.now() - timedelta(days=10)).strftime('%Y-%m-%d')"/>
            <field name="start_time" eval="(datetime.now() - timedelta(days=10, hours=8)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="end_time" eval="(datetime.now() - timedelta(days=10, hours=6)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="departure_location">Company Parking, Downtown</field>
            <field name="destination">Shopping Mall, South District</field>
            <field name="start_odometer">17900</field>
            <field name="end_odometer">17945</field>
            <field name="purpose">personal</field>
            <field name="purpose_description">Personal errands</field>
        </record>
        
        <!-- Trip 5: Rental trip (active contract) -->
        <record id="trip_5" model="fleet.trip">
            <field name="vehicle_id" ref="vehicle_demo_3"/>
            <field name="driver_id" ref="driver_demo_2"/>
            <field name="rental_contract_id" ref="rental_contract_2"/>
            <field name="date" eval="(datetime.now() - timedelta(days=1)).strftime('%Y-%m-%d')"/>
            <field name="start_time" eval="(datetime.now() - timedelta(days=1, hours=4)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="end_time" eval="(datetime.now() - timedelta(days=1, hours=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="departure_location">Hotel, City Center</field>
            <field name="destination">Airport, International Terminal</field>
            <field name="waypoints">Highway Exit 5, Parking Area</field>
            <field name="start_odometer">7500</field>
            <field name="end_odometer">7595</field>
            <field name="purpose">rental</field>
            <field name="purpose_description">Airport drop-off for rental customer</field>
            <field name="notes">Customer was dropped at Terminal 2. Return journey will be shorter.</field>
        </record>
        
        <!-- Trip 6: Long distance business trip -->
        <record id="trip_6" model="fleet.trip">
            <field name="vehicle_id" ref="vehicle_demo_1"/>
            <field name="driver_id" ref="driver_demo_1"/>
            <field name="date" eval="(datetime.now() - timedelta(days=15)).strftime('%Y-%m-%d')"/>
            <field name="start_time" eval="(datetime.now() - timedelta(days=15, hours=12)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="end_time" eval="(datetime.now() - timedelta(days=15, hours=4)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="departure_location">Head Office, Downtown</field>
            <field name="destination">Regional Office, North City</field>
            <field name="waypoints">Highway Rest Stop, Lunch Break Location</field>
            <field name="start_odometer">44200</field>
            <field name="end_odometer">44550</field>
            <field name="purpose">business</field>
            <field name="purpose_description">Regional management meeting</field>
            <field name="notes">Long distance trip. Vehicle performed well on highway.</field>
        </record>
        
        <!-- Trip 7: Delivery with multiple stops -->
        <record id="trip_7" model="fleet.trip">
            <field name="vehicle_id" ref="vehicle_demo_2"/>
            <field name="driver_id" ref="driver_demo_2"/>
            <field name="date" eval="(datetime.now() - timedelta(days=20)).strftime('%Y-%m-%d')"/>
            <field name="start_time" eval="(datetime.now() - timedelta(days=20, hours=9)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="end_time" eval="(datetime.now() - timedelta(days=20, hours=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="departure_location">Distribution Center, Industrial Area</field>
            <field name="destination">Last Delivery Point, Residential District</field>
            <field name="waypoints">Stop 1: Downtown Branch, Stop 2: Mall Location, Stop 3: Office Complex</field>
            <field name="start_odometer">44650</field>
            <field name="end_odometer">44870</field>
            <field name="purpose">delivery</field>
            <field name="purpose_description">Multi-location delivery route</field>
            <field name="notes">Completed 4 deliveries. All customers signed for packages.</field>
        </record>
        
        <!-- Trip 8: Short local trip -->
        <record id="trip_8" model="fleet.trip">
            <field name="vehicle_id" ref="vehicle_demo_2"/>
            <field name="driver_id" ref="driver_demo_3"/>
            <field name="date" eval="(datetime.now() - timedelta(days=3)).strftime('%Y-%m-%d')"/>
            <field name="start_time" eval="(datetime.now() - timedelta(days=3, hours=3)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="end_time" eval="(datetime.now() - timedelta(days=3, hours=2, minutes=45)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="departure_location">Office Building A, Main Campus</field>
            <field name="destination">Office Building B, Main Campus</field>
            <field name="start_odometer">17945</field>
            <field name="end_odometer">17950</field>
            <field name="purpose">business</field>
            <field name="purpose_description">Inter-office document transfer</field>
            <field name="notes">Short trip within campus area.</field>
        </record>
        
        <!-- Trip 9: Other purpose trip -->
        <record id="trip_9" model="fleet.trip">
            <field name="vehicle_id" ref="vehicle_demo_3"/>
            <field name="driver_id" ref="driver_demo_1"/>
            <field name="date" eval="(datetime.now() - timedelta(days=12)).strftime('%Y-%m-%d')"/>
            <field name="start_time" eval="(datetime.now() - timedelta(days=12, hours=6)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="end_time" eval="(datetime.now() - timedelta(days=12, hours=4, minutes=15)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="departure_location">Office, Downtown</field>
            <field name="destination">Service Center, West Side</field>
            <field name="start_odometer">248850</field>
            <field name="end_odometer">248920</field>
            <field name="purpose">other</field>
            <field name="purpose_description">Vehicle inspection at service center</field>
            <field name="notes">Regular vehicle inspection completed. All good.</field>
        </record>
        
        <!-- Trip 10: Recent trip without end time -->
        <record id="trip_10" model="fleet.trip">
            <field name="vehicle_id" ref="vehicle_demo_2"/>
            <field name="driver_id" ref="driver_demo_2"/>
            <field name="date" eval="datetime.now().strftime('%Y-%m-%d')"/>
            <field name="start_time" eval="datetime.now().strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="departure_location">Office, City Center</field>
            <field name="destination">Customer Site, Industrial Zone</field>
            <field name="waypoints">Planned route via Highway 1</field>
            <field name="start_odometer">44870</field>
            <field name="purpose">service</field>
            <field name="purpose_description">Ongoing service call</field>
            <field name="notes">Trip in progress</field>
        </record>
        
    </data>
</odoo>

