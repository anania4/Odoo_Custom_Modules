<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        
        <!-- Demo Customers (Partners) -->
        <record id="rental_customer_1" model="res.partner">
            <field name="name">Acme Corporation</field>
            <field name="email">contact@acmecorp.com</field>
            <field name="phone">+1-555-2001</field>
            <field name="street">456 Business Ave</field>
            <field name="city">Metropolis</field>
            <field name="zip">54321</field>
            <field name="country_id" ref="base.us"/>
            <field name="is_company">1</field>
        </record>
        
        <record id="rental_customer_2" model="res.partner">
            <field name="name">Tech Solutions Inc</field>
            <field name="email">info@techsolutions.com</field>
            <field name="phone">+1-555-2002</field>
            <field name="street">789 Innovation Blvd</field>
            <field name="city">Silicon Valley</field>
            <field name="zip">94025</field>
            <field name="country_id" ref="base.us"/>
            <field name="is_company">1</field>
        </record>
        
        <record id="rental_customer_3" model="res.partner">
            <field name="name">Michael Brown</field>
            <field name="email">michael.brown@email.com</field>
            <field name="phone">+1-555-2003</field>
            <field name="mobile">+1-555-3003</field>
            <field name="street">321 Residential St</field>
            <field name="city">Hometown</field>
            <field name="zip">67890</field>
            <field name="country_id" ref="base.us"/>
            <field name="is_company">0</field>
        </record>
        
        <!-- Demo Rental Contracts -->
        
        <!-- Active Rental Contract -->
        <record id="rental_contract_1" model="fleet.rental.contract">
            <field name="name">RC00001</field>
            <field name="customer_id" ref="rental_customer_1"/>
            <field name="vehicle_ids" eval="[(6, 0, [ref('vehicle_demo_1')])]"/>
            <field name="driver_id" ref="driver_demo_1"/>
            <field name="start_date" eval="(datetime.now() - timedelta(days=5)).strftime('%Y-%m-%d')"/>
            <field name="end_date" eval="(datetime.now() + timedelta(days=25)).strftime('%Y-%m-%d')"/>
            <field name="rental_rate_type">daily</field>
            <field name="rental_rate">150.00</field>
            <field name="deposit_amount">500.00</field>
            <field name="deposit_returned">0</field>
            <field name="pickup_location">Main Office - 123 Fleet Street</field>
            <field name="return_location">Main Office - 123 Fleet Street</field>
            <field name="initial_odometer">15000</field>
            <field name="state">active</field>
            <field name="notes">Corporate rental for monthly business trips.</field>
            <field name="terms_conditions">Standard rental terms apply. Vehicle must be returned in same condition. Fuel tank must be full.</field>
        </record>
        
        <!-- Confirmed Rental Contract (Starting Soon) -->
        <record id="rental_contract_2" model="fleet.rental.contract">
            <field name="name">RC00002</field>
            <field name="customer_id" ref="rental_customer_2"/>
            <field name="vehicle_ids" eval="[(6, 0, [ref('vehicle_demo_2'), ref('vehicle_demo_3')])]"/>
            <field name="start_date" eval="(datetime.now() + timedelta(days=3)).strftime('%Y-%m-%d')"/>
            <field name="end_date" eval="(datetime.now() + timedelta(days=10)).strftime('%Y-%m-%d')"/>
            <field name="rental_rate_type">weekly</field>
            <field name="rental_rate">900.00</field>
            <field name="deposit_amount">1000.00</field>
            <field name="deposit_returned">0</field>
            <field name="pickup_location">North Branch - 456 Oak Avenue</field>
            <field name="return_location">South Branch - 789 Pine Road</field>
            <field name="state">confirmed</field>
            <field name="notes">Multi-vehicle rental for equipment delivery.</field>
            <field name="terms_conditions">Weekly rate includes 1000 km. Additional km charged at $0.50/km.</field>
        </record>
        
        <!-- Draft Rental Contract -->
        <record id="rental_contract_3" model="fleet.rental.contract">
            <field name="name">RC00003</field>
            <field name="customer_id" ref="rental_customer_3"/>
            <field name="vehicle_ids" eval="[(6, 0, [ref('vehicle_demo_4')])]"/>
            <field name="start_date" eval="(datetime.now() + timedelta(days=15)).strftime('%Y-%m-%d')"/>
            <field name="end_date" eval="(datetime.now() + timedelta(days=45)).strftime('%Y-%m-%d')"/>
            <field name="rental_rate_type">monthly</field>
            <field name="rental_rate">2500.00</field>
            <field name="deposit_amount">750.00</field>
            <field name="deposit_returned">0</field>
            <field name="pickup_location">Airport Branch - Terminal 3</field>
            <field name="return_location">Airport Branch - Terminal 3</field>
            <field name="state">draft</field>
            <field name="notes">Long-term rental for vacation.</field>
            <field name="terms_conditions">Monthly rate. Insurance included. Maintenance provided.</field>
        </record>
        
        <!-- Completed Rental Contract (Deposit Returned) -->
        <record id="rental_contract_4" model="fleet.rental.contract">
            <field name="name">RC00004</field>
            <field name="customer_id" ref="rental_customer_1"/>
            <field name="vehicle_ids" eval="[(6, 0, [ref('vehicle_demo_5')])]"/>
            <field name="driver_id" ref="driver_demo_2"/>
            <field name="start_date" eval="(datetime.now() - timedelta(days=60)).strftime('%Y-%m-%d')"/>
            <field name="end_date" eval="(datetime.now() - timedelta(days=30)).strftime('%Y-%m-%d')"/>
            <field name="actual_return_date" eval="(datetime.now() - timedelta(days=30)).strftime('%Y-%m-%d')"/>
            <field name="rental_rate_type">monthly</field>
            <field name="rental_rate">3000.00</field>
            <field name="deposit_amount">1000.00</field>
            <field name="deposit_returned">1</field>
            <field name="deposit_return_date" eval="(datetime.now() - timedelta(days=25)).strftime('%Y-%m-%d')"/>
            <field name="deposit_return_amount">1000.00</field>
            <field name="pickup_location">Main Office - 123 Fleet Street</field>
            <field name="return_location">Main Office - 123 Fleet Street</field>
            <field name="initial_odometer">25000</field>
            <field name="final_odometer">27500</field>
            <field name="state">completed</field>
            <field name="notes">Completed successfully. No issues.</field>
            <field name="terms_conditions">Standard monthly rental. All inclusive package.</field>
        </record>
        
        <!-- Completed Rental Contract (Deposit NOT Returned) -->
        <record id="rental_contract_5" model="fleet.rental.contract">
            <field name="name">RC00005</field>
            <field name="customer_id" ref="rental_customer_2"/>
            <field name="vehicle_ids" eval="[(6, 0, [ref('vehicle_demo_6')])]"/>
            <field name="driver_id" ref="driver_demo_3"/>
            <field name="start_date" eval="(datetime.now() - timedelta(days=45)).strftime('%Y-%m-%d')"/>
            <field name="end_date" eval="(datetime.now() - timedelta(days=31)).strftime('%Y-%m-%d')"/>
            <field name="actual_return_date" eval="(datetime.now() - timedelta(days=28)).strftime('%Y-%m-%d')"/>
            <field name="rental_rate_type">daily</field>
            <field name="rental_rate">120.00</field>
            <field name="deposit_amount">600.00</field>
            <field name="deposit_returned">0</field>
            <field name="pickup_location">West Branch - 111 Maple Drive</field>
            <field name="return_location">West Branch - 111 Maple Drive</field>
            <field name="initial_odometer">18000</field>
            <field name="final_odometer">20200</field>
            <field name="state">completed</field>
            <field name="notes">Returned late. Waiting for damage assessment before returning deposit.</field>
            <field name="terms_conditions">Daily rate. Late return penalty applies.</field>
        </record>
        
        <!-- Active Rental (Overdue) -->
        <record id="rental_contract_6" model="fleet.rental.contract">
            <field name="name">RC00006</field>
            <field name="customer_id" ref="rental_customer_3"/>
            <field name="vehicle_ids" eval="[(6, 0, [ref('vehicle_demo_7')])]"/>
            <field name="start_date" eval="(datetime.now() - timedelta(days=20)).strftime('%Y-%m-%d')"/>
            <field name="end_date" eval="(datetime.now() - timedelta(days=3)).strftime('%Y-%m-%d')"/>
            <field name="rental_rate_type">weekly</field>
            <field name="rental_rate">700.00</field>
            <field name="deposit_amount">500.00</field>
            <field name="deposit_returned">0</field>
            <field name="pickup_location">Downtown Branch - 222 Center St</field>
            <field name="return_location">Downtown Branch - 222 Center St</field>
            <field name="initial_odometer">12000</field>
            <field name="state">active</field>
            <field name="notes">Vehicle is overdue for return. Customer contacted.</field>
            <field name="terms_conditions">Weekly rate. Overdue charges apply after end date.</field>
        </record>
        
        <!-- Cancelled Rental Contract -->
        <record id="rental_contract_7" model="fleet.rental.contract">
            <field name="name">RC00007</field>
            <field name="customer_id" ref="rental_customer_1"/>
            <field name="vehicle_ids" eval="[(6, 0, [ref('vehicle_demo_8')])]"/>
            <field name="start_date" eval="(datetime.now() + timedelta(days=7)).strftime('%Y-%m-%d')"/>
            <field name="end_date" eval="(datetime.now() + timedelta(days=14)).strftime('%Y-%m-%d')"/>
            <field name="rental_rate_type">daily</field>
            <field name="rental_rate">140.00</field>
            <field name="deposit_amount">500.00</field>
            <field name="deposit_returned">1</field>
            <field name="deposit_return_date" eval="(datetime.now() - timedelta(days=1)).strftime('%Y-%m-%d')"/>
            <field name="deposit_return_amount">500.00</field>
            <field name="pickup_location">East Branch - 333 Elm Street</field>
            <field name="return_location">East Branch - 333 Elm Street</field>
            <field name="state">cancelled</field>
            <field name="notes">Cancelled by customer. Full deposit refunded.</field>
            <field name="terms_conditions">Standard cancellation policy. Full refund if cancelled 48h+ in advance.</field>
        </record>
        
        <!-- Active Multi-Vehicle Rental -->
        <record id="rental_contract_8" model="fleet.rental.contract">
            <field name="name">RC00008</field>
            <field name="customer_id" ref="rental_customer_2"/>
            <field name="vehicle_ids" eval="[(6, 0, [ref('vehicle_demo_4'), ref('vehicle_demo_7')])]"/>
            <field name="start_date" eval="(datetime.now() - timedelta(days=10)).strftime('%Y-%m-%d')"/>
            <field name="end_date" eval="(datetime.now() + timedelta(days=20)).strftime('%Y-%m-%d')"/>
            <field name="rental_rate_type">monthly</field>
            <field name="rental_rate">2200.00</field>
            <field name="deposit_amount">1500.00</field>
            <field name="deposit_returned">0</field>
            <field name="pickup_location">Main Office - 123 Fleet Street</field>
            <field name="return_location">North Branch - 456 Oak Avenue</field>
            <field name="initial_odometer">30000</field>
            <field name="state">active</field>
            <field name="notes">Fleet rental for construction project. Two trucks.</field>
            <field name="terms_conditions">Monthly rate per vehicle. Damage waiver included.</field>
        </record>
        
    </data>
</odoo>

