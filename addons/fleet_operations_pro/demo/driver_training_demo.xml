            <field name="completion_status">completed</field>
            <field name="trainer">Safety First Training</field>
            <field name="certificate_number">HAZ-2023-045</field>
            <field name="score">88.0</field>
            <field name="notes">Certified for Class 3 hazardous materials</field>
        </record>

