            <field name="completion_date" eval="(datetime.now() - timedelta(days=29)).strftime('%Y-%m-%d')"/>
            <field name="duration_hours">8.0</field>
            <field name="training_name">Winter Driving Skills</field>
            <field name="completion_status">completed</field>
            <field name="trainer">Safe Winter Driving Inc.</field>
            <field name="certificate_number">WINT-2023-012</field>
            <field name="score">92.5</field>
