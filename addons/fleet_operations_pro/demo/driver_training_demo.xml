<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Driver Training Records -->
        <record id="driver_training_demo_1" model="fleet.driver.training">
            <field name="name">Defensive Driving Course</field>
            <field name="driver_id" ref="driver_demo_1"/>
            <field name="training_type">defensive_driving</field>
            <field name="date" eval="(datetime.now() - timedelta(days=60)).strftime('%Y-%m-%d')"/>
            <field name="completion_date" eval="(datetime.now() - timedelta(days=30)).strftime('%Y-%m-%d')"/>
            <field name="duration_hours">8.0</field>
            <field name="training_name">Defensive Driving Certification</field>
            <field name="completion_status">completed</field>
            <field name="trainer">ABC Driving School</field>
            <field name="certificate_number">CERT-2023-001</field>
            <field name="score">95.5</field>
            <field name="notes">Completed with distinction</field>
        </record>

        <record id="driver_training_demo_2" model="fleet.driver.training">
