        </record>

        <record id="driver_training_demo_4" model="fleet.driver.training">
            <field name="name">Eco-Driving</field>
            <field name="driver_id" ref="driver_demo_1"/>
            <field name="training_type">eco_driving</field>
            <field name="date" eval="(datetime.now() - timedelta(days=15)).strftime('%Y-%m-%d')"/>
            <field name="completion_date" eval="(datetime.now() - timedelta(days=14)).strftime('%Y-%m-%d')"/>
            <field name="duration_hours">4.0</field>
            <field name="training_name">Eco-Driving Techniques</field>
            <field name="completion_status">completed</field>
            <field name="trainer">Green Fleet Academy</field>
            <field name="certificate_number">ECO-2023-078</field>
            <field name="score">97.0</field>
            <field name="notes">Achieved 15% fuel efficiency improvement in practical test</field>
        </record>

        <record id="driver_training_demo_5" model="fleet.driver.training">
            <field name="name">Advanced First Aid</field>
            <field name="driver_id" ref="driver_demo_4"/>
