<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Default Notification Configurations -->
        
        <!-- Certificate Expiry - 30 days before -->
        <record id="notification_certificate_30" model="fleet.notification.config">
            <field name="notification_type">certificate_expiry</field>
            <field name="lead_days">30</field>
            <field name="sequence">10</field>
            <field name="summary_template">Certificate expiring in 30 days: {certificate_type} - {vehicle}</field>
            <field name="note_template">The certificate {certificate_type} for vehicle {vehicle} will expire on {expiry_date}. Please take action to renew it.</field>
        </record>
        
        <!-- Certificate Expiry - 15 days before -->
        <record id="notification_certificate_15" model="fleet.notification.config">
            <field name="notification_type">certificate_expiry</field>
            <field name="lead_days">15</field>
            <field name="sequence">20</field>
            <field name="summary_template">URGENT: Certificate expiring in 15 days - {certificate_type} - {vehicle}</field>
            <field name="note_template">URGENT: The certificate {certificate_type} for vehicle {vehicle} will expire on {expiry_date}. Immediate action required!</field>
        </record>
        
        <!-- Certificate Expiry - 7 days before -->
        <record id="notification_certificate_7" model="fleet.notification.config">
            <field name="notification_type">certificate_expiry</field>
            <field name="lead_days">7</field>
            <field name="sequence">30</field>
            <field name="summary_template">CRITICAL: Certificate expiring in 7 days - {certificate_type} - {vehicle}</field>
            <field name="note_template">CRITICAL: The certificate {certificate_type} for vehicle {vehicle} will expire on {expiry_date}. This is your final reminder!</field>
        </record>
        
        <!-- Driver License Expiry - 30 days before -->
        <record id="notification_license_30" model="fleet.notification.config">
            <field name="notification_type">license_expiry</field>
            <field name="lead_days">30</field>
            <field name="sequence">10</field>
            <field name="summary_template">Driver license expiring in 30 days: {driver_name}</field>
            <field name="note_template">The driver license for {driver_name} (License: {license_number}) will expire on {expiry_date}. Please arrange for renewal.</field>
        </record>
        
        <!-- Driver License Expiry - 15 days before -->
        <record id="notification_license_15" model="fleet.notification.config">
            <field name="notification_type">license_expiry</field>
            <field name="lead_days">15</field>
            <field name="sequence">20</field>
            <field name="summary_template">URGENT: Driver license expiring in 15 days - {driver_name}</field>
            <field name="note_template">URGENT: The driver license for {driver_name} (License: {license_number}) will expire on {expiry_date}. Immediate renewal required!</field>
        </record>
        
        <!-- Rental Start - 3 days before -->
        <record id="notification_rental_start_3" model="fleet.notification.config">
            <field name="notification_type">rental_start</field>
            <field name="lead_days">3</field>
            <field name="sequence">10</field>
            <field name="summary_template">Rental starting in 3 days: {contract_number} - {customer}</field>
            <field name="note_template">Rental contract {contract_number} for customer {customer} starts on {start_date}. Vehicles: {vehicles}. Please ensure vehicles are ready.</field>
        </record>
        
        <!-- Rental Start - 1 day before -->
        <record id="notification_rental_start_1" model="fleet.notification.config">
            <field name="notification_type">rental_start</field>
            <field name="lead_days">1</field>
            <field name="sequence">20</field>
            <field name="summary_template">Rental starting tomorrow: {contract_number} - {customer}</field>
            <field name="note_template">REMINDER: Rental contract {contract_number} for customer {customer} starts tomorrow ({start_date}). Vehicles: {vehicles}. Final preparation needed.</field>
        </record>
        
        <!-- Rental End - 3 days before -->
        <record id="notification_rental_end_3" model="fleet.notification.config">
            <field name="notification_type">rental_end</field>
            <field name="lead_days">3</field>
            <field name="sequence">10</field>
            <field name="summary_template">Rental ending in 3 days: {contract_number} - {customer}</field>
            <field name="note_template">Rental contract {contract_number} for customer {customer} ends on {end_date}. Vehicles: {vehicles}. Please prepare for vehicle return and inspection.</field>
        </record>
        
        <!-- Rental End - 1 day before -->
        <record id="notification_rental_end_1" model="fleet.notification.config">
            <field name="notification_type">rental_end</field>
            <field name="lead_days">1</field>
            <field name="sequence">20</field>
            <field name="summary_template">Rental ending tomorrow: {contract_number} - {customer}</field>
            <field name="note_template">REMINDER: Rental contract {contract_number} for customer {customer} ends tomorrow ({end_date}). Vehicles: {vehicles}. Prepare for immediate return.</field>
        </record>
        
    </data>
</odoo>

