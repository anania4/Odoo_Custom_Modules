<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Daily: expire contracts past their end date and send expiry reminders -->
        <record id="ir_cron_fleet_contract_check" model="ir.cron">
            <field name="name">Fleet: Contract Expiry Check</field>
            <field name="model_id" ref="model_fleet_contract"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_contracts()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
