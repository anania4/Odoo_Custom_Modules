<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="contract_type_insurance" model="fleet.contract.type">
            <field name="name">Insurance</field>
            <field name="prefix">INS</field>
            <field name="sequence">10</field>
        </record>

        <record id="contract_type_lease" model="fleet.contract.type">
            <field name="name">Lease</field>
            <field name="prefix">LSE</field>
            <field name="sequence">20</field>
        </record>

        <record id="contract_type_service" model="fleet.contract.type">
            <field name="name">Service Contract</field>
            <field name="prefix">SVC</field>
            <field name="sequence">30</field>
        </record>

        <record id="contract_type_other" model="fleet.contract.type">
            <field name="name">Other</field>
            <field name="prefix">CTR</field>
            <field name="sequence">100</field>
        </record>

    </data>
</odoo>
