<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Sequence for Fleet Contracts -->
        <record id="seq_fleet_contract" model="ir.sequence">
            <field name="name">Fleet Contract</field>
            <field name="code">fleet.contract</field>
            <field name="prefix">FCL/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence for Fleet Services -->
        <record id="seq_fleet_service" model="ir.sequence">
            <field name="name">Fleet Service</field>
            <field name="code">fleet.service</field>
            <field name="prefix">SVN</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
