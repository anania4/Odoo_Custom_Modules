<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Certificate Expiry Email Template -->
        <record id="email_template_certificate_expiry" model="mail.template">
            <field name="name">Fleet: Certificate Expiry Reminder</field>
            <field name="model_id" ref="model_fleet_vehicle_certificate"/>
            <field name="subject">Certificate Expiring Soon: ${object.certificate_type_id.name} - ${object.vehicle_id.name}</field>
            <field name="email_from">${(object.company_id.email or user.email_formatted) | safe}</field>
            <field name="email_to">${object.company_id.email or user.email}</field>
            <field name="body_html" type="html">
<div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;">
    <h2 style="color: #dc3545;">⚠️ Certificate Expiry Alert</h2>
    <p>Dear Fleet Manager,</p>
    <p>The following certificate is expiring soon and requires your attention:</p>
    
    <table style="width: 100%; border-collapse: collapse; margin: 20px 0;">
        <tr>
            <td style="padding: 8px; border: 1px solid #ddd; background-color: #f8f9fa; font-weight: bold;">Vehicle</td>
            <td style="padding: 8px; border: 1px solid #ddd;">${object.vehicle_id.name} (${object.vehicle_id.license_plate})</td>
        </tr>
        <tr>
            <td style="padding: 8px; border: 1px solid #ddd; background-color: #f8f9fa; font-weight: bold;">Certificate Type</td>
            <td style="padding: 8px; border: 1px solid #ddd;">${object.certificate_type_id.name}</td>
        </tr>
        <tr>
            <td style="padding: 8px; border: 1px solid #ddd; background-color: #f8f9fa; font-weight: bold;">Expiry Date</td>
            <td style="padding: 8px; border: 1px solid #ddd; color: #dc3545; font-weight: bold;">${format_date(object.expiry_date)}</td>
        </tr>
        <tr>
            <td style="padding: 8px; border: 1px solid #ddd; background-color: #f8f9fa; font-weight: bold;">Days Until Expiry</td>
            <td style="padding: 8px; border: 1px solid #ddd;">${object.days_until_expiry} days</td>
        </tr>
    </table>
    
    <p style="color: #856404; background-color: #fff3cd; border: 1px solid #ffeaa7; padding: 12px; border-radius: 4px;">
        <strong>Action Required:</strong> Please renew this certificate before it expires to ensure compliance.
    </p>
    
    <p style="margin-top: 30px; font-size: 12px; color: #6c757d;">
        Best regards,<br/>
        Fleet Operations Pro
    </p>
</div>
            </field>
        </record>
        
    </data>
</odoo>
