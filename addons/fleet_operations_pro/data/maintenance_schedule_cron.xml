<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Cron Job for Maintenance Schedule Checks -->
        <record id="ir_cron_maintenance_schedules" model="ir.cron">
            <field name="name">Fleet: Check Maintenance Schedules</field>
            <field name="model_id" ref="model_fleet_maintenance_schedule"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_maintenance_schedules()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="priority">5</field>
        </record>

    </data>
</odoo>
