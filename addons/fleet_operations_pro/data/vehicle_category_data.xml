<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Vehicle Categories -->
        <record id="vehicle_category_car" model="fleet.vehicle.category">
            <field name="name">Car</field>
            <field name="code">car</field>
            <field name="sequence">10</field>
            <field name="description">Passenger cars and sedans</field>
        </record>
        
        <record id="vehicle_category_suv" model="fleet.vehicle.category">
            <field name="name">SUV</field>
            <field name="code">suv</field>
            <field name="sequence">20</field>
            <field name="description">Sport Utility Vehicles</field>
        </record>
        
        <record id="vehicle_category_truck" model="fleet.vehicle.category">
            <field name="name">Truck</field>
            <field name="code">truck</field>
            <field name="sequence">30</field>
            <field name="description">Trucks and lorries</field>
        </record>
        
        <record id="vehicle_category_van" model="fleet.vehicle.category">
            <field name="name">Van</field>
            <field name="code">van</field>
            <field name="sequence">40</field>
            <field name="description">Vans and minivans</field>
        </record>
        
        <record id="vehicle_category_bus" model="fleet.vehicle.category">
            <field name="name">Bus</field>
            <field name="code">bus</field>
            <field name="sequence">50</field>
            <field name="description">Buses for passenger transport</field>
        </record>
        
        <record id="vehicle_category_motorcycle" model="fleet.vehicle.category">
            <field name="name">Motorcycle</field>
            <field name="code">motorcycle</field>
            <field name="sequence">60</field>
            <field name="description">Motorcycles and bikes</field>
        </record>
        
        <record id="vehicle_category_construction" model="fleet.vehicle.category">
            <field name="name">Construction Vehicle</field>
            <field name="code">construction</field>
            <field name="sequence">70</field>
            <field name="description">Construction and heavy machinery vehicles</field>
        </record>
        
        <record id="vehicle_category_other" model="fleet.vehicle.category">
            <field name="name">Other</field>
            <field name="code">other</field>
            <field name="sequence">100</field>
            <field name="description">Other vehicle types</field>
        </record>
        
    </data>
</odoo>

