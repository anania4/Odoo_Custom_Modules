<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron Job for Insurance Expiry Checks -->
        <record id="ir_cron_insurance_expiry" model="ir.cron">
            <field name="name">Fleet: Check Insurance Expiry</field>
            <field name="model_id" ref="model_fleet_insurance"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_insurance_expiry()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="priority">5</field>
        </record>
    </data>
</odoo>
