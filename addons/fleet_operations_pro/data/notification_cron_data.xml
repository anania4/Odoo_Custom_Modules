<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Cron Job for Fleet Notification Automation -->
        <record id="ir_cron_fleet_notifications" model="ir.cron">
            <field name="name">Fleet: Process Notification Reminders</field>
            <field name="model_id" ref="model_fleet_notification_automation"/>
            <field name="state">code</field>
            <field name="code">model.run_all_notifications()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="priority">5</field>
        </record>
        
    </data>
</odoo>

