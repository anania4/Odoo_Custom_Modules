<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Settings > Users > Access Rights: "Fleet Operations" section -->
        <record id="module_category_fleet_operations" model="ir.module.category">
            <field name="name">Fleet Operations</field>
            <field name="description">Access rights for the Fleet and Fleet Requests apps</field>
            <field name="sequence">10</field>
        </record>

        <!-- Fleet User: Fleet Requests app only; asks for vehicles and fuel -->
        <record id="group_fleet_user" model="res.groups">
            <field name="name">Fleet User</field>
            <field name="category_id" ref="module_category_fleet_operations"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Fleet Requests app only: creates and follows own fleet and fuel requests (department managers also see and approve their team's fleet requests). No access to the Fleet app.</field>
        </record>

        <!-- Fleet Viewer: Fleet app, read only -->
        <record id="group_fleet_viewer" model="res.groups">
            <field name="name">Fleet Viewer</field>
            <field name="category_id" ref="module_category_fleet_operations"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Fleet app only, read-only: dashboard, vehicles, contracts, services, fuel logs, tolls, trips and reports. No configuration, no Fleet Requests app.</field>
        </record>

        <!-- Fleet Manager: everything (the Fuel Filler group in Fleet Requests is added to it there) -->
        <record id="group_fleet_manager" model="res.groups">
            <field name="name">Fleet Manager</field>
            <field name="category_id" ref="module_category_fleet_operations"/>
            <field name="implied_ids" eval="[(4, ref('group_fleet_viewer')), (4, ref('group_fleet_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="comment">Full access to the Fleet and Fleet Requests apps, including configuration and approvals.</field>
        </record>

    </data>
</odoo>
