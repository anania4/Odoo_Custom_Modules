<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- ========================================= -->
        <!-- FLEET MANAGER RULES - Full Access -->
        <!-- ========================================= -->
        
        <record id="fleet_vehicle_manager_rule" model="ir.rule">
            <field name="name">Fleet Manager: All Vehicles</field>
            <field name="model_id" ref="model_fleet_vehicle"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_fleet_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
        
        <!-- ========================================= -->
        <!-- FLEET USER RULES - Operations Access -->
        <!-- ========================================= -->
        
        <record id="fleet_vehicle_user_rule" model="ir.rule">
            <field name="name">Fleet User: Company Vehicles</field>
            <field name="model_id" ref="model_fleet_vehicle"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_fleet_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        
        <!-- ========================================= -->
        <!-- FLEET DRIVER RULES - Own Records Only -->
        <!-- ========================================= -->
        
        <record id="fleet_driver_own_trips_rule" model="ir.rule">
            <field name="name">Fleet Driver: Own Trips</field>
            <field name="model_id" ref="model_fleet_trip"/>
            <field name="domain_force">[('driver_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_fleet_driver'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        
        <record id="fleet_driver_own_fuel_rule" model="ir.rule">
            <field name="name">Fleet Driver: Own Fuel Logs</field>
            <field name="model_id" ref="model_fleet_fuel_log"/>
            <field name="domain_force">[('driver_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_fleet_driver'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        
        <record id="fleet_driver_assigned_vehicles_rule" model="ir.rule">
            <field name="name">Fleet Driver: Assigned Vehicles (Read Only)</field>
            <field name="model_id" ref="model_fleet_vehicle"/>
            <field name="domain_force">[('driver_assignment_ids.employee_id.user_id', '=', user.id), ('driver_assignment_ids.date_end', '=', False)]</field>
            <field name="groups" eval="[(4, ref('group_fleet_driver'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        
        <!-- ========================================= -->
        <!-- FLEET MAINTENANCE RULES - Maintenance Access -->
        <!-- ========================================= -->
        
        <record id="fleet_maintenance_vehicle_rule" model="ir.rule">
            <field name="name">Fleet Maintenance: All Vehicles (Read Only)</field>
            <field name="model_id" ref="model_fleet_vehicle"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_fleet_maintenance'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        
        <record id="fleet_maintenance_maintenance_rule" model="ir.rule">
            <field name="name">Fleet Maintenance: All Maintenance Records</field>
            <field name="model_id" ref="model_fleet_maintenance"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_fleet_maintenance'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        
        <!-- ========================================= -->
        <!-- FLEET VIEWER RULES - Read Only -->
        <!-- ========================================= -->
        
        <record id="fleet_viewer_vehicle_rule" model="ir.rule">
            <field name="name">Fleet Viewer: All Vehicles (Read Only)</field>
            <field name="model_id" ref="model_fleet_vehicle"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_fleet_viewer'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        
        
    </data>
</odoo>
