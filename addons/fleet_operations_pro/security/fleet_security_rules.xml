<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Multi-company: only vehicles of the user's allowed companies (global rule, all groups) -->
        <record id="fleet_vehicle_company_rule" model="ir.rule">
            <field name="name">Fleet Vehicle: multi-company</field>
            <field name="model_id" ref="model_fleet_vehicle"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <!-- Multi-company: only drivers of the user's allowed companies (global rule, all groups) -->
