<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Action to open wizard from Rental Contract -->
    <record id="action_fleet_fuel_log_wizard_from_rental" model="ir.actions.act_window">
        <field name="name">Add Fuel</field>
        <field name="res_model">fleet.fuel.log.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_rental_contract_id': active_id}</field>
    </record>
    
    <!-- Fuel Log Wizard Form View -->
    <record id="view_fleet_fuel_log_wizard_form" model="ir.ui.view">
        <field name="name">fleet.fuel.log.wizard.form</field>
        <field name="model">fleet.fuel.log.wizard</field>
        <field name="arch" type="xml">
            <form string="Add Fuel">
                <group>
                    <group name="vehicle_info" string="Vehicle Information">
                        <field name="rental_contract_id" invisible="not rental_contract_id"/>
                        <field name="vehicle_id" readonly="1"/>
                        <field name="driver_id"/>
                        <field name="date"/>
                    </group>
                    <group name="current_fuel" string="Current Fuel Status">
                        <field name="current_fuel_level"/>
                        <field name="fuel_tank_capacity"/>
                        <field name="fuel_percentage" widget="progressbar"/>
                    </group>
                </group>
                
                <group>
                    <group name="fuel_details" string="Fuel Details">
                        <field name="quantity"/>
                        <field name="price_per_unit" widget="monetary"/>
                        <field name="total_cost" widget="monetary"/>
                        <field name="odometer"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="company_id" invisible="1"/>
                    </group>
                    <group name="new_fuel" string="New Fuel Status">
                        <field name="new_fuel_level"/>
                        <field name="new_fuel_percentage" widget="progressbar"/>
                    </group>
                </group>
                
                <group>
                    <group name="station" string="Fuel Station">
                        <field name="fuel_station"/>
                        <field name="fuel_station_location"/>
                    </group>
                    <group name="attachment" string="Receipt">
                        <field name="attachment" filename="attachment_name"/>
                        <field name="attachment_name" invisible="1"/>
                    </group>
                </group>
                
                <group>
                    <field name="notes" placeholder="Additional notes..." colspan="2"/>
                </group>
                
                <footer>
                    <button name="action_add_fuel" string="Add Fuel" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    
    <!-- Action to open wizard from Vehicle -->
    <record id="action_fleet_fuel_log_wizard_from_vehicle" model="ir.actions.act_window">
        <field name="name">Add Fuel</field>
        <field name="res_model">fleet.fuel.log.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_vehicle_id': active_id}</field>
    </record>
    
</odoo>

