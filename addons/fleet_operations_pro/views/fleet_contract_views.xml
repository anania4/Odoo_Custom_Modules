<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================================= -->
    <!-- Vehicle Agreement                            -->
    <!-- ========================================= -->

    <record id="action_fleet_contract" model="ir.actions.act_window">
        <field name="name">Vehicle Agreements</field>
        <field name="res_model">fleet.contract</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new vehicle agreement
            </p>
            <p>
                Manage insurance policies, leases and service agreements with
                their costs and renewal dates.
            </p>
        </field>
    </record>

    <!-- Vehicle Agreement List View -->
    <record id="view_fleet_contract_list" model="ir.ui.view">
        <field name="name">fleet.contract.list</field>
        <field name="model">fleet.contract</field>
        <field name="arch" type="xml">
            <list string="Vehicle Agreements"
                  decoration-success="state == 'running'"
                  decoration-info="state == 'draft'"
                  decoration-warning="state == 'running' and expiring_alert"
                  decoration-muted="state == 'closed'"
                  decoration-danger="state == 'expired'">
                <field name="name"/>
                <field name="contract_type_id" widget="badge"/>
                <field name="vehicle_id"/>
                <field name="partner_id" optional="show"/>
                <field name="reference" optional="hide"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="cost" sum="Total" optional="show"/>
                <field name="cost_frequency" widget="badge" optional="show"
                       decoration-warning="cost_frequency"/>
                <field name="next_due_date" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="expiring_alert" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'running'"
                       decoration-info="state == 'draft'"
                       decoration-danger="state == 'expired'"/>
            </list>
        </field>
    </record>

    <!-- Vehicle Agreement Form View -->
    <record id="view_fleet_contract_form" model="ir.ui.view">
        <field name="name">fleet.contract.form</field>
        <field name="model">fleet.contract</field>
        <field name="arch" type="xml">
            <form string="Vehicle Agreement">
                <header>
                    <button name="action_run" string="Set to Running" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_set_expired" string="Mark as Expired" type="object"
                            invisible="state not in ('draft', 'running')"/>
                    <button name="action_close" string="Close" type="object"
                            invisible="state == 'closed'"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object"
                            invisible="state not in ('expired', 'closed')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,running,expired,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_services" type="object"
                                class="oe_stat_button" icon="fa-wrench">
                            <field name="service_count" widget="statinfo" string="Services"/>
                        </button>
                    </div>
                    <field name="active" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="days_until_due" invisible="1"/>
                    <div class="alert alert-warning d-flex align-items-center gap-2 mb-3" role="alert"
                         invisible="not cost_frequency or state not in ('draft', 'running')">
                        <i class="fa fa-repeat" title="Recurring payment"/>
                        <span>
                            Recurring payment: <field name="cost" class="fw-bold" readonly="1"/>
                            <field name="cost_frequency" class="fw-bold" readonly="1"/>
                            <span invisible="not next_due_date">
                                · next due <field name="next_due_date" class="fw-bold" readonly="1"/>
                                (in <field name="days_until_due" readonly="1"/> days)
                            </span>
                        </span>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group name="contract_info" string="Vehicle Agreement">
                            <field name="vehicle_id" options="{'no_create': True}"/>
                            <field name="contract_type_id" options="{'no_create': True}" readonly="state != 'draft'"/>
                            <field name="partner_id" context="{'res_partner_search_mode': 'supplier'}"/>
                            <field name="reference" placeholder="Policy number, lease number..."/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="company_id" options="{'no_create': True}"
                                   groups="base.group_multi_company"/>
                        </group>
                        <group name="dates_info" string="Validity">
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="reminder_days"/>
                            <field name="days_until_expiry" invisible="state != 'running'"
                                   decoration-warning="expiring_alert"
                                   decoration-danger="days_until_expiry &lt; 0"/>
                            <field name="expiring_alert" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <group name="cost_info" string="Cost">
                            <field name="cost"/>
                            <field name="cost_frequency"/>
                            <field name="total_cost" invisible="not cost_frequency"/>
                        </group>
                        <group name="deposit_info" string="Deposit">
                            <field name="deposit"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="notes" string="Notes">
                            <field name="notes" placeholder="Vehicle Agreement terms, renewal conditions..."/>
                        </page>
                        <page name="attachments" string="Attachments">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Vehicle Agreement Search View -->
    <record id="view_fleet_contract_search" model="ir.ui.view">
        <field name="name">fleet.contract.search</field>
        <field name="model">fleet.contract</field>
        <field name="arch" type="xml">
            <search string="Search Vehicle Agreements">
                <field name="name" string="Reference"/>
                <field name="vehicle_id" string="Vehicle"/>
                <field name="partner_id" string="Vendor"/>
                <field name="contract_type_id" string="Agreement Type"/>
                <field name="reference" string="Vendor Reference"/>
                <field name="user_id" string="Responsible"/>

                <filter name="filter_my" string="My Vehicle Agreements" domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter name="filter_expiring" string="Expiring in 30 Days"
                        domain="[('state', '=', 'running'), ('end_date', '&gt;=', context_today().strftime('%Y-%m-%d')), ('end_date', '&lt;=', (context_today() + datetime.timedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <filter name="filter_past_end" string="Past End Date (still running)"
                        domain="[('state', '=', 'running'), ('end_date', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>

                <separator/>
                <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_running" string="Running" domain="[('state', '=', 'running')]"/>
                <filter name="filter_state_expired" string="Expired" domain="[('state', '=', 'expired')]"/>
                <filter name="filter_closed" string="Closed" domain="[('state', '=', 'closed')]"/>

                <separator/>
                <filter name="filter_recurring" string="Recurring" domain="[('cost_frequency', '!=', False)]"/>
                <filter name="filter_one_time" string="One-time" domain="[('cost_frequency', '=', False)]"/>

                <separator/>
                <filter name="filter_start_date" string="Start Date" date="start_date"/>
                <filter name="filter_end_date" string="End Date" date="end_date"/>

                <separator/>
                <filter name="filter_archived" string="Archived" domain="[('active', '=', False)]"/>

                <group expand="0" string="Group By">
                    <filter name="group_type" string="Agreement Type" context="{'group_by': 'contract_type_id'}"/>
                    <filter name="group_vehicle" string="Vehicle" context="{'group_by': 'vehicle_id'}"/>
                    <filter name="group_partner" string="Vendor" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_user" string="Responsible" context="{'group_by': 'user_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_frequency" string="Recurring Frequency" context="{'group_by': 'cost_frequency'}"/>
                    <filter name="group_end_date" string="End Date" context="{'group_by': 'end_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ========================================= -->
    <!-- Fleet Service                             -->
    <!-- ========================================= -->

    <record id="action_fleet_service" model="ir.actions.act_window">
        <field name="name">Services</field>
        <field name="res_model">fleet.service</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Record a new vehicle service
            </p>
            <p>
                Track services performed on your vehicles with their vendor,
                cost, inspection center and odometer reading.
            </p>
        </field>
    </record>

    <!-- Service List View -->
    <record id="view_fleet_service_list" model="ir.ui.view">
        <field name="name">fleet.service.list</field>
        <field name="model">fleet.service</field>
        <field name="arch" type="xml">
            <list string="Services"
                  decoration-info="state == 'new'"
                  decoration-warning="state == 'running'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="service_type_id"/>
                <field name="partner_id" optional="show"/>
                <field name="inspection_center_id" optional="show"/>
                <field name="user_id" widget="many2one_avatar_user" optional="hide"/>
                <field name="date"/>
                <field name="end_date" optional="show"/>
                <field name="odometer" widget="integer" optional="show"/>
                <field name="next_service_odometer" widget="integer" optional="hide"/>
                <field name="contract_id" optional="hide"/>
                <field name="cost" sum="Total" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state == 'new'"
                       decoration-warning="state == 'running'"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="company_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Service Form View -->
    <record id="view_fleet_service_form" model="ir.ui.view">
        <field name="name">fleet.service.form</field>
        <field name="model">fleet.service</field>
        <field name="arch" type="xml">
            <form string="Fleet Service">
                <header>
                    <button name="action_start" string="Start" type="object"
                            class="btn-primary" invisible="state != 'new'"/>
                    <button name="action_done" string="Mark as Done" type="object"
                            class="btn-primary" invisible="state not in ('new', 'running')"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ('done', 'cancelled')"/>
                    <button name="action_reset_new" string="Reset to New" type="object"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,running,done"/>
                </header>
                <sheet>
                    <field name="active" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group name="service_info" string="Service">
                            <field name="vehicle_id" options="{'no_create': True}"/>
                            <field name="service_type_id" options="{'no_create': True}"/>
                            <field name="partner_id" context="{'res_partner_search_mode': 'supplier'}"/>
                            <field name="inspection_center_id" context="{'res_partner_search_mode': 'supplier'}"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="contract_id" options="{'no_create': True}"
                                   domain="[('vehicle_id', '=', vehicle_id)]"/>
                            <field name="company_id" options="{'no_create': True}"
                                   groups="base.group_multi_company"/>
                        </group>
                        <group name="dates_info" string="Dates">
                            <field name="date"/>
                            <field name="end_date" required="state == 'done'"/>
                        </group>
                    </group>
                    <group>
                        <group name="odometer_info" string="Odometer">
                            <field name="odometer" widget="integer"/>
                            <field name="service_interval" widget="integer"/>
                            <field name="next_service_odometer" widget="integer"
                                   invisible="not service_interval"/>
                        </group>
                        <group name="cost_info" string="Cost">
                            <field name="cost"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="description" string="Description of Work">
                            <field name="description" placeholder="Work performed..."/>
                        </page>
                        <page name="notes" string="Notes">
                            <field name="notes" placeholder="Additional notes..."/>
                        </page>
                        <page name="attachments" string="Attachments">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Service Search View -->
    <record id="view_fleet_service_search" model="ir.ui.view">
        <field name="name">fleet.service.search</field>
        <field name="model">fleet.service</field>
        <field name="arch" type="xml">
            <search string="Search Services">
                <field name="name" string="Reference"/>
                <field name="vehicle_id" string="Vehicle"/>
                <field name="service_type_id" string="Service Type"/>
                <field name="partner_id" string="Vendor"/>
                <field name="inspection_center_id" string="Inspection Center"/>
                <field name="user_id" string="Responsible"/>
                <field name="contract_id" string="Vehicle Agreement"/>

                <filter name="filter_my" string="My Services" domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter name="filter_open" string="Open (New + Running)" domain="[('state', 'in', ('new', 'running'))]"/>
                <separator/>
                <filter name="filter_new" string="New" domain="[('state', '=', 'new')]"/>
                <filter name="filter_running" string="Running" domain="[('state', '=', 'running')]"/>
                <filter name="filter_done" string="Done" domain="[('state', '=', 'done')]"/>
                <filter name="filter_cancelled" string="Cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter name="filter_under_contract" string="Under a Vehicle Agreement" domain="[('contract_id', '!=', False)]"/>
                <separator/>
                <filter name="filter_date" string="Start Date" date="date"/>
                <filter name="filter_end_date" string="End Date" date="end_date"/>
                <separator/>
                <filter name="filter_archived" string="Archived" domain="[('active', '=', False)]"/>

                <group expand="0" string="Group By">
                    <filter name="group_vehicle" string="Vehicle" context="{'group_by': 'vehicle_id'}"/>
                    <filter name="group_type" string="Service Type" context="{'group_by': 'service_type_id'}"/>
                    <filter name="group_partner" string="Vendor" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_inspection_center" string="Inspection Center" context="{'group_by': 'inspection_center_id'}"/>
                    <filter name="group_date" string="Start Date" context="{'group_by': 'date:month'}"/>
                    <filter name="group_contract" string="Vehicle Agreement" context="{'group_by': 'contract_id'}"/>
                </group>
            </search>
        </field>
    </record>

</odoo>
