<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================================= -->
    <!-- Fleet Contract                            -->
    <!-- ========================================= -->

    <record id="action_fleet_contract" model="ir.actions.act_window">
        <field name="name">Contracts</field>
        <field name="res_model">fleet.contract</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new vehicle contract
            </p>
            <p>
                Manage insurance policies, leases, rental agreements and service
                contracts with their renewal dates.
            </p>
        </field>
    </record>

    <!-- Contract List View -->
    <record id="view_fleet_contract_list" model="ir.ui.view">
        <field name="name">fleet.contract.list</field>
        <field name="model">fleet.contract</field>
        <field name="arch" type="xml">
            <list string="Contracts"
                  decoration-success="state == 'running'"
                  decoration-info="state == 'draft'"
                  decoration-warning="expiring_alert"
                  decoration-danger="state == 'cancelled' or days_until_expiry &lt; 0">
                <field name="name"/>
                <field name="contract_type" widget="badge"/>
                <field name="vehicle_id"/>
                <field name="partner_id" optional="show"/>
                <field name="reference" optional="hide"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="days_until_expiry" invisible="1"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- Contract Form View -->
    <record id="view_fleet_contract_form" model="ir.ui.view">
        <field name="name">fleet.contract.form</field>
        <field name="model">fleet.contract</field>
        <field name="arch" type="xml">
            <form string="Contract">
                <header>
                    <button name="action_run" string="Set to Running" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_cancel" string="Cancel Contract" type="object"
                            class="btn-secondary" invisible="state not in ('draft', 'running')"/>
                    <button name="action_set_expired" string="Mark as Expired" type="object"
                            class="btn-secondary" invisible="state not in ('draft', 'running')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,running,expired"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" placeholder="Contract Reference"/>
                        </h1>
                    </div>
                    <group>
                        <group name="contract_info" string="Contract Information">
                            <field name="contract_type" readonly="state != 'draft'"/>
                            <field name="vehicle_id" options="{'no_create': True}"/>
                            <field name="partner_id"/>
                            <field name="reference" placeholder="Policy number, lease number..."/>
                            <field name="days_until_expiry" visible="end_date"/>
                        </group>
                        <group name="dates_info" string="Validity">
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="expiring_alert" widget="boolean_toggle" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group name="company_info" string="Company">
                            <field name="company_id" options="{'no_create': True}"
                                   groups="base.group_multi_company"/>
                        </group>
                        <group name="service_info" string="Services">
                            <button name="action_view_services" type="object"
                                    class="oe_stat_button" icon="fa-wrench"
                                    invisible="service_count == 0">
                                <div class="o_stat_info">
                                    <span class="o_stat_value">
                                        <field name="service_count"/> Services
                                    </span>
                                </div>
                            </button>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" placeholder="Contract terms, renewal conditions..." nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Contract Search View -->
    <record id="view_fleet_contract_search" model="ir.ui.view">
        <field name="name">fleet.contract.search</field>
        <field name="model">fleet.contract</field>
        <field name="arch" type="xml">
            <search string="Search Contracts">
                <field name="name" string="Reference"/>
                <field name="vehicle_id" string="Vehicle"/>
                <field name="partner_id" string="Provider"/>
                <field name="reference" string="External Reference"/>

                <filter name="filter_expiring" string="Expiring in 30 Days"
                        domain="[('state', '=', 'running'), ('end_date', '&gt;=', context_today()), ('end_date', '&lt;=', (context_today() + datetime.timedelta(days=30)))]"/>
                <filter name="filter_expired" string="Past End Date"
                        domain="[('end_date', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>

                <separator/>
                <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_running" string="Running" domain="[('state', '=', 'running')]"/>
                <filter name="filter_expired" string="Expired" domain="[('state', '=', 'expired')]"/>
                <filter name="filter_cancelled" string="Cancelled" domain="[('state', '=', 'cancelled')]"/>

                <separator/>
                <filter name="filter_type_insurance" string="Insurance" domain="[('contract_type', '=', 'insurance')]"/>
                <filter name="filter_type_lease" string="Lease" domain="[('contract_type', '=', 'lease')]"/>
                <filter name="filter_type_rental" string="Rental Agreement" domain="[('contract_type', '=', 'rental_agreement')]"/>
                <filter name="filter_type_service" string="Service Contract" domain="[('contract_type', '=', 'service_contract')]"/>

                <group expand="0" string="Group By">
                    <filter name="group_type" string="Contract Type" context="{'group_by': 'contract_type'}"/>
                    <filter name="group_vehicle" string="Vehicle" context="{'group_by': 'vehicle_id'}"/>
                    <filter name="group_partner" string="Provider" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
                    <filter name="group_end_date" string="End Date" context="{'group_by': 'end_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ========================================= -->
    <!-- Fleet Service                             -->
    <!-- ========================================= -->

    <record id="action_fleet_service" model="ir.actions.act_window">
        <field name="name">Services</field>
        <field name="res_model">fleet.service</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Record a new vehicle service
            </p>
            <p>
                Track one-off services performed on your vehicles with their
                provider and odometer reading.
            </p>
        </field>
    </record>

    <!-- Service List View -->
    <record id="view_fleet_service_list" model="ir.ui.view">
        <field name="name">fleet.service.list</field>
        <field name="model">fleet.service</field>
        <field name="arch" type="xml">
            <list string="Services">
                <field name="name"/>
                <field name="date"/>
                <field name="vehicle_id"/>
                <field name="service_type_id"/>
                <field name="description" optional="hide"/>
                <field name="service_provider" optional="show"/>
                <field name="odometer" widget="integer" optional="show"/>
                <field name="contract_id" optional="show"/>
                <field name="company_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Service Form View -->
    <record id="view_fleet_service_form" model="ir.ui.view">
        <field name="name">fleet.service.form</field>
        <field name="model">fleet.service</field>
        <field name="arch" type="xml">
            <form string="Fleet Service">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" placeholder="Service Reference"/>
                        </h1>
                    </div>
                    <group>
                        <group name="service_info" string="Service Information">
                            <field name="vehicle_id" options="{'no_create': True}"/>
                            <field name="service_type_id"/>
                            <field name="date"/>
                            <field name="service_provider" placeholder="Workshop or vendor..."/>
                        </group>
                        <group name="service_details" string="Service Details">
                            <field name="odometer" widget="integer"/>
                            <field name="contract_id" options="{'no_create': True}"/>
                            <field name="company_id" options="{'no_create': True}"
                                   groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" placeholder="Work performed..." nolabel="1"/>
                    </group>
                    <group string="Notes">
                        <field name="notes" placeholder="Additional notes..." nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Service Search View -->
    <record id="view_fleet_service_search" model="ir.ui.view">
        <field name="name">fleet.service.search</field>
        <field name="model">fleet.service</field>
        <field name="arch" type="xml">
            <search string="Search Services">
                <field name="name" string="Reference"/>
                <field name="vehicle_id" string="Vehicle"/>
                <field name="service_type_id" string="Service Type"/>
                <field name="service_provider" string="Provider"/>
                <field name="contract_id" string="Contract"/>

                <filter name="filter_this_month" string="This Month"
                        domain="[('date', '&gt;=', context_today().strftime('%Y-%m-01')), ('date', '&lt;=', context_today().strftime('%Y-%m-%d'))]"/>

                <group expand="0" string="Group By">
                    <filter name="group_vehicle" string="Vehicle" context="{'group_by': 'vehicle_id'}"/>
                    <filter name="group_type" string="Service Type" context="{'group_by': 'service_type_id'}"/>
                    <filter name="group_date" string="Date" context="{'group_by': 'date'}"/>
                    <filter name="group_contract" string="Contract" context="{'group_by': 'contract_id'}"/>
                </group>
            </search>
        </field>
    </record>

</odoo>
