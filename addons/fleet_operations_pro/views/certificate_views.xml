<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Certificate Actions (defined first) -->
    <record id="action_fleet_vehicle_certificate" model="ir.actions.act_window">
        <field name="name">Certificates</field>
        <field name="res_model">fleet.vehicle.certificate</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first certificate
            </p>
            <p>
                Track all vehicle certificates and documents including registration,
                insurance, pollution certificates, permits, and licenses.
                Get automatic reminders before expiry.
            </p>
        </field>
    </record>
    
    <record id="action_fleet_vehicle_certificate_vehicle" model="ir.actions.act_window">
        <field name="name">Certificates</field>
        <field name="res_model">fleet.vehicle.certificate</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_vehicle_id': active_id, 'search_default_vehicle_id': active_id}</field>
    </record>
    
    <record id="action_fleet_certificate_type" model="ir.actions.act_window">
        <field name="name">Certificate Types</field>
        <field name="res_model">fleet.certificate.type</field>
        <field name="view_mode">list,form</field>
    </record>
    
    <!-- Certificate List View -->
    <record id="view_fleet_vehicle_certificate_list" model="ir.ui.view">
        <field name="name">fleet.vehicle.certificate.list</field>
        <field name="model">fleet.vehicle.certificate</field>
        <field name="arch" type="xml">
            <list string="Vehicle Certificates" sample="1" 
                  decoration-success="state == 'valid'"
                  decoration-warning="state == 'expiring_soon'"
                  decoration-danger="state == 'expired'"
                  decoration-muted="state == 'renewed'">
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="certificate_type_id"/>
                <field name="issue_date"/>
                <field name="expiry_date"/>
                <field name="days_until_expiry" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'valid'"
                       decoration-warning="state == 'expiring_soon'"
                       decoration-danger="state == 'expired'"
                       decoration-info="state == 'renewed'"/>
                <field name="issuing_authority" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>
    
    <!-- Certificate Kanban View -->
    <record id="view_fleet_vehicle_certificate_kanban" model="ir.ui.view">
        <field name="name">fleet.vehicle.certificate.kanban</field>
        <field name="model">fleet.vehicle.certificate</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_small_column" sample="1">
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="certificate_type_id"/>
                <field name="expiry_date"/>
                <field name="state"/>
                <field name="days_until_expiry"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top mb4">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="certificate_type_id"/>
                                    </strong>
                                    <div class="o_kanban_record_subtitle">
                                        <i class="fa fa-car"/> <field name="vehicle_id"/>
                                    </div>
                                </div>
                                <div class="o_dropdown_kanban dropdown">
                                    <a class="dropdown-toggle o-no-caret btn" role="button" data-bs-toggle="dropdown" href="#" aria-label="Dropdown menu" title="Dropdown menu">
                                        <span class="fa fa-ellipsis-v"/>
                                    </a>
                                    <div class="dropdown-menu" role="menu">
                                        <a role="menuitem" type="edit" class="dropdown-item">Edit</a>
                                        <a role="menuitem" type="delete" class="dropdown-item">Delete</a>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="o_kanban_record_body">
                                <div class="row">
                                    <div class="col-6">
                                        <span>Certificate #:</span>
                                    </div>
                                    <div class="col-6">
                                        <strong><field name="name"/></strong>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-6">
                                        <span>Expires:</span>
                                    </div>
                                    <div class="col-6">
                                        <field name="expiry_date"/>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-12">
                                        <field name="state" widget="label_selection"
                                               options="{'classes': {'valid': 'success', 'expiring_soon': 'warning', 'expired': 'danger', 'renewed': 'info'}}"/>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <t t-if="record.days_until_expiry.raw_value &gt; 0">
                                        <span class="badge badge-pill" t-att-class="record.state.raw_value == 'expiring_soon' ? 'badge-warning' : 'badge-success'">
                                            <i class="fa fa-clock-o"/> <field name="days_until_expiry"/> days
                                        </span>
                                    </t>
                                    <t t-if="record.days_until_expiry.raw_value &lt;= 0">
                                        <span class="badge badge-pill badge-danger">
                                            <i class="fa fa-exclamation-triangle"/> Expired
                                        </span>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    
    <!-- Certificate Form View -->
    <record id="view_fleet_vehicle_certificate_form" model="ir.ui.view">
        <field name="name">fleet.vehicle.certificate.form</field>
        <field name="model">fleet.vehicle.certificate</field>
        <field name="arch" type="xml">
            <form string="Vehicle Certificate">
                <header>
                    <button name="action_renew_certificate" string="Renew Certificate" 
                            type="object" class="oe_highlight"
                            invisible="state != 'expired' and state != 'expiring_soon'"/>
                    <field name="state" widget="statusbar" 
                           statusbar_visible="valid,expiring_soon,expired"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    
                    <widget name="web_ribbon" title="Expired" bg_color="text-bg-danger" 
                            invisible="state != 'expired'"/>
                    <widget name="web_ribbon" title="Expiring Soon" bg_color="text-bg-warning" 
                            invisible="state != 'expiring_soon'"/>
                    <widget name="web_ribbon" title="Renewed" bg_color="text-bg-info" 
                            invisible="state != 'renewed'"/>
                    
                    <div class="oe_title">
                        <label for="certificate_type_id" string="Certificate Type"/>
                        <h1>
                            <field name="certificate_type_id" placeholder="Select Certificate Type..." required="1"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group>
                            <field name="name" required="1"/>
                            <field name="vehicle_id" required="1"/>
                            <field name="issue_date" required="1"/>
                            <field name="expiry_date" required="1"/>
                        </group>
                        <group>
                            <field name="days_until_expiry" 
                                   decoration-warning="days_until_expiry &lt;= 30 and days_until_expiry &gt; 0"
                                   decoration-danger="days_until_expiry &lt;= 0"/>
                            <field name="issuing_authority"/>
                            <field name="issuing_location"/>
                            <field name="renewal_cost" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Details">
                            <group>
                                <field name="description" placeholder="Additional details about this certificate..."/>
                            </group>
                            <group string="Renewal Information" invisible="not renewal_certificate_id and not previous_certificate_id">
                                <field name="previous_certificate_id" readonly="1"/>
                                <field name="renewal_certificate_id" readonly="1"/>
                            </group>
                        </page>
                        <page string="Attachments">
                            <field name="attachment_ids" widget="many2many_binary" string="Documents"/>
                        </page>
                        <page string="Additional Information">
                            <group>
                                <group>
                                    <field name="company_id" groups="base.group_multi_company"/>
                                    <field name="active"/>
                                </group>
                                <group>
                                    <field name="notes" placeholder="Additional notes..."/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    
    <!-- Certificate Search View -->
    <record id="view_fleet_vehicle_certificate_search" model="ir.ui.view">
        <field name="name">fleet.vehicle.certificate.search</field>
        <field name="model">fleet.vehicle.certificate</field>
        <field name="arch" type="xml">
            <search string="Search Certificates">
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="certificate_type_id"/>
                <field name="issuing_authority"/>
                
                <filter string="Active" name="filter_active" 
                        domain="[('active', '=', True)]"/>
                <filter string="Valid" name="filter_valid" 
                        domain="[('state', '=', 'valid')]"/>
                <filter string="Expiring Soon" name="filter_expiring_soon" 
                        domain="[('state', '=', 'expiring_soon')]"/>
                <filter string="Expired" name="filter_expired" 
                        domain="[('state', '=', 'expired')]"/>
                <filter string="Renewed" name="filter_renewed" 
                        domain="[('state', '=', 'renewed')]"/>
                
                <separator/>
                <filter string="Expiring Within 30 Days" name="filter_expiring_30" 
                        domain="[('days_until_expiry', '&lt;=', 30), ('days_until_expiry', '&gt;', 0)]"/>
                <filter string="Expiring Within 60 Days" name="filter_expiring_60" 
                        domain="[('days_until_expiry', '&lt;=', 60), ('days_until_expiry', '&gt;', 0)]"/>
                <filter string="Expiring Within 90 Days" name="filter_expiring_90" 
                        domain="[('days_until_expiry', '&lt;=', 90), ('days_until_expiry', '&gt;', 0)]"/>
                
                <separator/>
                <filter string="Vehicle" name="group_by_vehicle" 
                        context="{'group_by': 'vehicle_id'}"/>
                <filter string="Certificate Type" name="group_by_type" 
                        context="{'group_by': 'certificate_type_id'}"/>
                <filter string="Status" name="group_by_state" 
                        context="{'group_by': 'state'}"/>
                <filter string="Company" name="group_by_company" 
                        context="{'group_by': 'company_id'}" 
                        groups="base.group_multi_company"/>
            </search>
        </field>
    </record>
    
    <!-- Certificate Type Views -->
    <record id="view_fleet_certificate_type_list" model="ir.ui.view">
        <field name="name">fleet.certificate.type.list</field>
        <field name="model">fleet.certificate.type</field>
        <field name="arch" type="xml">
            <list string="Certificate Types" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="mandatory"/>
                <field name="requires_renewal"/>
                <field name="validity_period_months"/>
                <field name="reminder_days"/>
                <field name="certificate_count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    
    <record id="view_fleet_certificate_type_form" model="ir.ui.view">
        <field name="name">fleet.certificate.type.form</field>
        <field name="model">fleet.certificate.type</field>
        <field name="arch" type="xml">
            <form string="Certificate Type">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_fleet_vehicle_certificate)d" 
                                type="action" 
                                class="oe_stat_button" 
                                icon="fa-certificate">
                            <field name="certificate_count" widget="statinfo" string="Certificates"/>
                        </button>
                    </div>
                    
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" 
                            invisible="active"/>
                    
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Registration, Insurance, Inspection"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group name="basic_info" string="Basic Information">
                            <field name="code" placeholder="e.g. REG, INS, INSP"/>
                            <field name="sequence"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                        
                        <group name="settings" string="Settings">
                            <field name="active" widget="boolean_toggle"/>
                            <field name="mandatory" widget="boolean_toggle"/>
                            <field name="requires_renewal" widget="boolean_toggle"/>
                        </group>
                    </group>
                    
                    <group name="renewal_config" string="Renewal Configuration" 
                           invisible="not requires_renewal">
                        <group>
                            <field name="validity_period_months" 
                                   invisible="not requires_renewal"/>
                            <field name="reminder_days" 
                                   invisible="not requires_renewal"/>
                        </group>
                    </group>
                    
                    <separator string="Description"/>
                    <field name="description" placeholder="Detailed description of this certificate type..." nolabel="1"/>
                </sheet>
            </form>
        </field>
    </record>
    
</odoo>

