<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Cost Record Actions (defined first to be referenced in views) -->
    <record id="action_fleet_cost_record" model="ir.actions.act_window">
        <field name="name">Cost Records</field>
        <field name="res_model">fleet.cost.record</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="context">{'search_default_filter_this_year': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first cost record
            </p>
            <p>
                Track all fleet-related costs including fuel, maintenance, insurance,
                and other expenses. Analyze costs by category and vehicle.
            </p>
        </field>
    </record>
    
    <record id="action_fleet_cost_record_vehicle" model="ir.actions.act_window">
        <field name="name">Cost Records</field>
        <field name="res_model">fleet.cost.record</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="context">{'default_vehicle_id': active_id, 'search_default_vehicle_id': active_id}</field>
    </record>
    
    <record id="action_fleet_cost_category" model="ir.actions.act_window">
        <field name="name">Cost Categories</field>
        <field name="res_model">fleet.cost.category</field>
        <field name="view_mode">list,form</field>
    </record>
    
    <!-- Cost Record List View -->
    <record id="view_fleet_cost_record_list" model="ir.ui.view">
        <field name="name">fleet.cost.record.list</field>
        <field name="model">fleet.cost.record</field>
        <field name="arch" type="xml">
            <list string="Cost Records" sample="1" decoration-muted="auto_generated">
                <field name="date"/>
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="category_id"/>
                <field name="description"/>
                <field name="amount" sum="Total Amount" widget="monetary"/>
                <field name="odometer"/>
                <field name="cost_per_km" widget="monetary" optional="hide"/>
                <field name="vendor" optional="show"/>
                <field name="invoice_reference" optional="hide"/>
                <field name="auto_generated" column_invisible="1"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    
    <!-- Cost Record Form View -->
    <record id="view_fleet_cost_record_form" model="ir.ui.view">
        <field name="name">fleet.cost.record.form</field>
        <field name="model">fleet.cost.record</field>
        <field name="arch" type="xml">
            <form string="Cost Record">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_source_record" 
                                type="object" 
                                class="oe_stat_button" 
                                icon="fa-link"
                                invisible="not source_model">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">View Source</span>
                            </div>
                        </button>
                    </div>
                    
                    <widget name="web_ribbon" title="Auto Generated" bg_color="text-bg-info" 
                            invisible="not auto_generated"/>
                    
                    <div class="oe_title">
                        <label for="name" string="Cost Reference"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group name="basic_info" string="Basic Information">
                            <field name="vehicle_id" required="1" options="{'no_create': True}"/>
                            <field name="category_id" required="1" options="{'no_create': True, 'no_open': True}"/>
                            <field name="date" required="1"/>
                            <field name="driver_id" options="{'no_create': True}"/>
                        </group>
                        
                        <group name="cost_info" string="Cost Details">
                            <field name="amount" required="1" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="odometer" widget="integer"/>
                            <field name="cost_per_km" widget="monetary" readonly="1"/>
                        </group>
                    </group>
                    
                    <group>
                        <group name="vendor_info" string="Vendor Information">
                            <field name="vendor"/>
                            <field name="invoice_reference"/>
                        </group>
                        
                        <group name="company_info" string="Company">
                            <field name="company_id" options="{'no_create': True}" 
                                   groups="base.group_multi_company"/>
                        </group>
                    </group>
                    
                    <group name="description_group" string="Description">
                        <field name="description" placeholder="Detailed description of the cost..." 
                               required="1" nolabel="1"/>
                    </group>
                    
                    <notebook>
                        <page name="additional_info" string="Additional Information">
                            <group>
                                <group name="source_info" string="Source Information">
                                    <field name="auto_generated" readonly="1"/>
                                    <field name="source_model" readonly="1" invisible="not source_model"/>
                                    <field name="source_record_id" readonly="1" invisible="not source_record_id"/>
                                </group>
                                <group name="metadata" string="Metadata">
                                    <field name="create_date" readonly="1"/>
                                    <field name="write_date" readonly="1"/>
                                </group>
                            </group>
                            
                            <separator string="Notes"/>
                            <field name="notes" placeholder="Additional notes or comments..." nolabel="1"/>
                        </page>
                        
                        <page name="attachments" string="Attachments">
                            <field name="attachment_ids" widget="many2many_binary" string="Documents"/>
                        </page>
                    </notebook>
                </sheet>
                
                <!-- Chatter -->
                <chatter/>
            </form>
        </field>
    </record>
    
    <!-- Cost Record Search View -->
    <record id="view_fleet_cost_record_search" model="ir.ui.view">
        <field name="name">fleet.cost.record.search</field>
        <field name="model">fleet.cost.record</field>
        <field name="arch" type="xml">
            <search string="Search Cost Records">
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="category_id"/>
                <field name="vendor"/>
                <field name="description"/>
                
                <filter string="This Month" name="filter_this_month" 
                        domain="[('date', '&gt;=', context_today().strftime('%Y-%m-01')), ('date', '&lt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="This Year" name="filter_this_year" 
                        domain="[('date', '&gt;=', context_today().strftime('%Y-01-01'))]"/>
                <filter string="Auto Generated" name="filter_auto_generated" 
                        domain="[('auto_generated', '=', True)]"/>
                <filter string="Manual" name="filter_manual" 
                        domain="[('auto_generated', '=', False)]"/>
                
                <separator/>
                <filter string="Date" name="group_by_date" 
                        context="{'group_by': 'date'}"/>
                <filter string="Vehicle" name="group_by_vehicle" 
                        context="{'group_by': 'vehicle_id'}"/>
                <filter string="Category" name="group_by_category" 
                        context="{'group_by': 'category_id'}"/>
                <filter string="Vendor" name="group_by_vendor" 
                        context="{'group_by': 'vendor'}"/>
                <filter string="Company" name="group_by_company" 
                        context="{'group_by': 'company_id'}" 
                        groups="base.group_multi_company"/>
            </search>
        </field>
    </record>
    
    <!-- Cost Record Pivot View -->
    <record id="view_fleet_cost_record_pivot" model="ir.ui.view">
        <field name="name">fleet.cost.record.pivot</field>
        <field name="model">fleet.cost.record</field>
        <field name="arch" type="xml">
            <pivot string="Cost Analysis" sample="1">
                <field name="category_id" type="row"/>
                <field name="date" interval="month" type="col"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>
    
    <!-- Cost Record Graph View -->
    <record id="view_fleet_cost_record_graph" model="ir.ui.view">
        <field name="name">fleet.cost.record.graph</field>
        <field name="model">fleet.cost.record</field>
        <field name="arch" type="xml">
            <graph string="Cost Analysis" sample="1" type="bar" stacked="True">
                <field name="category_id" type="row"/>
                <field name="amount" type="measure"/>
            </graph>
        </field>
    </record>
    
    <!-- Cost Category List View -->
    <record id="view_fleet_cost_category_list" model="ir.ui.view">
        <field name="name">fleet.cost.category.list</field>
        <field name="model">fleet.cost.category</field>
        <field name="arch" type="xml">
            <list string="Cost Categories" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="description"/>
                <field name="auto_generated"/>
                <field name="cost_record_count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    
    <!-- Cost Category Form View -->
    <record id="view_fleet_cost_category_form" model="ir.ui.view">
        <field name="name">fleet.cost.category.form</field>
        <field name="model">fleet.cost.category</field>
        <field name="arch" type="xml">
            <form string="Cost Category">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_fleet_cost_record)d" 
                                type="action" 
                                class="oe_stat_button" 
                                icon="fa-money">
                            <field name="cost_record_count" widget="statinfo" string="Cost Records"/>
                        </button>
                    </div>
                    
                    <widget name="web_ribbon" title="Auto Generated" bg_color="text-bg-info" 
                            invisible="not auto_generated"/>
                    
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" 
                            invisible="active"/>
                    
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Fuel, Maintenance, Insurance"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group name="basic_info" string="Basic Information">
                            <field name="code" placeholder="e.g. FUEL, MAINT, INS"/>
                            <field name="sequence"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                        
                        <group name="settings" string="Settings">
                            <field name="active" widget="boolean_toggle"/>
                            <field name="auto_generated" readonly="1"/>
                        </group>
                    </group>
                    
                    <separator string="Description"/>
                    <field name="description" placeholder="Detailed description of this cost category..." nolabel="1"/>
                </sheet>
                
                <!-- Chatter -->
                <chatter/>
            </form>
        </field>
    </record>
    
</odoo>


