<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Driver Actions (defined first to be referenced in views) -->
    <record id="action_fleet_driver" model="ir.actions.act_window">
        <field name="name">Drivers</field>
        <field name="res_model">fleet.driver</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first driver
            </p>
            <p>
                Register drivers with their license information and contact details.
                Track license expiry and manage vehicle assignments.
            </p>
        </field>
    </record>
    
    <record id="action_fleet_driver_assignment" model="ir.actions.act_window">
        <field name="name">Driver Assignments</field>
        <field name="res_model">fleet.driver.assignment</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_active': 1}</field>
    </record>
    
    <!-- Driver List View -->
    <record id="view_fleet_driver_list" model="ir.ui.view">
        <field name="name">fleet.driver.list</field>
        <field name="model">fleet.driver</field>
        <field name="arch" type="xml">
            <list string="Fleet Drivers" sample="1">
                <field name="name" decoration-bf="1"/>
                <field name="code"/>
                <field name="license_number"/>
                <field name="license_type"/>
                <field name="license_expiry_date"/>
                <field name="license_status" widget="badge" 
                       decoration-success="license_status == 'valid'"
                       decoration-warning="license_status == 'expiring_soon'"
                       decoration-danger="license_status == 'expired'"/>
                <field name="days_until_expiry"/>
                <field name="employment_status" widget="badge"/>
                <field name="current_vehicle_id"/>
                <field name="phone"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    
    <!-- Driver Form View -->
    <record id="view_fleet_driver_form" model="ir.ui.view">
        <field name="name">fleet.driver.form</field>
        <field name="model">fleet.driver</field>
        <field name="arch" type="xml">
            <form string="Fleet Driver">
                <header>
                    <button name="action_assign_vehicle" 
                            string="Assign Vehicle" 
                            type="object" 
                            class="oe_highlight"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_fleet_driver_assignment)d" 
                                type="action" 
                                class="oe_stat_button" 
                                icon="fa-car">
                            <field name="assignment_count" widget="statinfo" string="Assignments"/>
                        </button>
                    </div>
                    
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" 
                            invisible="active"/>
                    
                    <field name="active" invisible="1"/>
                    
                    <field name="image" widget="image" class="oe_avatar" options="{'size': [90, 90]}"/>
                    
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Driver Name"/>
                        </h1>
                        <label for="code"/>
                        <h3>
                            <field name="code" placeholder="Driver Code (optional)"/>
                        </h3>
                    </div>
                    
                    <group>
                        <group name="basic_info" string="Basic Information">
                            <field name="employment_status"/>
                            <field name="current_vehicle_id"/>
                            <field name="partner_id"/>
                        </group>
                        
                        <group name="contact_info" string="Contact Information">
                            <field name="email" widget="email"/>
                            <field name="phone" widget="phone"/>
                            <field name="mobile" widget="phone"/>
                        </group>
                    </group>
                    
                    <group>
                        <group name="license_info" string="License Information">
                            <field name="license_number"/>
                            <field name="license_type"/>
                            <field name="license_issue_date"/>
                            <field name="license_expiry_date"/>
                            <field name="license_status" widget="badge"/>
                            <field name="days_until_expiry" 
                                   invisible="license_status == 'valid' and days_until_expiry > 90"/>
                        </group>
                        
                        <group name="employment_info" string="Employment">
                            <field name="date_hired"/>
                            <field name="date_terminated" 
                                   invisible="employment_status == 'active'"/>
                        </group>
                    </group>
                    
                    <group>
                        <group name="performance_info" string="Performance &amp; Safety">
                            <field name="total_trips"/>
                            <field name="total_distance"/>
                        </group>
                        
                        <group name="company_info" string="Company">
                            <field name="company_id" options="{'no_create': True}" 
                                   groups="base.group_multi_company"/>
                        </group>
                    </group>
                    
                    <group name="address_info" string="Address">
                        <field name="address" placeholder="Full address..."/>
                    </group>
                    
                    <notebook>
                        <page name="assignments" string="Vehicle Assignments">
                            <field name="assignment_ids">
                                <list editable="bottom">
                                    <field name="vehicle_id"/>
                                    <field name="date_start"/>
                                    <field name="date_end"/>
                                    <field name="is_active" widget="boolean_toggle"/>
                                    <field name="odometer_start"/>
                                    <field name="odometer_end"/>
                                    <field name="distance_driven"/>
                                </list>
                            </field>
                        </page>
                        
                        <page name="notes" string="Notes">
                            <field name="notes" placeholder="Additional information about the driver..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    
    <!-- Driver Kanban View -->
    <record id="view_fleet_driver_kanban" model="ir.ui.view">
        <field name="name">fleet.driver.kanban</field>
        <field name="model">fleet.driver</field>
        <field name="arch" type="xml">
            <kanban string="Fleet Drivers" sample="1" class="o_kanban_mobile">
                <field name="id"/>
                <field name="name"/>
                <field name="code"/>
                <field name="license_number"/>
                <field name="license_status"/>
                <field name="current_vehicle_id"/>
                <field name="employment_status"/>
                <field name="phone"/>
                <field name="mobile"/>
                
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_image">
                                <field name="image" widget="image" options="{'size': [64, 64]}"/>
                            </div>
                            
                            <div class="oe_kanban_details">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                        <div class="o_kanban_record_subtitle" t-if="record.code.raw_value">
                                            <span><field name="code"/></span>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="o_kanban_record_body">
                                    <div t-if="record.license_number.raw_value">
                                        <i class="fa fa-id-card"/> <field name="license_number"/>
                                    </div>
                                    <div t-if="record.current_vehicle_id.raw_value">
                                        <i class="fa fa-car"/> <field name="current_vehicle_id"/>
                                    </div>
                                    <div t-if="record.phone.raw_value">
                                        <i class="fa fa-phone"/> <field name="phone"/>
                                    </div>
                                    <div>
                                        <span class="badge" t-att-class="
                                            record.license_status.raw_value === 'valid' ? 'text-bg-success' :
                                            record.license_status.raw_value === 'expiring_soon' ? 'text-bg-warning' :
                                            'text-bg-danger'
                                        ">
                                            <field name="license_status"/>
                                        </span>
                                    </div>
                                </div>
                                
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <span class="badge" t-att-class="
                                            record.employment_status.raw_value === 'active' ? 'text-bg-success' :
                                            'text-bg-secondary'
                                        ">
                                            <field name="employment_status"/>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    
    <!-- Driver Search View -->
    <record id="view_fleet_driver_search" model="ir.ui.view">
        <field name="name">fleet.driver.search</field>
        <field name="model">fleet.driver</field>
        <field name="arch" type="xml">
            <search string="Search Drivers">
                <field name="name" string="Driver" 
                       filter_domain="['|', '|', ('name', 'ilike', self), ('code', 'ilike', self), ('license_number', 'ilike', self)]"/>
                <field name="code"/>
                <field name="license_number"/>
                <field name="phone"/>
                <field name="mobile"/>
                
                <filter string="Active" name="filter_active" 
                        domain="[('active', '=', True)]"/>
                <filter string="Archived" name="filter_archived" 
                        domain="[('active', '=', False)]"/>
                
                <separator/>
                <filter string="Valid License" name="filter_valid_license" 
                        domain="[('license_status', '=', 'valid')]"/>
                <filter string="Expiring Soon" name="filter_expiring_soon" 
                        domain="[('license_status', '=', 'expiring_soon')]"/>
                <filter string="Expired License" name="filter_expired" 
                        domain="[('license_status', '=', 'expired')]"/>
                
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="License Type" name="group_license_type" 
                            context="{'group_by': 'license_type'}"/>
                    <filter string="License Status" name="group_license_status" 
                            context="{'group_by': 'license_status'}"/>
                    <filter string="Employment Status" name="group_employment_status" 
                            context="{'group_by': 'employment_status'}"/>
                    <filter string="Company" name="group_company" 
                            context="{'group_by': 'company_id'}" 
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>
    
    <!-- Driver Assignment List View -->
    <record id="view_fleet_driver_assignment_list" model="ir.ui.view">
        <field name="name">fleet.driver.assignment.list</field>
        <field name="model">fleet.driver.assignment</field>
        <field name="arch" type="xml">
            <list string="Driver Assignments">
                <field name="driver_id"/>
                <field name="vehicle_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="is_active" widget="boolean_toggle"/>
                <field name="odometer_start"/>
                <field name="odometer_end"/>
                <field name="distance_driven"/>
            </list>
        </field>
    </record>
    
    <!-- Driver Assignment Form View -->
    <record id="view_fleet_driver_assignment_form" model="ir.ui.view">
        <field name="name">fleet.driver.assignment.form</field>
        <field name="model">fleet.driver.assignment</field>
        <field name="arch" type="xml">
            <form string="Driver Assignment">
                <sheet>
                    <group>
                        <group>
                            <field name="driver_id"/>
                            <field name="vehicle_id"/>
                            <field name="is_active" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                    </group>
                    
                    <group>
                        <group string="Odometer Readings">
                            <field name="odometer_start"/>
                            <field name="odometer_end"/>
                            <field name="distance_driven"/>
                        </group>
                        <group string="Company">
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    
                    <group>
                        <field name="notes" placeholder="Notes about this assignment..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
</odoo>

