<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================================= -->
    <!-- Insurance Policy Actions                  -->
    <!-- ========================================= -->

    <record id="action_fleet_insurance" model="ir.actions.act_window">
        <field name="name">Insurance Policies</field>
        <field name="res_model">fleet.insurance</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active_policies': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new insurance policy
            </p>
            <p>
                Track vehicle insurance policies with premiums, providers and expiry reminders.
            </p>
        </field>
    </record>

    <!-- ========================================= -->
    <!-- Insurance Policy Views                    -->
    <!-- ========================================= -->

    <record id="view_fleet_insurance_list" model="ir.ui.view">
        <field name="name">fleet.insurance.list</field>
        <field name="model">fleet.insurance</field>
        <field name="arch" type="xml">
            <list string="Insurance Policies"
                  decoration-danger="is_expired"
                  decoration-warning="not is_expired and days_until_expiry &lt;= 30"
                  decoration-success="is_current">
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="policy_number"/>
                <field name="insurance_company"/>
                <field name="policy_type"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="days_until_expiry" optional="show"/>
                <field name="premium_amount" widget="monetary" sum="Total Premium"/>
                <field name="is_expired" column_invisible="1"/>
                <field name="is_current" column_invisible="1"/>
                <field name="company_id" column_invisible="1"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_fleet_insurance_form" model="ir.ui.view">
        <field name="name">fleet.insurance.form</field>
        <field name="model">fleet.insurance</field>
        <field name="arch" type="xml">
            <form string="Insurance Policy">
                <header>
                    <button name="action_renew_policy" string="Renew Policy" type="object"
                            class="btn-secondary"
                            invisible="not is_expired and days_until_expiry &gt; 30"/>
                    <field name="is_expired" column_invisible="1"/>
                    <field name="days_until_expiry" column_invisible="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group name="policy_info" string="Policy Information">
                            <field name="vehicle_id"/>
                            <field name="policy_number"/>
                            <field name="insurance_company"/>
                            <field name="policy_type"/>
                            <field name="agent_name"/>
                            <field name="agent_phone"/>
                            <field name="agent_email"/>
                        </group>
                        <group name="dates" string="Dates">
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="is_current"/>
                            <field name="is_expired"/>
                            <field name="days_until_expiry"/>
                        </group>
                    </group>
                    <group>
                        <group name="financial" string="Premium &amp; Coverage">
                            <field name="premium_amount" widget="monetary"/>
                            <field name="coverage_amount" widget="monetary"/>
                            <field name="deductible" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group name="documents" string="Documents">
                            <field name="policy_document" filename="policy_document_filename"/>
                            <field name="policy_document_filename" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1" placeholder="Additional notes about this policy..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_fleet_insurance_search" model="ir.ui.view">
        <field name="name">fleet.insurance.search</field>
        <field name="model">fleet.insurance</field>
        <field name="arch" type="xml">
            <search string="Search Insurance Policies">
                <field name="name" string="Reference"/>
                <field name="policy_number" string="Policy Number"/>
                <field name="insurance_company" string="Insurance Company"/>
                <field name="vehicle_id" string="Vehicle"/>

                <filter name="active_policies" string="Active" domain="[('active', '=', True)]"/>
                <filter name="expired_policies" string="Expired" domain="[('end_date', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="expiring_30" string="Expiring in 30 Days"
                        domain="[('end_date', '&gt;=', context_today().strftime('%Y-%m-%d')), ('end_date', '&lt;=', (context_today() + datetime.timedelta(days=30)).strftime('%Y-%m-%d'))]"/>

                <group expand="0" string="Group By">
                    <filter name="group_vehicle" string="Vehicle" context="{'group_by': 'vehicle_id'}"/>
                    <filter name="group_provider" string="Insurance Company" context="{'group_by': 'insurance_company'}"/>
                    <filter name="group_type" string="Policy Type" context="{'group_by': 'policy_type'}"/>
                    <filter name="group_end_date" string="End Date" context="{'group_by': 'end_date'}"/>
                </group>
            </search>
        </field>
    </record>

</odoo>
