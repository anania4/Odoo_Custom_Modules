<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Violation Actions -->
    <record id="action_fleet_driver_violation" model="ir.actions.act_window">
        <field name="name">Driver Violations</field>
        <field name="res_model">fleet.driver.violation</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a new violation record</p>
            <p>Track driver violations and traffic incidents.</p>
        </field>
    </record>
    
    <!-- Violation List View -->
    <record id="view_fleet_driver_violation_list" model="ir.ui.view">
        <field name="name">fleet.driver.violation.list</field>
        <field name="model">fleet.driver.violation</field>
        <field name="arch" type="xml">
            <list string="Driver Violations">
                <field name="name"/>
                <field name="date"/>
                <field name="driver_id"/>
                <field name="vehicle_id"/>
                <field name="violation_type"/>
                <field name="severity" widget="badge" decoration-info="severity == 'minor'" decoration-warning="severity == 'moderate'" decoration-danger="severity in ['major', 'critical']"/>
                <field name="fine_amount" widget="monetary" sum="Total Fines"/>
                <field name="points" sum="Total Points"/>
                <field name="status" widget="badge"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    
    <!-- Violation Form View -->
    <record id="view_fleet_driver_violation_form" model="ir.ui.view">
        <field name="name">fleet.driver.violation.form</field>
        <field name="model">fleet.driver.violation</field>
        <field name="arch" type="xml">
            <form string="Driver Violation">
                <header>
                    <button name="action_resolve" string="Resolve" type="object" invisible="status in ['resolved', 'dismissed']" class="btn-primary"/>
                    <button name="action_appeal" string="Appeal" type="object" invisible="status != 'pending'" class="btn-warning"/>
                    <button name="action_dismiss" string="Dismiss" type="object" invisible="status in ['resolved', 'dismissed']"/>
                    <field name="status" widget="statusbar" statusbar_visible="pending,resolved"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(base.action_attachment)d" type="action" class="oe_stat_button" icon="fa-files-o" context="{'default_res_model': 'fleet.driver.violation', 'default_res_id': id}">
                            <field name="attachment_count" widget="statinfo" string="Attachments"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group name="basic_info" string="Basic Information">
                            <field name="driver_id"/>
                            <field name="vehicle_id"/>
                            <field name="date"/>
                            <field name="location"/>
                        </group>
                        <group name="violation_details" string="Violation Details">
                            <field name="violation_type"/>
                            <field name="severity"/>
                            <field name="ticket_number"/>
                            <field name="issuing_authority"/>
                        </group>
                    </group>
                    <group>
                        <group name="financial" string="Financial">
                            <field name="fine_amount" widget="monetary"/>
                            <field name="points"/>
                            <field name="cost_record_id" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group name="resolution" string="Resolution" invisible="status == 'pending'">
                            <field name="resolution_date"/>
                        </group>
                    </group>
                    <group name="description" string="Description">
                        <field name="description" nolabel="1" placeholder="Detailed description of the violation..."/>
                    </group>
                    <group name="resolution_notes" string="Resolution Notes" invisible="status == 'pending'">
                        <field name="resolution_notes" nolabel="1" placeholder="Notes about violation resolution..."/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    
    <!-- Violation Search View -->
    <record id="view_fleet_driver_violation_search" model="ir.ui.view">
        <field name="name">fleet.driver.violation.search</field>
        <field name="model">fleet.driver.violation</field>
        <field name="arch" type="xml">
            <search string="Search Violations">
                <field name="name" string="Reference"/>
                <field name="driver_id" string="Driver"/>
                <field name="vehicle_id" string="Vehicle"/>
                <field name="ticket_number" string="Ticket Number"/>
                
                <filter name="pending" string="Pending" domain="[('status', '=', 'pending')]"/>
                <filter name="resolved" string="Resolved" domain="[('status', '=', 'resolved')]"/>
                <filter name="appealed" string="Under Appeal" domain="[('status', '=', 'appealed')]"/>
                
                <separator/>
                <filter name="minor" string="Minor" domain="[('severity', '=', 'minor')]"/>
                <filter name="moderate" string="Moderate" domain="[('severity', '=', 'moderate')]"/>
                <filter name="major" string="Major" domain="[('severity', '=', 'major')]"/>
                <filter name="critical" string="Critical" domain="[('severity', '=', 'critical')]"/>
                
                <group expand="0" string="Group By">
                    <filter name="group_driver" string="Driver" context="{'group_by': 'driver_id'}"/>
                    <filter name="group_type" string="Violation Type" context="{'group_by': 'violation_type'}"/>
                    <filter name="group_severity" string="Severity" context="{'group_by': 'severity'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>
    
</odoo>
