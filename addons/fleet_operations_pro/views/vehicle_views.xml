<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Vehicle Action (defined first to be referenced in views) -->
    <record id="action_fleet_vehicle" model="ir.actions.act_window">
        <field name="name">Vehicles</field>
        <field name="res_model">fleet.vehicle</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first vehicle
            </p>
            <p>
                Register your fleet vehicles here with all the necessary details
                like license plate, brand, model, and specifications.
            </p>
        </field>
    </record>
    
    <!-- Vehicle List View -->
    <record id="view_fleet_vehicle_list" model="ir.ui.view">
        <field name="name">fleet.vehicle.list</field>
        <field name="model">fleet.vehicle</field>
        <field name="arch" type="xml">
            <list string="Fleet Vehicles" sample="1">
                <field name="license_plate" decoration-bf="1"/>
                <field name="name"/>
                <field name="category_id"/>
                <field name="brand"/>
                <field name="model"/>
                <field name="status_id" widget="badge"/>
                <field name="state" widget="badge" 
                       decoration-success="state == 'available'"
                       decoration-warning="state in ['rented', 'in_maintenance']"
                       decoration-danger="state in ['out_of_service', 'sold', 'disposed']"/>
                <field name="fuel_type_id"/>
                <field name="odometer" widget="integer"/>
                <field name="fuel_percentage" widget="progressbar"/>
                <field name="acquisition_date"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    
    <!-- Vehicle Form View -->
    <record id="view_fleet_vehicle_form" model="ir.ui.view">
        <field name="name">fleet.vehicle.form</field>
        <field name="model">fleet.vehicle</field>
        <field name="arch" type="xml">
            <form string="Fleet Vehicle">
                <header>
                    <field name="state" widget="statusbar" 
                           statusbar_visible="available,rented,in_maintenance"/>
                    <button name="%(action_fleet_fuel_log_wizard_from_vehicle)d" 
                            string="Add Fuel" 
                            type="action" 
                            class="btn-primary"/>
                    <button name="action_update_odometer" 
                            string="Update Odometer" 
                            type="object" 
                            class="oe_highlight"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_fleet_fuel_log_vehicle)d" 
                                type="action" 
                                class="oe_stat_button" 
                                icon="fa-tint">
                            <field name="fuel_log_count" widget="statinfo" string="Fuel Logs"/>
                        </button>
                        <button name="%(action_fleet_driver_assignment)d" 
                                type="action" 
                                class="oe_stat_button" 
                                icon="fa-users"
                                context="{'default_vehicle_id': id}">
                            <field name="driver_assignment_ids" widget="statinfo" string="Driver History"/>
                        </button>
                        <button name="%(action_fleet_maintenance_vehicle)d" 
                                type="action" 
                                class="oe_stat_button" 
                                icon="fa-wrench"
                                context="{'default_vehicle_id': id}">
                            <field name="maintenance_count" widget="statinfo" string="Maintenance"/>
                        </button>
                        <button name="%(action_fleet_toll_record_vehicle)d" 
                                type="action" 
                                class="oe_stat_button" 
                                icon="fa-road">
                            <field name="toll_count" widget="statinfo" string="Tolls"/>
                        </button>
                    </div>
                    
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" 
                            invisible="active"/>
                    
                    <field name="active" invisible="1"/>
                    
                    <field name="image" widget="image" class="oe_avatar" options="{'size': [90, 90]}"/>
                    
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Company Vehicle 01"/>
                        </h1>
                        <label for="license_plate"/>
                        <h2>
                            <field name="license_plate" placeholder="e.g. ABC-1234"/>
                        </h2>
                    </div>
                    
                    <group>
                        <group name="vehicle_info" string="Vehicle Information">
                            <field name="category_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="status_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="current_driver_id" readonly="1"/>
                            <field name="brand"/>
                            <field name="model"/>
                            <field name="model_year"/>
                            <field name="color"/>
                            <field name="vin_sn"/>
                        </group>
                        
                        <group name="specifications" string="Specifications">
                            <field name="engine_type"/>
                            <field name="fuel_type_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="seats"/>
                            <field name="doors"/>
                        </group>
                    </group>
                    
                    <group>
                        <group name="fuel_info" string="Fuel Information">
                            <field name="fuel_tank_capacity"/>
                            <field name="current_fuel_level"/>
                            <field name="fuel_percentage" widget="percentpie"/>
                            <field name="average_fuel_efficiency"/>
                        </group>
                        
                        <group name="odometer_info" string="Odometer">
                            <field name="odometer"/>
                            <field name="odometer_date"/>
                        </group>
                    </group>
                    
                    <group>
                        <group name="acquisition_info" string="Acquisition">
                            <field name="acquisition_date"/>
                        </group>
                        
                        <group name="disposal_info" string="Disposal">
                            <field name="disposal_date"/>
                        </group>
                    </group>
                    
                    <group>
                        <group name="company_info" string="Company">
                            <field name="company_id" options="{'no_create': True}" 
                                   groups="base.group_multi_company"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page name="recent_maintenance" string="Recent Maintenance">
                            <field name="maintenance_ids" readonly="1">
                                <list limit="10">
                                    <field name="date"/>
                                    <field name="maintenance_type_id"/>
                                    <field name="description"/>
                                    <field name="odometer"/>
                                    <field name="service_provider"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        
                        <page name="fuel_logs" string="Fuel Logs">
                            <field name="fuel_log_ids">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="driver_id"/>
                                    <field name="quantity"/>
                                    <field name="price_per_unit" widget="monetary"/>
                                    <field name="total_cost" widget="monetary"/>
                                    <field name="odometer"/>
                                    <field name="fuel_efficiency"/>
                                    <field name="fuel_station"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        
                        <page name="notes" string="Notes">
                            <field name="notes" placeholder="Additional information about the vehicle..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    
    <!-- Vehicle Kanban View -->
    <record id="view_fleet_vehicle_kanban" model="ir.ui.view">
        <field name="name">fleet.vehicle.kanban</field>
        <field name="model">fleet.vehicle</field>
        <field name="arch" type="xml">
            <kanban string="Fleet Vehicles" sample="1" class="o_kanban_mobile"
                    default_group_by="status_id" on_create="quick_create"
                    records_draggable="true" group_create="true"
                    group_edit="true" group_delete="true">
                <field name="id"/>
                <field name="name"/>
                <field name="license_plate"/>
                <field name="category_id"/>
                <field name="brand"/>
                <field name="model"/>
                <field name="state"/>
                <field name="status_id"/>
                <field name="fuel_percentage"/>
                <field name="odometer"/>
                
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_image">
                                <field name="image" widget="image" options="{'size': [64, 64]}"/>
                            </div>
                            
                            <div class="oe_kanban_details">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                        <div class="o_kanban_record_subtitle">
                                            <span><field name="license_plate"/></span>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="o_kanban_record_body">
                                    <div>
                                        <field name="category_id"/>
                                    </div>
                                    <div>
                                        <t t-if="record.brand.raw_value">
                                            <field name="brand"/> <field name="model"/>
                                        </t>
                                    </div>
                                    <div>
                                        <span class="badge" t-att-class="
                                            record.state.raw_value === 'available' ? 'text-bg-success' :
                                            record.state.raw_value === 'rented' ? 'text-bg-warning' :
                                            record.state.raw_value === 'in_maintenance' ? 'text-bg-info' :
                                            'text-bg-secondary'
                                        ">
                                            <field name="state"/>
                                        </span>
                                    </div>
                                </div>
                                
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <span>
                                            <i class="fa fa-tachometer" title="Odometer"/> 
                                            <field name="odometer"/> km
                                        </span>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="fuel_percentage" widget="percentpie" 
                                               title="Fuel Level"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    
    <!-- Vehicle Search View -->
    <record id="view_fleet_vehicle_search" model="ir.ui.view">
        <field name="name">fleet.vehicle.search</field>
        <field name="model">fleet.vehicle</field>
        <field name="arch" type="xml">
            <search string="Search Vehicles">
                <field name="name" string="Vehicle" 
                       filter_domain="['|', '|', ('name', 'ilike', self), ('license_plate', 'ilike', self), ('vin_sn', 'ilike', self)]"/>
                <field name="license_plate"/>
                <field name="vin_sn"/>
                <field name="category_id"/>
                <field name="brand"/>
                <field name="model"/>
                <field name="status_id"/>
                
                <filter string="Available" name="filter_available" 
                        domain="[('state', '=', 'available')]"/>
                <filter string="Rented" name="filter_rented" 
                        domain="[('state', '=', 'rented')]"/>
                <filter string="In Maintenance" name="filter_maintenance" 
                        domain="[('state', '=', 'in_maintenance')]"/>
                <filter string="Out of Service" name="filter_out_of_service" 
                        domain="[('state', '=', 'out_of_service')]"/>
                
                <separator/>
                <filter string="Active" name="filter_active" 
                        domain="[('active', '=', True)]"/>
                <filter string="Archived" name="filter_archived" 
                        domain="[('active', '=', False)]"/>
                
                <separator/>
                <filter string="Low Fuel" name="filter_low_fuel" 
                        domain="[('fuel_percentage', '&lt;', 20)]"/>
                
                <group expand="0" string="Group By">
                    <filter string="Category" name="group_category" 
                            context="{'group_by': 'category_id'}"/>
                    <filter string="Status" name="group_status" 
                            context="{'group_by': 'status_id'}"/>
                    <filter string="State" name="group_state" 
                            context="{'group_by': 'state'}"/>
                    <filter string="Fuel Type" name="group_fuel_type" 
                            context="{'group_by': 'fuel_type_id'}"/>
                    <filter string="Company" name="group_company" 
                            context="{'group_by': 'company_id'}" 
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>
    
</odoo>

