<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vehicle Action (defined first to be referenced in views) -->
    <record id="action_fleet_vehicle" model="ir.actions.act_window">
        <field name="name">Vehicles</field>
        <field name="res_model">fleet.vehicle</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first vehicle
            </p>
            <p>
                Register your fleet vehicles here with all the necessary details
                like license plate, model, and specifications.
            </p>
        </field>
    </record>

    <!-- Vehicle List View -->
    <record id="view_fleet_vehicle_list" model="ir.ui.view">
        <field name="name">fleet.vehicle.list</field>
        <field name="model">fleet.vehicle</field>
        <field name="arch" type="xml">
            <list string="Fleet Vehicles" sample="1">
                <field name="license_plate" decoration-bf="1"/>
                <field name="name"/>
                <field name="category_id"/>
                <field name="model_id"/>
                <field name="driver_id" optional="show"/>
                <field name="ownership_type" optional="show"/>
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" optional="hide"/>
                <field name="status_code" column_invisible="1"/>
                <field name="status_id" widget="badge"
                       decoration-success="status_code == 'available'"
                       decoration-warning="status_code in ['rented', 'in_maintenance']"
                       decoration-danger="status_code in ['out_of_service', 'sold', 'disposed']"/>
                <field name="fuel_type_id"/>
                <field name="odometer" widget="integer"/>
                <field name="fuel_percentage" widget="progressbar" optional="hide"/>
                <field name="acquisition_date"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- Vehicle Form View -->
    <record id="view_fleet_vehicle_form" model="ir.ui.view">
        <field name="name">fleet.vehicle.form</field>
        <field name="model">fleet.vehicle</field>
        <field name="arch" type="xml">
            <form string="Fleet Vehicle">
                <header>
                    <field name="status_id" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_fleet_fuel_log_vehicle)d"
                                type="action"
                                class="oe_stat_button"
                                icon="fa-tint">
                            <field name="fuel_log_count" widget="statinfo" string="Fuel Logs"/>
                        </button>
                        <button name="%(action_fleet_driver_assignment)d"
                                type="action"
                                class="oe_stat_button"
                                icon="fa-users"
                                context="{'default_vehicle_id': id}">
                            <field name="driver_assignment_ids" widget="statinfo" string="Driver History"/>
                        </button>
                        <button name="%(action_fleet_maintenance_vehicle)d"
                                type="action"
                                class="oe_stat_button"
                                icon="fa-wrench"
                                context="{'default_vehicle_id': id}">
                            <field name="maintenance_count" widget="statinfo" string="Maintenance"/>
                        </button>
                        <button name="%(action_fleet_toll_record_vehicle)d"
                                type="action"
                                class="oe_stat_button"
                                icon="fa-road">
                            <field name="toll_count" widget="statinfo" string="Tolls"/>
                        </button>
                    </div>

                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <field name="active" invisible="1"/>
                    <field name="currency_id" invisible="1"/>

                    <field name="image" widget="image" class="oe_avatar" options="{'size': [90, 90]}"/>

                    <div class="oe_title">
                        <label for="license_plate"/>
                        <h1>
                            <field name="license_plate" placeholder="e.g. 3-A12345"/>
                        </h1>
                        <label for="name"/>
                        <h2>
                            <field name="name" placeholder="e.g. Company Vehicle 01"/>
                        </h2>
                    </div>

                    <group>
                        <group name="identification" string="Identification">
                            <label for="odometer"/>
                            <div class="o_row">
                                <field name="odometer"/>
                                <span>km</span>
                            </div>
                            <field name="previous_plate_no"/>
                            <field name="chassis_no"/>
                            <field name="engine_no"/>
                            <field name="model_id" options="{'no_create': True}"/>
                            <field name="model_year" options="{'format': false}"/>
                            <field name="color"/>
                        </group>

                        <group name="registration" string="Registration &amp; Service">
                            <field name="permitted_work_service"/>
                            <field name="body_type"/>
                            <field name="category_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="tag_ids" widget="many2many_tags"
                                   options="{'color_field': 'color', 'no_create': True}"/>
                        </group>
                    </group>

                    <group>
                        <group name="assignment" string="Assignment &amp; Acquisition">
                            <field name="driver_id" readonly="1"/>
                            <field name="manager_id" options="{'no_create': True}"/>
                            <field name="acquisition_date"/>
                            <field name="acquisition_cost" widget="monetary"/>
                            <field name="company_id" options="{'no_create': True}"
                                   groups="base.group_multi_company"/>
                        </group>

                        <group name="engine_fuel" string="Engine &amp; Fuel">
                            <field name="fuel_type_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="engine_capacity"/>
                            <field name="horsepower"/>
                            <field name="cylinders"/>
                        </group>
                    </group>

                    <group>
                        <group name="capacity" string="Capacity &amp; Weight">
                            <field name="seats"/>
                            <field name="doors"/>
                            <label for="axles_front" string="Axles (Front/Back)"/>
                            <div class="o_row">
                                <field name="axles_front" nolabel="1"/>
                                <span>/</span>
                                <field name="axles_back" nolabel="1"/>
                            </div>
                            <field name="general_weight_load"/>
                            <field name="single_weight_load"/>
                            <field name="extra_carry_weight"/>
                        </group>

                        <group name="ownership" string="Ownership">
                            <field name="ownership_type" widget="radio" options="{'horizontal': true}"/>
                            <field name="rental_vendor_id"/>
                            <field name="vendor_contact_phone" widget="phone"/>
                        </group>
                    </group>

                    <group name="rental_terms" string="Rental Terms"
                           invisible="ownership_type != 'rented'">
                        <group>
                            <field name="rental_start_date"/>
                            <field name="rental_end_date"/>
                            <field name="rental_contract_ref"/>
                        </group>
                        <group>
                            <field name="rental_cost" widget="monetary"/>
                            <field name="rental_frequency"/>
                        </group>
                    </group>

                    <notebook>
                        <page name="recent_maintenance" string="Recent Maintenance">
                            <field name="maintenance_ids" readonly="1">
                                <list limit="10">
                                    <field name="date"/>
                                    <field name="maintenance_type_id"/>
                                    <field name="description"/>
                                    <field name="odometer"/>
                                    <field name="service_provider"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>

                        <page name="fuel_logs" string="Fuel Logs">
                            <field name="fuel_log_ids" readonly="1">
                                <list>
                                    <field name="date"/>
                                    <field name="driver_id"/>
                                    <field name="quantity"/>
                                    <field name="price_per_unit" widget="monetary"/>
                                    <field name="total_cost" widget="monetary"/>
                                    <field name="odometer"/>
                                    <field name="fuel_efficiency"/>
                                    <field name="fuel_station"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>

                        <page name="notes" string="Notes">
                            <field name="notes" placeholder="Additional information about the vehicle..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Vehicle Kanban View -->
    <record id="view_fleet_vehicle_kanban" model="ir.ui.view">
        <field name="name">fleet.vehicle.kanban</field>
        <field name="model">fleet.vehicle</field>
        <field name="arch" type="xml">
            <kanban string="Fleet Vehicles" sample="1" class="o_kanban_mobile"
                    default_group_by="status_id" on_create="quick_create"
                    records_draggable="true" group_create="true"
                    group_edit="true" group_delete="true">
                <field name="id"/>
                <field name="name"/>
                <field name="license_plate"/>
                <field name="category_id"/>
                <field name="model_id"/>
                <field name="status_id"/>
                <field name="odometer"/>

                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_image">
                                <field name="image" widget="image" options="{'size': [64, 64]}"/>
                            </div>

                            <div class="oe_kanban_details">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="license_plate"/>
                                        </strong>
                                        <div class="o_kanban_record_subtitle">
                                            <span><field name="name"/></span>
                                        </div>
                                    </div>
                                </div>

                                <div class="o_kanban_record_body">
                                    <div>
                                        <field name="category_id"/>
                                    </div>
                                    <div t-if="record.model_id.raw_value">
                                        <field name="model_id"/>
                                    </div>
                                    <div>
                                        <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                                    </div>
                                </div>

                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <span>
                                            <i class="fa fa-tachometer" title="Odometer"/>
                                            <field name="odometer"/> km
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Vehicle Search View -->
    <record id="view_fleet_vehicle_search" model="ir.ui.view">
        <field name="name">fleet.vehicle.search</field>
        <field name="model">fleet.vehicle</field>
        <field name="arch" type="xml">
            <search string="Search Vehicles">
                <field name="license_plate" string="Plate No"
                       filter_domain="['|', '|', '|', ('license_plate', 'ilike', self), ('previous_plate_no', 'ilike', self), ('name', 'ilike', self), ('chassis_no', 'ilike', self)]"/>
                <field name="name"/>
                <field name="chassis_no"/>
                <field name="category_id"/>
                <field name="model_id"/>
                <field name="tag_ids"/>
                <field name="driver_id"/>
                <field name="rental_vendor_id"/>
                <field name="status_id"/>

                <filter string="Available" name="filter_available"
                        domain="[('status_code', '=', 'available')]"/>
                <filter string="Rented" name="filter_rented"
                        domain="[('status_code', '=', 'rented')]"/>
                <filter string="In Maintenance" name="filter_maintenance"
                        domain="[('status_code', '=', 'in_maintenance')]"/>
                <filter string="Out of Service" name="filter_out_of_service"
                        domain="[('status_code', '=', 'out_of_service')]"/>
                <filter string="Sold / Disposed" name="filter_sold_disposed"
                        domain="[('status_code', 'in', ('sold', 'disposed'))]"/>

                <separator/>
                <filter string="With Driver" name="filter_with_driver"
                        domain="[('driver_id', '!=', False)]"/>
                <filter string="Without Driver" name="filter_without_driver"
                        domain="[('driver_id', '=', False)]"/>

                <separator/>
                <filter string="Owned" name="filter_owned"
                        domain="[('ownership_type', '=', 'owned')]"/>
                <filter string="Rented from Vendor" name="filter_rented_in"
                        domain="[('ownership_type', '=', 'rented')]"/>
                <filter string="Rental Ending in 30 Days" name="filter_rental_ending"
                        domain="[('ownership_type', '=', 'rented'), ('rental_end_date', '&gt;=', context_today().strftime('%Y-%m-%d')), ('rental_end_date', '&lt;=', (context_today() + datetime.timedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <filter string="Rental Ended" name="filter_rental_ended"
                        domain="[('ownership_type', '=', 'rented'), ('rental_end_date', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>

                <separator/>
                <filter string="Acquisition Date" name="filter_acquisition_date" date="acquisition_date"/>

                <separator/>
                <filter string="Archived" name="filter_archived"
                        domain="[('active', '=', False)]"/>

                <group expand="0" string="Group By">
                    <filter string="Category" name="group_category"
                            context="{'group_by': 'category_id'}"/>
                    <filter string="Model" name="group_model"
                            context="{'group_by': 'model_id'}"/>
                    <filter string="Ownership Type" name="group_ownership"
                            context="{'group_by': 'ownership_type'}"/>
                    <filter string="Status" name="group_status"
                            context="{'group_by': 'status_id'}"/>
                    <filter string="Fuel Type" name="group_fuel_type"
                            context="{'group_by': 'fuel_type_id'}"/>
                    <filter string="Company" name="group_company"
                            context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

</odoo>
