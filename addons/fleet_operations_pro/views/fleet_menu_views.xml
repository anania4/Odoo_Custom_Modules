<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Root Menu -->
    <menuitem id="menu_fleet_root"
              name="Fleet"
              web_icon="fleet_operations_pro,static/description/icon.png"
              groups="group_fleet_driver"
              sequence="50"/>
    
    <!-- Operations Menu -->
    <menuitem id="menu_fleet_operations"
              name="Operations"
              parent="menu_fleet_root"
              sequence="10"/>
    
    <!-- Dashboard Menu Item -->
    <menuitem id="menu_fleet_dashboard"
              name="Dashboard"
              parent="menu_fleet_root"
              action="action_client_fleet_dashboard"
              sequence="1"
              groups="group_fleet_viewer"/>
    
    <!-- Vehicles Menu Item -->
    <menuitem id="menu_fleet_vehicle"
              name="Vehicles"
              parent="menu_fleet_operations"
              action="action_fleet_vehicle"
              sequence="10"
              groups="group_fleet_viewer"/>
    
    <!-- Drivers Menu Item (Fleet Driver group and above) -->
    <menuitem id="menu_fleet_driver"
              name="Drivers"
              parent="menu_fleet_operations"
              action="action_fleet_driver"
              groups="group_fleet_driver"
              sequence="20"/>

    <!-- Driver Assignments Menu Item -->
    <!-- Driver Assignments managed from Vehicle page -->
    
    <!-- Fuel Logs Menu Item -->
    <menuitem id="menu_fleet_fuel_log"
              name="Fuel Logs"
              parent="menu_fleet_operations"
              action="action_fleet_fuel_log"
              sequence="40"
              groups="group_fleet_viewer"/>
    
    <!-- Configuration Menu -->
    <menuitem id="menu_fleet_configuration"
              name="Configuration"
              parent="menu_fleet_root"
              groups="group_fleet_manager"
              sequence="100"/>
    
    <!-- Configuration Sub-menus -->
    <menuitem id="menu_fleet_config_settings"
              name="Settings"
              parent="menu_fleet_configuration"
              sequence="10"/>
    
    <!-- Vehicle Categories -->
    <record id="action_fleet_vehicle_category" model="ir.actions.act_window">
        <field name="name">Vehicle Categories</field>
        <field name="res_model">fleet.vehicle.category</field>
        <field name="view_mode">list,form</field>
    </record>
    
    <menuitem id="menu_fleet_vehicle_category"
              name="Vehicle Categories"
              parent="menu_fleet_config_settings"
              action="action_fleet_vehicle_category"
              sequence="10"/>
    
    <!-- Vehicle Statuses -->
    <record id="action_fleet_vehicle_status" model="ir.actions.act_window">
        <field name="name">Vehicle Statuses</field>
        <field name="res_model">fleet.vehicle.status</field>
        <field name="view_mode">list,form</field>
    </record>
    
    <menuitem id="menu_fleet_vehicle_status"
              name="Vehicle Statuses"
              parent="menu_fleet_config_settings"
              action="action_fleet_vehicle_status"
              sequence="20"/>
    
    <!-- Fuel Types -->
    <record id="action_fleet_fuel_type" model="ir.actions.act_window">
        <field name="name">Fuel Types</field>
        <field name="res_model">fleet.fuel.type</field>
        <field name="view_mode">list,form</field>
    </record>
    
    <menuitem id="menu_fleet_fuel_type"
              name="Fuel Types"
              parent="menu_fleet_config_settings"
              action="action_fleet_fuel_type"
              sequence="30"/>
    
    <!-- Maintenance Types - removed -->
    
    <!-- Vehicle Agreements Menu Item -->
    <menuitem id="menu_fleet_contract"
              name="Vehicle Agreements"
              parent="menu_fleet_operations"
              action="action_fleet_contract"
              sequence="60"
              groups="group_fleet_viewer"/>
    
    <!-- Services Menu Item -->
    <menuitem id="menu_fleet_service"
              name="Services"
              parent="menu_fleet_operations"
              action="action_fleet_service"
              sequence="65"
              groups="group_fleet_viewer"/>
    
    <!-- Toll Records Menu Item -->
    <menuitem id="menu_fleet_toll_record"
              name="Toll Records"
              parent="menu_fleet_operations"
              action="action_fleet_toll_record"
              sequence="90"
              groups="group_fleet_viewer"/>
    
</odoo>
