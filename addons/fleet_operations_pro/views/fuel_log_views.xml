<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Fuel Log Actions (defined first to be referenced in views) -->
    <record id="action_fleet_fuel_log" model="ir.actions.act_window">
        <field name="name">Fuel Logs</field>
        <field name="res_model">fleet.fuel.log</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_filter_date': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first fuel log entry
            </p>
            <p>
                Track fuel consumption for your vehicles. Record fuel quantity,
                cost, and monitor fuel efficiency.
            </p>
        </field>
    </record>
    
    <record id="action_fleet_fuel_log_vehicle" model="ir.actions.act_window">
        <field name="name">Fuel Logs</field>
        <field name="res_model">fleet.fuel.log</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_vehicle_id': active_id, 'search_default_vehicle_id': active_id}</field>
    </record>
    
    <!-- Fuel Log List View -->
    <record id="view_fleet_fuel_log_list" model="ir.ui.view">
        <field name="name">fleet.fuel.log.list</field>
        <field name="model">fleet.fuel.log</field>
        <field name="arch" type="xml">
            <list string="Fuel Logs" sample="1">
                <field name="date"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <field name="quantity" sum="Total Quantity"/>
                <field name="total_cost" sum="Total Cost" widget="monetary"/>
                <field name="price_per_unit" widget="monetary"/>
                <field name="odometer"/>
                <field name="odometer_difference"/>
                <field name="fuel_efficiency"/>
                <field name="fuel_station"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    
    <!-- Fuel Log Form View -->
    <record id="view_fleet_fuel_log_form" model="ir.ui.view">
        <field name="name">fleet.fuel.log.form</field>
        <field name="model">fleet.fuel.log</field>
        <field name="arch" type="xml">
            <form string="Fuel Log">
                <sheet>
                    <group>
                        <group name="basic_info" string="Basic Information">
                            <field name="vehicle_id" options="{'no_create': True}"/>
                            <field name="driver_id"/>
                            <field name="date"/>
                            <field name="odometer"/>
                        </group>
                        
                        <group name="fuel_info" string="Fuel Information">
                            <field name="fuel_type_id"/>
                            <field name="quantity"/>
                            <field name="price_per_unit" widget="monetary"/>
                            <field name="total_cost" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    
                    <group>
                        <group name="station_info" string="Fuel Station">
                            <field name="fuel_station"/>
                            <field name="fuel_station_location"/>
                            <field name="invoice_reference"/>
                        </group>
                        
                        <group name="efficiency_info" string="Fuel Efficiency">
                            <field name="odometer_difference"/>
                            <field name="fuel_efficiency"/>
                        </group>
                    </group>
                    
                    <group>
                        <field name="notes" placeholder="Additional notes about this fuel entry..."/>
                    </group>
                    
                    <group>
                        <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                    </group>
                </sheet>
                
                <!-- Chatter -->
                <chatter/>
            </form>
        </field>
    </record>
    
    <!-- Fuel Log Kanban View -->
    <record id="view_fleet_fuel_log_kanban" model="ir.ui.view">
        <field name="name">fleet.fuel.log.kanban</field>
        <field name="model">fleet.fuel.log</field>
        <field name="arch" type="xml">
            <kanban string="Fuel Logs" sample="1" class="o_kanban_mobile">
                <field name="id"/>
                            <field name="vehicle_id"/>
                            <field name="driver_id"/>
                            <field name="date"/>
                            <field name="odometer"/>
                
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="vehicle_id"/>
                                    </strong>
                                    <div class="o_kanban_record_subtitle">
                                        <span><field name="date"/></span>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="o_kanban_record_body">
                                <div>
                                    <i class="fa fa-tint"/> <field name="quantity"/> L
                                </div>
                                <div>
                                    <i class="fa fa-money"/> <field name="total_cost" widget="monetary"/>
                                </div>
                                <div>
                                    <i class="fa fa-tachometer"/> <field name="odometer"/> km
                                </div>
                                <div t-if="record.fuel_efficiency.raw_value &gt; 0">
                                    <i class="fa fa-line-chart"/> 
                                    <field name="fuel_efficiency"/> km/L
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    
    <!-- Fuel Log Search View -->
    <record id="view_fleet_fuel_log_search" model="ir.ui.view">
        <field name="name">fleet.fuel.log.search</field>
        <field name="model">fleet.fuel.log</field>
        <field name="arch" type="xml">
            <search string="Search Fuel Logs">
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <field name="fuel_station"/>
                <field name="date"/>
                
                <filter string="Today" name="filter_today" 
                        domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Last 7 Days" name="filter_last_7_days"
                        domain="[('date', '&gt;=', (context_today() - datetime.timedelta(days=6)).strftime('%Y-%m-%d')), ('date', '&lt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Date" name="filter_date" date="date"/>
                
                <separator/>
                <filter string="High Efficiency" name="filter_high_efficiency" 
                        domain="[('fuel_efficiency', '&gt;=', 15)]"/>
                <filter string="Low Efficiency" name="filter_low_efficiency" 
                        domain="[('fuel_efficiency', '&lt;', 10), ('fuel_efficiency', '&gt;', 0)]"/>
                
                <group expand="0" string="Group By">
                    <filter string="Vehicle" name="group_vehicle" 
                            context="{'group_by': 'vehicle_id'}"/>
                    <filter string="Driver" name="group_driver" 
                            context="{'group_by': 'driver_id'}"/>
                    <filter string="Date" name="group_date" 
                            context="{'group_by': 'date:month'}"/>
                    <filter string="Fuel Station" name="group_fuel_station" 
                            context="{'group_by': 'fuel_station'}"/>
                    <filter string="Company" name="group_company" 
                            context="{'group_by': 'company_id'}" 
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>
    
</odoo>

