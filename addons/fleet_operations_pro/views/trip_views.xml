<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- ========================================= -->
    <!-- Trip Actions (Define First)               -->
    <!-- ========================================= -->
    
    <!-- Main Trip Action -->
    <record id="action_fleet_trip" model="ir.actions.act_window">
        <field name="name">Trips</field>
        <field name="res_model">fleet.trip</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_this_month': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new trip
            </p>
            <p>
                Track vehicle trips with departure, destination, and distance.
            </p>
        </field>
    </record>
    
    <!-- Action for Trips from Vehicle -->
    <record id="action_fleet_trip_vehicle" model="ir.actions.act_window">
        <field name="name">Trips</field>
        <field name="res_model">fleet.trip</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('vehicle_id', '=', active_id)]</field>
        <field name="context">{'default_vehicle_id': active_id}</field>
    </record>
    
    <!-- ========================================= -->
    <!-- Trip Views                                -->
    <!-- ========================================= -->
    
    <!-- Trip List View -->
    <record id="view_fleet_trip_list" model="ir.ui.view">
        <field name="name">fleet.trip.list</field>
        <field name="model">fleet.trip</field>
        <field name="arch" type="xml">
            <list string="Trips">
                <field name="date"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <field name="departure_location"/>
                <field name="destination"/>
                <field name="distance" sum="Total Distance"/>
                <field name="duration_hours" sum="Total Hours"/>
                <field name="average_speed" optional="hide"/>
                <field name="purpose"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    
    <!-- Trip Form View -->
    <record id="view_fleet_trip_form" model="ir.ui.view">
        <field name="name">fleet.trip.form</field>
        <field name="model">fleet.trip</field>
        <field name="arch" type="xml">
            <form string="Trip">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(base.action_attachment)d" type="action"
                                class="oe_stat_button" icon="fa-files-o"
                                context="{'default_res_model': 'fleet.trip', 'default_res_id': id}">
                            <field name="attachment_count" widget="statinfo" string="Attachments"/>
                        </button>
                    </div>
                    
                    <div class="oe_title">
                        <label for="departure_location" string="Trip Route"/>
                        <h1>
                            <field name="departure_location" placeholder="Starting location..." class="oe_inline"/> 
                            <span class="fa fa-arrow-right oe_inline" style="margin: 0 10px;"/> 
                            <field name="destination" placeholder="Destination..." class="oe_inline"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group name="basic_info" string="Basic Information">
                            <field name="vehicle_id" required="1" options="{'no_create': True}"/>
                            <field name="driver_id" options="{'no_create': True}"/>
                            <field name="date" required="1"/>
                        </group>
                        
                        <group name="timing" string="Time &amp; Duration">
                            <field name="start_time"/>
                            <field name="end_time"/>
                            <field name="duration_hours" readonly="1" widget="float_time"/>
                        </group>
                    </group>
                    
                    <group>
                        <group name="purpose_info" string="Purpose">
                            <field name="purpose" required="1"/>
                            <field name="purpose_description" placeholder="Detailed purpose of the trip..."/>
                        </group>
                        
                        <group name="distance_info" string="Distance &amp; Speed">
                            <field name="start_odometer" widget="integer"/>
                            <field name="end_odometer" widget="integer"/>
                            <field name="distance" readonly="1" widget="float" string="Distance (km)"/>
                            <field name="average_speed" readonly="1" widget="float" string="Avg Speed (km/h)"/>
                        </group>
                    </group>
                    
                    <group name="route_details" string="Route Details">
                        <field name="waypoints" placeholder="Intermediate stops, route notes, or special instructions..." nolabel="1"/>
                    </group>
                    
                    <notebook>
                        <page name="notes" string="Notes">
                            <field name="notes" placeholder="Additional trip notes, observations, or comments..." nolabel="1"/>
                        </page>
                        
                        <page name="attachments" string="Documents">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                    </notebook>
                </sheet>
                
                <!-- Chatter -->
                <chatter/>
            </form>
        </field>
    </record>
    
    <!-- Trip Search View -->
    <record id="view_fleet_trip_search" model="ir.ui.view">
        <field name="name">fleet.trip.search</field>
        <field name="model">fleet.trip</field>
        <field name="arch" type="xml">
            <search string="Search Trips">
                <field name="vehicle_id" string="Vehicle"/>
                <field name="driver_id" string="Driver"/>
                <field name="departure_location" string="Departure"/>
                <field name="destination" string="Destination"/>
                
                <filter name="filter_business" string="Business" domain="[('purpose', '=', 'business')]"/>
                <filter name="filter_personal" string="Personal" domain="[('purpose', '=', 'personal')]"/>
                <filter name="filter_delivery" string="Delivery" domain="[('purpose', '=', 'delivery')]"/>
                <filter name="filter_rental" string="Rental" domain="[('purpose', '=', 'rental')]"/>
                
                <separator/>
                <filter name="this_month" string="This Month" 
                        domain="[('date', '&gt;=', context_today().strftime('%Y-%m-01')), ('date', '&lt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="last_month" string="Last Month" 
                        domain="[('date', '&gt;=', (context_today() - datetime.timedelta(days=30)).strftime('%Y-%m-01')), ('date', '&lt;', context_today().strftime('%Y-%m-01'))]"/>
                <filter name="this_year" string="This Year" 
                        domain="[('date', '&gt;=', context_today().strftime('%Y-01-01')), ('date', '&lt;=', context_today().strftime('%Y-12-31'))]"/>
                
                <separator/>
                <filter invisible="1" string="Late Activities" name="activities_overdue" 
                        domain="[('my_activity_date_deadline', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter invisible="1" string="Today Activities" name="activities_today" 
                        domain="[('my_activity_date_deadline', '=', context_today().strftime('%Y-%m-%d'))]"/>
                
                <group expand="0" string="Group By">
                    <filter name="group_vehicle" string="Vehicle" context="{'group_by': 'vehicle_id'}"/>
                    <filter name="group_driver" string="Driver" context="{'group_by': 'driver_id'}"/>
                    <filter name="group_purpose" string="Purpose" context="{'group_by': 'purpose'}"/>
                    <filter name="group_date" string="Date" context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>
    
</odoo>

