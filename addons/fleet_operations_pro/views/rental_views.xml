<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- ========================================= -->
    <!-- Rental Contract Actions (Define First)   -->
    <!-- ========================================= -->
    
    <!-- Main Rental Contract Action -->
    <record id="action_fleet_rental_contract" model="ir.actions.act_window">
        <field name="name">Rental Contracts</field>
        <field name="res_model">fleet.rental.contract</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_active_contracts': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new rental contract
            </p>
            <p>
                Manage vehicle rental contracts with customer details, pricing, deposits, and contract tracking.
            </p>
        </field>
    </record>
    
    <!-- Action for Vehicles in Rental Contract -->
    <record id="action_fleet_rental_contract_vehicles" model="ir.actions.act_window">
        <field name="name">Vehicles</field>
        <field name="res_model">fleet.vehicle</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('id', 'in', vehicle_ids)]</field>
        <field name="context">{'search_default_group_status': 1}</field>
    </record>
    
    <!-- ========================================= -->
    <!-- Rental Contract Views                     -->
    <!-- ========================================= -->
    
    <!-- Rental Contract Form View -->
    <record id="view_fleet_rental_contract_form" model="ir.ui.view">
        <field name="name">fleet.rental.contract.form</field>
        <field name="model">fleet.rental.contract</field>
        <field name="arch" type="xml">
            <form string="Rental Contract">
                <header>
                    <button name="%(action_fleet_fuel_log_wizard_from_rental)d" 
                            string="Add Fuel" 
                            type="action" 
                            class="btn-primary"
                            invisible="state not in ['confirmed', 'active'] or vehicle_count == 0"/>
                    <button name="action_confirm" string="Confirm" type="object" 
                            invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_start_rental" string="Start Rental" type="object" 
                            invisible="state != 'confirmed'" class="oe_highlight"/>
                    <button name="action_complete_rental" string="Complete" type="object" 
                            invisible="state != 'active'" class="oe_highlight"/>
                    <button name="action_return_deposit" string="Return Deposit" type="object" 
                            invisible="state != 'completed' or deposit_returned == True"/>
                    <button name="action_cancel" string="Cancel" type="object" 
                            invisible="state not in ['draft', 'confirmed']"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,active,completed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_fleet_rental_contract_vehicles)d" type="action"
                                class="oe_stat_button" icon="fa-car">
                            <field name="vehicle_count" widget="statbutton" string="Vehicles"/>
                        </button>
                        <button name="%(action_fleet_fuel_log)d" type="action"
                                class="oe_stat_button" icon="fa-tint">
                            <field name="fuel_log_count" widget="statbutton" string="Fuel Logs"/>
                        </button>
                        <button name="%(action_fleet_toll_record)d" type="action"
                                class="oe_stat_button" icon="fa-road">
                            <field name="toll_count" widget="statbutton" string="Tolls"/>
                        </button>
                        <button name="%(action_fleet_trip)d" type="action"
                                class="oe_stat_button" icon="fa-map-marker">
                            <field name="trip_count" widget="statbutton" string="Trips"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group name="customer_info" string="Customer Information">
                            <field name="customer_id" widget="many2one_avatar_user"/>
                            <field name="customer_phone" widget="phone"/>
                            <field name="customer_email" widget="email"/>
                            <field name="driver_id"/>
                        </group>
                        <group name="dates" string="Dates &amp; Duration">
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="duration_days" string="Duration"/>
                            <field name="actual_return_date" invisible="state not in ['completed', 'cancelled']"/>
                        </group>
                    </group>
                    
                    <group>
                        <group name="vehicles" string="Vehicles">
                            <field name="vehicle_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                            <field name="vehicle_count" invisible="1"/>
                        </group>
                        <group name="locations" string="Locations">
                            <field name="pickup_location"/>
                            <field name="return_location"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page name="pricing" string="Pricing &amp; Deposit">
                            <group>
                                <group name="pricing" string="Rental Pricing">
                                    <field name="rental_rate_type"/>
                                    <field name="rental_rate" widget="monetary"/>
                                    <field name="total_rental_amount" widget="monetary"/>
                                    <field name="currency_id" invisible="1"/>
                                    <field name="company_id" invisible="1"/>
                                </group>
                                <group name="deposit" string="Deposit">
                                    <field name="deposit_amount" widget="monetary"/>
                                    <field name="deposit_returned"/>
                                    <field name="deposit_return_date" invisible="deposit_returned == False"/>
                                    <field name="deposit_return_amount" widget="monetary" invisible="deposit_returned == False"/>
                                </group>
                            </group>
                        </page>
                        
                        <page name="odometer" string="Odometer &amp; Distance">
                            <group>
                                <group name="odometer" string="Odometer Readings">
                                    <field name="initial_odometer"/>
                                    <field name="final_odometer"/>
                                    <field name="distance_traveled"/>
                                </group>
                            </group>
                        </page>
                        
                        <page name="fuel_management" string="Fuel Management">
                            <group>
                                <group name="fuel_policy" string="Fuel Policy">
                                    <field name="fuel_recharge_policy"/>
                                    <field name="initial_fuel_level"/>
                                    <field name="initial_fuel_percentage" widget="progressbar"/>
                                    <field name="final_fuel_level" invisible="state not in ['completed', 'cancelled']"/>
                                    <field name="final_fuel_percentage" widget="progressbar" invisible="state not in ['completed', 'cancelled']"/>
                                </group>
                                <group name="fuel_consumption" string="Fuel Consumption &amp; Cost">
                                    <field name="fuel_consumed"/>
                                    <field name="fuel_cost_to_charge" widget="monetary" invisible="state not in ['completed', 'cancelled']"/>
                                    <field name="currency_id" invisible="1"/>
                                </group>
                            </group>
                            <group string="Fuel Logs">
                                <field name="fuel_log_ids" nolabel="1">
                                    <list string="Fuel Logs">
                                        <field name="date"/>
                                        <field name="driver_id"/>
                                        <field name="quantity"/>
                                        <field name="total_cost" widget="monetary"/>
                                        <field name="odometer"/>
                                        <field name="fuel_station"/>
                                    </list>
                                </field>
                            </group>
                        </page>
                        
                        <page name="toll_management" string="Toll Management">
                            <group>
                                <group name="toll_summary" string="Toll Summary">
                                    <field name="toll_count"/>
                                    <field name="total_toll_cost" widget="monetary"/>
                                    <field name="currency_id" invisible="1"/>
                                </group>
                            </group>
                            <group string="Toll Records">
                                <field name="toll_record_ids" nolabel="1">
                                    <list string="Toll Records">
                                        <field name="date"/>
                                        <field name="toll_location_id"/>
                                        <field name="driver_id"/>
                                        <field name="amount" widget="monetary" sum="Total"/>
                                        <field name="odometer"/>
                                    </list>
                                </field>
                            </group>
                        </page>
                        
                        <page name="trip_management" string="Trip Management">
                            <group>
                                <group name="trip_summary" string="Trip Summary">
                                    <field name="trip_count"/>
                                    <field name="total_trip_distance"/>
                                </group>
                            </group>
                            <group string="Trips">
                                <field name="trip_ids" nolabel="1">
                                    <list string="Trips">
                                        <field name="date"/>
                                        <field name="driver_id"/>
                                        <field name="departure_location"/>
                                        <field name="destination"/>
                                        <field name="distance" sum="Total Distance"/>
                                        <field name="purpose"/>
                                    </list>
                                </field>
                            </group>
                        </page>
                        
                        <page name="terms" string="Terms &amp; Notes">
                            <group>
                                <field name="terms_conditions" placeholder="Enter rental terms and conditions..."/>
                                <field name="notes" placeholder="Additional notes or special instructions..."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    
    <!-- Rental Contract List View -->
    <record id="view_fleet_rental_contract_list" model="ir.ui.view">
        <field name="name">fleet.rental.contract.list</field>
        <field name="model">fleet.rental.contract</field>
        <field name="arch" type="xml">
            <list string="Rental Contracts" decoration-info="state == 'draft'" 
                  decoration-success="state == 'active'" decoration-muted="state in ['completed', 'cancelled']">
                <field name="name"/>
                <field name="customer_id"/>
                <field name="vehicle_ids" widget="many2many_tags"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="duration_days"/>
                <field name="rental_rate" widget="monetary"/>
                <field name="total_rental_amount" widget="monetary" sum="Total"/>
                <field name="state" widget="badge" 
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'confirmed'"
                       decoration-success="state == 'active'"
                       decoration-muted="state in ['completed', 'cancelled']"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="company_id" column_invisible="1"/>
            </list>
        </field>
    </record>
    
    <!-- Rental Contract Kanban View -->
    <record id="view_fleet_rental_contract_kanban" model="ir.ui.view">
        <field name="name">fleet.rental.contract.kanban</field>
        <field name="model">fleet.rental.contract</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="state">
                <field name="name"/>
                <field name="customer_id"/>
                <field name="vehicle_ids"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="total_rental_amount"/>
                <field name="state"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_content">
                            <div class="row">
                                <div class="col-12">
                                    <strong><field name="name"/></strong>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-12">
                                    <span><i class="fa fa-user"/> <field name="customer_id"/></span>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-12">
                                    <span><i class="fa fa-calendar"/> <field name="start_date"/> - <field name="end_date"/></span>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-12">
                                    <field name="vehicle_ids" widget="many2many_tags"/>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-12">
                                    <strong><field name="total_rental_amount" widget="monetary"/></strong>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-12">
                                    <field name="state" widget="badge"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    
    <!-- Rental Contract Search View -->
    <record id="view_fleet_rental_contract_search" model="ir.ui.view">
        <field name="name">fleet.rental.contract.search</field>
        <field name="model">fleet.rental.contract</field>
        <field name="arch" type="xml">
            <search string="Search Rental Contracts">
                <field name="name" string="Contract Number"/>
                <field name="customer_id" string="Customer"/>
                <field name="vehicle_ids" string="Vehicles"/>
                <field name="driver_id" string="Driver"/>
                
                <filter name="active_contracts" string="Active" domain="[('state', '=', 'active')]"/>
                <filter name="draft_contracts" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="confirmed_contracts" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter name="completed_contracts" string="Completed" domain="[('state', '=', 'completed')]"/>
                
                <separator/>
                <filter name="deposit_not_returned" string="Deposit Not Returned" 
                        domain="[('state', '=', 'completed'), ('deposit_returned', '=', False)]"/>
                <filter name="overdue_returns" string="Overdue Returns" 
                        domain="[('state', '=', 'active'), ('end_date', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                
                <separator/>
                <filter name="this_month" string="This Month" 
                        domain="[('start_date', '&gt;=', context_today().strftime('%Y-%m-01')), ('start_date', '&lt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="last_month" string="Last Month" 
                        domain="[('start_date', '&gt;=', (context_today() - datetime.timedelta(days=30)).strftime('%Y-%m-01')), ('start_date', '&lt;', context_today().strftime('%Y-%m-01'))]"/>
                
                <separator/>
                <filter invisible="1" string="Late Activities" name="activities_overdue" 
                        domain="[('my_activity_date_deadline', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter invisible="1" string="Today Activities" name="activities_today" 
                        domain="[('my_activity_date_deadline', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter invisible="1" string="Upcoming Activities" name="activities_upcoming" 
                        domain="[('my_activity_date_deadline', '&gt;', context_today().strftime('%Y-%m-%d'))]"/>
                
                <group expand="0" string="Group By">
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_customer" string="Customer" context="{'group_by': 'customer_id'}"/>
                    <filter name="group_start_date" string="Start Date" context="{'group_by': 'start_date'}"/>
                    <filter name="group_rate_type" string="Rate Type" context="{'group_by': 'rental_rate_type'}"/>
                </group>
            </search>
        </field>
    </record>
    
</odoo>

