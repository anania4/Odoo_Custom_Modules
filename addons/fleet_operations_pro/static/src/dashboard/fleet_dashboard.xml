<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="fleet_operations_pro.Dashboard">
        <div class="o_fleet_dashboard">
            <!-- Dashboard Header -->
            <div class="o_dashboard_header">
                <h2>Fleet Operations Dashboard</h2>
                <div class="d-flex gap-2">
                    <button class="btn btn-primary" t-on-click="refresh">
                        <i class="fa fa-refresh"/> Refresh
                    </button>
                </div>
            </div>

            <t t-if="state.loading">
                <div class="text-center p-5">
                    <i class="fa fa-spinner fa-spin fa-3x text-primary"/>
                    <p class="mt-3 text-muted">Loading dashboard data...</p>
                </div>
            </t>

            <t t-else="">
                <t t-if="state.data">
                    <!-- Primary Cards: Active Vehicles, Services, Vehicle Agreements, Pending Fleet Requests -->
                    <t t-set="cards" t-value="state.data.cards"/>
                    <div class="row mb-4" t-if="cards">
                        <!-- 1. Active Vehicles (out of total, + in maintenance) -->
                        <div class="col-lg-3 col-md-6 mb-3">
                            <div class="card h-100 bg-primary text-white cursor-pointer" title="View Active Vehicles"
                                 t-on-click="() =&gt; this.openActiveVehicles()">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <h5 class="card-title text-white-50">Active Vehicles</h5>
                                            <h2 class="mb-0">
                                                <t t-esc="cards.vehicles.active"/>
                                                <small class="fs-6 text-white-50">/ <t t-esc="cards.vehicles.total"/></small>
                                            </h2>
                                            <small>
                                                <a href="#" class="text-white fw-bold"
                                                   title="Vehicles in maintenance"
                                                   t-on-click.prevent.stop="() =&gt; this.openMaintenanceVehicles()">
                                                    <t t-esc="cards.vehicles.in_maintenance"/>
                                                    car<t t-if="cards.vehicles.in_maintenance != 1">s</t> in maintenance
                                                </a>
                                            </small>
                                        </div>
                                        <i class="fa fa-car fa-2x opacity-50" title="Vehicles"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- 2. Services -->
                        <t t-set="svcAlert" t-value="cards.services.open or cards.services.due_by_km"/>
                        <div class="col-lg-3 col-md-6 mb-3">
                            <div t-att-class="'card h-100 cursor-pointer ' + (svcAlert ? 'bg-warning text-dark' : 'bg-light text-dark border')"
                                 title="View Open Services" t-on-click="() =&gt; this.openOpenServices()">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <h5 class="card-title">Services</h5>
                                            <h2 class="mb-0"><t t-esc="cards.services.open"/></h2>
                                            <small>
                                                open (<t t-esc="cards.services.running"/> running)
                                                <t t-if="cards.services.due_by_km"> ·
                                                    <a href="#" class="fw-bold text-danger"
                                                       title="Vehicles that reached the km of their next service"
                                                       t-on-click.prevent.stop="() =&gt; this.openVehiclesDueByKm()">
                                                        <t t-esc="cards.services.due_by_km"/> vehicle<t t-if="cards.services.due_by_km != 1">s</t> due by km
                                                    </a>
                                                </t>
                                            </small>
                                        </div>
                                        <i class="fa fa-wrench fa-2x opacity-50" title="Services"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- 3. Vehicle Agreements needing attention -->
                        <div class="col-lg-3 col-md-6 mb-3">
                            <div t-att-class="'card h-100 cursor-pointer ' + (cards.contracts.expired ? 'bg-danger text-white' : cards.contracts.attention ? 'bg-warning text-dark' : 'bg-light text-dark border')"
                                 title="View Vehicle Agreements Needing Attention" t-on-click="() =&gt; this.openContractsAttention()">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <h5 class="card-title">Vehicle Agreements</h5>
                                            <h2 class="mb-0"><t t-esc="cards.contracts.attention"/></h2>
                                            <small>
                                                need attention:
                                                <t t-esc="cards.contracts.expiring"/> expiring ·
                                                <t t-esc="cards.contracts.expired"/> expired
                                            </small>
                                        </div>
                                        <i class="fa fa-file-text-o fa-2x opacity-50" title="Vehicle Agreements"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- 4. Pending Fleet Requests -->
                        <div class="col-lg-3 col-md-6 mb-3">
                            <div t-att-class="'card h-100 cursor-pointer ' + (cards.requests.pending ? 'bg-warning text-dark' : 'bg-light text-dark border')"
                                 title="View Pending Fleet Requests" t-on-click="() =&gt; this.openPendingRequests()">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <h5 class="card-title">Pending Fleet Requests</h5>
                                            <t t-if="cards.requests.installed and cards.requests.allowed">
                                                <h2 class="mb-0"><t t-esc="cards.requests.pending"/></h2>
                                                <small class="d-block">
                                                    <a href="#" class="text-reset fw-bold" title="Fleet requests waiting for approval or assignment"
                                                       t-on-click.prevent.stop="() =&gt; this.openPendingRequests()">
                                                        Fleet: <t t-esc="cards.requests.fleet_pending"/>
                                                    </a>
                                                    (<t t-esc="cards.requests.awaiting_department"/> dept. ·
                                                    <t t-esc="cards.requests.awaiting_fleet_manager"/> fleet mgr ·
                                                    <t t-esc="cards.requests.awaiting_assignment"/> assign)
                                                </small>
                                                <small class="d-block">
                                                    <a href="#" class="text-reset fw-bold" title="Fuel requests waiting for approval or filling"
                                                       t-on-click.prevent.stop="() =&gt; this.openPendingFuelRequests()">
                                                        Fuel: <t t-esc="cards.requests.fuel_pending"/>
                                                    </a>
                                                    (<t t-esc="cards.requests.fuel_awaiting_approval"/> approval ·
                                                    <t t-esc="cards.requests.fuel_awaiting_filling"/> filling)
                                                </small>
                                            </t>
                                            <small t-elif="!cards.requests.installed">Fleet Requests module not installed</small>
                                            <small t-else="">You do not have access to fleet requests</small>
                                        </div>
                                        <i class="fa fa-clipboard fa-2x opacity-50" title="Fleet Requests"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Vehicle board: one small card per vehicle with a status dot -->
                    <div class="o_fleet_vehicle_board mb-4" t-if="cards and cards.board">
                        <div class="o_board_header">
                            <h5 class="mb-0"><i class="fa fa-th-large" title="Vehicles"/> Vehicles Now</h5>
                            <div class="o_board_legend">
                                <span class="o_board_pill o_board_pill_in_use">
                                    <span class="o_vehicle_dot o_dot_in_use"/>
                                    <t t-esc="cards.board.in_use"/> In Use
                                </span>
                                <span class="o_board_pill o_board_pill_active">
                                    <span class="o_vehicle_dot o_dot_active"/>
                                    <t t-esc="cards.board.active"/> Active
                                </span>
                            </div>
                        </div>
                        <div class="o_board_grid" t-if="cards.board.cards.length">
                            <t t-foreach="cards.board.cards" t-as="car" t-key="car.id">
                                <div t-att-class="'o_vehicle_card o_card_' + car.dot"
                                     t-att-title="car.plate + ' · ' + car.status"
                                     t-on-click="() =&gt; this.openRecord('fleet.vehicle', car.id)">
                                    <div class="o_vc_plate" t-esc="car.plate"/>
                                    <div class="o_vc_sub">
                                        <t t-esc="car.name"/>
                                        <t t-if="car.driver"> · <t t-esc="car.driver"/></t>
                                        <span t-else="" class="o_vc_no_driver"> · No driver</span>
                                    </div>
                                    <div class="o_vc_status">
                                        <span class="o_vc_dot"/>
                                        <t t-esc="car.status or 'No status'"/>
                                    </div>
                                </div>
                            </t>
                        </div>
                        <p t-else="" class="text-muted text-center my-3">No vehicles yet</p>
                        <div t-if="cards.board.total &gt; cards.board.cards.length" class="text-muted small text-center mt-2">
                            Showing <t t-esc="cards.board.cards.length"/> of <t t-esc="cards.board.total"/> vehicles
                        </div>
                    </div>

                    <!-- Needs Action list + Fuel Cost by Vehicle -->
                    <div class="row mb-4">
                        <div class="col-lg-8 mb-3">
                            <div class="card h-100">
                                <div class="card-header d-flex justify-content-between align-items-center">
                                    <h5 class="mb-0"><i class="fa fa-bell" title="Needs Action"/> Needs Action</h5>
                                    <span t-if="cards and cards.needs_action_total" class="badge bg-danger">
                                        <t t-esc="cards.needs_action_total"/>
                                    </span>
                                </div>
                                <div class="card-body p-0">
                                    <t t-if="cards and cards.needs_action.length">
                                        <div class="list-group list-group-flush">
                                            <t t-foreach="cards.needs_action" t-as="item" t-key="item.key">
                                                <a href="#" class="list-group-item list-group-item-action py-2"
                                                   t-on-click.prevent="() =&gt; this.openRecord(item.res_model, item.res_id)">
                                                    <div class="d-flex justify-content-between align-items-center">
                                                        <div>
                                                            <small class="text-muted d-block"><t t-esc="item.kind"/></small>
                                                            <span class="fw-bold"><t t-esc="item.title"/></span>
                                                            <small class="text-muted">
                                                                ·
                                                                <t t-if="item.amount"><t t-esc="formatCurrency(item.amount)"/> </t>
                                                                <t t-esc="item.detail"/>
                                                            </small>
                                                        </div>
                                                        <span t-att-class="'badge text-bg-' + item.badge_class">
                                                            <t t-esc="item.badge"/>
                                                        </span>
                                                    </div>
                                                </a>
                                            </t>
                                        </div>
                                        <div t-if="cards.needs_action_total &gt; cards.needs_action.length"
                                             class="text-muted small text-center py-2 border-top">
                                            Showing <t t-esc="cards.needs_action.length"/> of
                                            <t t-esc="cards.needs_action_total"/>. Use the cards above to see all.
                                        </div>
                                    </t>
                                    <t t-else="">
                                        <p class="text-muted text-center my-4">
                                            <i class="fa fa-check-circle text-success" title="All clear"/> Nothing needs action
                                        </p>
                                    </t>
                                </div>
                            </div>
                        </div>

                        <!-- Fuel Cost by Vehicle -->
                        <div class="col-lg-4 col-md-12 mb-3">
                            <div class="card h-100">
                                <div class="card-header">
                                    <h5><i class="fa fa-tint"/> Fuel Cost by Vehicle</h5>
                                    <span class="badge bg-secondary">30 days</span>
                                </div>
                                <div class="card-body">
                                    <t t-if="state.data.charts.fuel_cost_by_vehicle.length">
                                        <div class="list-group list-group-flush">
                                            <t t-foreach="state.data.charts.fuel_cost_by_vehicle" t-as="item" t-key="item.name">
                                                <div class="list-group-item px-0">
                                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                                        <div>
                                                            <div class="fw-bold"><t t-esc="item.name"/></div>
                                                            <small class="text-muted"><t t-esc="item.vehicle"/></small>
                                                        </div>
                                                        <strong><t t-esc="formatCurrency(item.value)"/></strong>
                                                    </div>
                                                    <div class="progress" style="height: 6px;">
                                                        <div class="progress-bar bg-warning" role="progressbar" 
                                                             t-att-style="'width: ' + (item.percentage || 0) + '%'"/>
                                                    </div>
                                                </div>
                                            </t>
                                        </div>
                                    </t>
                                    <t t-else="">
                                        <p class="text-muted text-center mb-0">No fuel cost data available</p>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Active Vehicles list + Vehicles with their status -->
                    <div class="row mb-4" t-if="cards">
                        <div class="col-lg-6 mb-3">
                            <div class="card h-100">
                                <div class="card-header d-flex justify-content-between align-items-center">
                                    <h5 class="mb-0"><i class="fa fa-car" title="Active Vehicles"/> Active Vehicles</h5>
                                    <a href="#" class="small" t-on-click.prevent="() =&gt; this.openActiveVehicles()">
                                        View all (<t t-esc="cards.vehicles.active"/>)
                                    </a>
                                </div>
                                <div class="card-body p-0">
                                    <t t-if="cards.available_list.length">
                                        <div class="table-responsive">
                                            <table class="table table-hover table-sm mb-0 align-middle">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th class="ps-3">Plate</th>
                                                        <th>Car Name</th>
                                                        <th class="pe-3">Driver</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <t t-foreach="cards.available_list" t-as="car" t-key="car.id">
                                                        <tr class="cursor-pointer" t-on-click="() =&gt; this.openRecord('fleet.vehicle', car.id)">
                                                            <td class="ps-3 fw-bold"><t t-esc="car.plate"/></td>
                                                            <td><t t-esc="car.name"/></td>
                                                            <td>
                                                                <t t-if="car.driver"><t t-esc="car.driver"/></t>
                                                                <span t-else="" class="text-muted">No driver</span>
                                                            </td>
                                                        </tr>
                                                    </t>
                                                </tbody>
                                            </table>
                                        </div>
                                        <div t-if="cards.vehicles.active &gt; cards.available_list.length"
                                             class="text-muted small text-center py-2 border-top">
                                            Showing <t t-esc="cards.available_list.length"/> of
                                            <t t-esc="cards.vehicles.active"/>
                                        </div>
                                    </t>
                                    <p t-else="" class="text-muted text-center my-4">No active vehicles right now</p>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-6 mb-3">
                            <div class="card h-100">
                                <div class="card-header d-flex justify-content-between align-items-center">
                                    <h5 class="mb-0"><i class="fa fa-flag" title="Vehicle Status"/> Vehicle Status</h5>
                                    <a href="#" class="small" t-on-click.prevent="() =&gt; this.openAllVehicles()">
                                        View all (<t t-esc="cards.vehicles.total"/>)
                                    </a>
                                </div>
                                <div class="card-body p-0">
                                    <t t-if="cards.status_list.length">
                                        <div class="table-responsive">
                                            <table class="table table-hover table-sm mb-0 align-middle">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th class="ps-3">Plate</th>
                                                        <th>Car Name</th>
                                                        <th class="pe-3">Status</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <t t-foreach="cards.status_list" t-as="car" t-key="car.id">
                                                        <tr class="cursor-pointer" t-on-click="() =&gt; this.openRecord('fleet.vehicle', car.id)">
                                                            <td class="ps-3 fw-bold"><t t-esc="car.plate"/></td>
                                                            <td><t t-esc="car.name"/></td>
                                                            <td class="pe-3">
                                                                <span t-att-class="'badge rounded-pill o_tag_color_' + car.color">
                                                                    <t t-esc="car.status or 'No status'"/>
                                                                </span>
                                                            </td>
                                                        </tr>
                                                    </t>
                                                </tbody>
                                            </table>
                                        </div>
                                        <div t-if="cards.vehicles.total &gt; cards.status_list.length"
                                             class="text-muted small text-center py-2 border-top">
                                            Showing <t t-esc="cards.status_list.length"/> of
                                            <t t-esc="cards.vehicles.total"/>
                                        </div>
                                    </t>
                                    <p t-else="" class="text-muted text-center my-4">No vehicles yet</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Footer Info -->
                    <div class="row">
                        <div class="col-12">
                            <div class="card bg-light">
                                <div class="card-body py-2">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <small class="text-muted">
                                            <i class="fa fa-info-circle"/> Dashboard data refreshed: 
                                            <t t-if="state.lastUpdated">
                                                <t t-esc="getTimeAgo(state.lastUpdated)"/>
                                            </t>
                                        </small>
                                        <small class="text-muted">
                                            Fleet Operations Pro v1.0.0
                                        </small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </div>
    </t>
</templates>
