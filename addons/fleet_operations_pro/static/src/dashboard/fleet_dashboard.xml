<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="fleet_operations_pro.Dashboard">
        <div class="o_fleet_dashboard">
            <!-- Dashboard Header -->
            <div class="o_dashboard_header">
                <h2>Fleet Operations Dashboard</h2>
                <div class="d-flex gap-2">
                    <button class="btn btn-primary" t-on-click="refresh">
                        <i class="fa fa-refresh"/> Refresh
                    </button>
                </div>
            </div>

            <t t-if="state.loading">
                <div class="text-center p-5">
                    <i class="fa fa-spinner fa-spin fa-3x text-primary"/>
                    <p class="mt-3 text-muted">Loading dashboard data...</p>
                </div>
            </t>

            <t t-else="">
                <t t-if="state.data">
                    <!-- Primary KPI Cards -->
                    <div class="row mb-4">
                        <div class="col-lg-3 col-md-6 mb-3">
                            <div class="card bg-primary text-white">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <h5 class="card-title text-white-50">Total Vehicles</h5>
                                            <h2 class="mb-0"><t t-esc="state.data.kpis.total_vehicles"/></h2>
                                            <small class="text-white-50">
                                                <t t-esc="state.data.kpis.available_vehicles"/> Available
                                            </small>
                                        </div>
                                        <i class="fa fa-car fa-2x opacity-50"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="col-lg-3 col-md-6 mb-3">
                            <div class="card bg-success text-white cursor-pointer" title="View Contracts" t-on-click="() =&gt; this.openContracts()">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <h5 class="card-title text-white-50">Running Contracts</h5>
                                            <h2 class="mb-0"><t t-esc="state.data.kpis.running_contracts"/></h2>
                                            <small class="text-white-50">
                                                of <t t-esc="state.data.kpis.total_contracts"/> Total
                                            </small>
                                        </div>
                                        <i class="fa fa-file-text-o fa-2x opacity-50"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="col-lg-3 col-md-6 mb-3">
                            <div class="card bg-warning text-dark cursor-pointer" title="View Upcoming Services" t-on-click="() =&gt; this.openUpcomingServices()">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <h5 class="card-title">Upcoming Services</h5>
                                            <h2 class="mb-0"><t t-esc="state.data.kpis.upcoming_services"/></h2>
                                            <small class="text-muted">
                                                of <t t-esc="state.data.kpis.total_services"/> Total
                                            </small>
                                        </div>
                                        <i class="fa fa-wrench fa-2x opacity-50"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="col-lg-3 col-md-6 mb-3">
                            <div class="card bg-info text-white cursor-pointer" title="View Fleet Requests" t-on-click="() =&gt; this.openRequests()">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <h5 class="card-title text-white-50">Fleet Requests</h5>
                                            <h2 class="mb-0"><t t-esc="formatNumber(state.data.kpis.total_requests, 0)"/></h2>
                                            <small class="text-white-50">
                                                <t t-esc="state.data.kpis.open_requests"/> Open / <t t-esc="state.data.kpis.assigned_requests"/> Assigned
                                            </small>
                                        </div>
                                        <i class="fa fa-clipboard-list fa-2x opacity-50"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Charts and Analytics Row -->
                    <div class="row mb-4">
                        <!-- Vehicle Status Chart -->
                        <div class="col-lg-4 col-md-6 mb-3">
                            <div class="card">
                                <div class="card-header">
                                    <h5><i class="fa fa-car"/> Vehicles by Status</h5>
                                </div>
                                <div class="card-body">
                                    <t t-if="state.data.charts.vehicle_by_status.length">
                                        <div class="list-group list-group-flush">
                                            <t t-foreach="state.data.charts.vehicle_by_status" t-as="item" t-key="item.name">
                                                <div class="list-group-item px-0">
                                                    <div class="d-flex justify-content-between align-items-center">
                                                        <span class="fw-bold"><t t-esc="item.name"/></span>
                                                        <span class="badge bg-primary rounded-pill"><t t-esc="item.value"/></span>
                                                    </div>
                                                    <div class="d-flex flex-wrap gap-1 mt-2">
                                                        <t t-foreach="item.plates" t-as="plate" t-key="plate_index">
                                                            <span class="badge text-bg-light border"><t t-esc="plate"/></span>
                                                        </t>
                                                    </div>
                                                </div>
                                            </t>
                                        </div>
                                    </t>
                                    <t t-else="">
                                        <p class="text-muted text-center mb-0">No data available</p>
                                    </t>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Vehicle Category Chart -->
                        <div class="col-lg-4 col-md-6 mb-3">
                            <div class="card">
                                <div class="card-header">
                                    <h5><i class="fa fa-tags"/> Vehicles by Category</h5>
                                </div>
                                <div class="card-body">
                                    <t t-if="state.data.charts.vehicle_by_category.length">
                                        <div class="list-group list-group-flush">
                                            <t t-foreach="state.data.charts.vehicle_by_category" t-as="item" t-key="item.name">
                                                <div class="list-group-item px-0">
                                                    <div class="d-flex justify-content-between align-items-center">
                                                        <span class="fw-bold"><t t-esc="item.name"/></span>
                                                        <span class="badge bg-success rounded-pill"><t t-esc="item.value"/></span>
                                                    </div>
                                                    <div class="d-flex flex-wrap gap-1 mt-2">
                                                        <t t-foreach="item.plates" t-as="plate" t-key="plate_index">
                                                            <span class="badge text-bg-light border"><t t-esc="plate"/></span>
                                                        </t>
                                                    </div>
                                                </div>
                                            </t>
                                        </div>
                                    </t>
                                    <t t-else="">
                                        <p class="text-muted text-center mb-0">No data available</p>
                                    </t>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Fuel Cost by Vehicle -->
                        <div class="col-lg-4 col-md-12 mb-3">
                            <div class="card">
                                <div class="card-header">
                                    <h5><i class="fa fa-tint"/> Fuel Cost by Vehicle</h5>
                                    <span class="badge bg-secondary">30 days</span>
                                </div>
                                <div class="card-body">
                                    <t t-if="state.data.charts.fuel_cost_by_vehicle.length">
                                        <div class="list-group list-group-flush">
                                            <t t-foreach="state.data.charts.fuel_cost_by_vehicle" t-as="item" t-key="item.name">
                                                <div class="list-group-item px-0">
                                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                                        <div>
                                                            <div class="fw-bold"><t t-esc="item.name"/></div>
                                                            <small class="text-muted"><t t-esc="item.vehicle"/></small>
                                                        </div>
                                                        <strong><t t-esc="formatCurrency(item.value)"/></strong>
                                                    </div>
                                                    <div class="progress" style="height: 6px;">
                                                        <div class="progress-bar bg-warning" role="progressbar" 
                                                             t-att-style="'width: ' + (item.percentage || 0) + '%'"/>
                                                    </div>
                                                </div>
                                            </t>
                                        </div>
                                    </t>
                                    <t t-else="">
                                        <p class="text-muted text-center mb-0">No fuel cost data available</p>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Alerts and Notifications -->
                    <div class="row mb-4">
                        <!-- Contract Expiry Alerts -->
                        <div class="col-lg-6 mb-3">
                            <div class="card border-danger cursor-pointer" title="View Contracts" t-on-click="() =&gt; this.openContracts()">
                                <div class="card-header bg-danger text-white">
                                    <h5 class="mb-0"><i class="fa fa-file-text-o"/> Recent Contract Expiries</h5>
                                </div>
                                <div class="card-body p-0">
                                    <div class="d-flex justify-content-between mb-3">
                                        <div>
                                            <h3 class="mb-0 text-danger"><t t-esc="state.data.alerts.expired_contracts"/></h3>
                                            <small class="text-muted">Overdue</small>
                                        </div>
                                        <div>
                                            <h3 class="mb-0 text-warning"><t t-esc="state.data.alerts.expiring_contracts"/></h3>
                                            <small class="text-muted">Expiring Soon</small>
                                        </div>
                                    </div>
                                    <t t-if="state.data.alerts.contract_details.length">
                                        <h6 class="text-muted mb-2">Contracts:</h6>
                                        <div class="list-group list-group-flush">
                                            <t t-foreach="state.data.alerts.contract_details" t-as="item" t-key="item_index">
                                                <div class="list-group-item px-0 py-2">
                                                    <div class="d-flex justify-content-between">
                                                        <div>
                                                            <div class="fw-bold small"><t t-esc="item.plate"/> · <t t-esc="item.vehicle"/></div>
                                                            <small class="text-muted"><t t-esc="item.contract"/> · <t t-esc="item.contract_type"/> · <t t-esc="item.provider"/></small>
                                                        </div>
                                                        <div class="text-end">
                                                            <small class="badge bg-secondary"><t t-esc="item.end_date"/></small>
                                                            <small t-att-class="'badge bg-' + item.status_class">
                                                                <t t-if="item.days_left &gt;= 0"><t t-esc="item.days_left"/> days left</t>
                                                                <t t-else="">Overdue</t>
                                                            </small>
                                                        </div>
                                                    </div>
                                                </div>
                                            </t>
                                        </div>
                                    </t>
                                    <t t-else="">
                                        <p class="text-muted text-center small mb-0">No contracts expiring soon</p>
                                    </t>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Upcoming Services -->
                        <div class="col-lg-6 mb-3">
                            <div class="card border-warning cursor-pointer" title="View Upcoming Services" t-on-click="() =&gt; this.openUpcomingServices()">
                                <div class="card-header bg-warning">
                                    <h5 class="mb-0"><i class="fa fa-wrench"/> Upcoming Services</h5>
                                </div>
                                <div class="card-body">
                                    <t t-if="state.data.alerts.upcoming_services.length">
                                        <div class="list-group list-group-flush">
                                            <t t-foreach="state.data.alerts.upcoming_services" t-as="service" t-key="service_index">
                                                <div class="list-group-item px-0 py-2">
                                                    <div class="d-flex justify-content-between">
                                                        <div>
                                                            <div class="fw-bold small"><t t-esc="service.plate"/> · <t t-esc="service.vehicle"/></div>
                                                            <small class="text-muted"><t t-esc="service.service"/> · <t t-esc="service.date"/></small>
                                                        </div>
                                                        <small class="badge bg-secondary">
                                                            <t t-if="service.days_until == 0">Today</t>
                                                            <t t-elif="service.days_until == 1">Tomorrow</t>
                                                            <t t-else="">in <t t-esc="service.days_until"/> days</t>
                                                        </small>
                                                    </div>
                                                </div>
                                            </t>
                                        </div>
                                    </t>
                                    <t t-else="">
                                        <p class="text-muted text-center small mb-0">No upcoming services</p>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Footer Info -->
                    <div class="row">
                        <div class="col-12">
                            <div class="card bg-light">
                                <div class="card-body py-2">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <small class="text-muted">
                                            <i class="fa fa-info-circle"/> Dashboard data refreshed: 
                                            <t t-if="state.lastUpdated">
                                                <t t-esc="getTimeAgo(state.lastUpdated)"/>
                                            </t>
                                        </small>
                                        <small class="text-muted">
                                            Fleet Operations Pro v1.0.0
                                        </small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </div>
    </t>
</templates>
