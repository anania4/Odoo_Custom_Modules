<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_mefs_boq" model="ir.module.category">
        <field name="name">Bill of Quantity</field>
        <field name="sequence">50</field>
    </record>

    <record id="group_mefs_boq_user" model="res.groups">
        <field name="name">BOQ User</field>
        <field name="category_id" ref="module_category_mefs_boq"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Administrators are BOQ users automatically so the module stays manageable -->
    <record id="base.user_admin" model="res.users">
        <field name="groups_id" eval="[(4, ref('group_mefs_boq_user'))]"/>
    </record>
</odoo>
