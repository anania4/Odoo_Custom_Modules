<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Master Document Template -->
    <template id="report_boq_document">
        <t t-call="web.external_layout">
            <div class="page" style="font-family: Arial, Helvetica, sans-serif; font-size: 10pt; color: #111;">
                <div class="oe_structure"/>

                <!-- Header Title & Notes -->
                <div style="margin-top: 10px; margin-bottom: 12px;">
                    <div style="display: flex; justify-content: space-between; align-items: flex-end; border-bottom: 2px solid #333; padding-bottom: 6px;">
                        <div>
                            <h3 style="font-size: 13pt; font-weight: bold; margin: 0; text-transform: uppercase;">
                                <t t-out="report_data['title']"/>
                            </h3>
                            <div style="font-size: 9.5pt; font-weight: bold; color: #555; margin-top: 3px;">
                                [<t t-out="report_data['subtitle']"/>]
                            </div>
                        </div>
                        <div style="text-align: right; font-size: 9.5pt;">
                            <strong>Date:</strong> <span t-field="o.date"/><br/>
                            <strong>Ref:</strong> <span t-field="o.revision_name"/>
                        </div>
                    </div>
                    <div style="margin-top: 6px; font-size: 9pt; color: #333;">
                        <strong>Project:</strong> <span t-field="o.project_id.name"/>
                        <t t-if="o.partner_id">
                            | <strong>Client:</strong> <span t-field="o.partner_id.name"/>
                        </t>
                    </div>
                    <div style="margin-top: 5px; font-size: 9pt; color: #444; font-style: italic;">
                        <t t-out="report_data['note']"/>
                    </div>
                </div>

                <!-- Main BOQ Items Table -->
                <table style="width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 9.5pt; table-layout: fixed;">
                    <thead>
                        <tr style="background-color: #e8e8e8; font-weight: bold; border-top: 1px solid #333;">
                            <th style="border: 1px solid #333; padding: 6px 4px; text-align: center; width: 7%;">Bill No.</th>
                            <th style="border: 1px solid #333; padding: 6px 6px; text-align: left; width: 45%;">Description of Works</th>
                            <th style="border: 1px solid #333; padding: 6px 4px; text-align: center; width: 8%;">Unit</th>
                            <th style="border: 1px solid #333; padding: 6px 6px; text-align: right; width: 12%;">Quantity</th>
                            <th style="border: 1px solid #333; padding: 6px 6px; text-align: right; width: 13%;">Price in <t t-out="report_data['currency_name']"/></th>
                            <th style="border: 1px solid #333; padding: 6px 6px; text-align: right; width: 15%;">Total in <t t-out="report_data['currency_name']"/></th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="report_data['rows']" t-as="row">
                            <!-- Section Header (e.g. 1 Mobilization) -->
                            <t t-if="row['is_section']">
                                <tr style="font-weight: bold; background-color: #f7f7f7;">
                                    <td style="border: 1px solid #333; padding: 5px 4px; text-align: center;">
                                        <t t-out="row['bill_no']"/>
                                    </td>
                                    <td style="border: 1px solid #333; padding: 5px 6px; text-align: left;">
                                        <t t-out="row['name']"/>
                                    </td>
                                    <td style="border: 1px solid #333; padding: 5px 4px; text-align: center;">
                                        <t t-out="row['unit']"/>
                                    </td>
                                    <td style="border: 1px solid #333; padding: 5px 6px; text-align: right;">
                                        <t t-out="row['quantity']"/>
                                    </td>
                                    <td style="border: 1px solid #333; padding: 5px 6px; text-align: right;">
                                        <t t-out="row['unit_price']"/>
                                    </td>
                                    <td style="border: 1px solid #333; padding: 5px 6px; text-align: right;">
                                        <t t-out="row['total_price']"/>
                                    </td>
                                </tr>
                            </t>

                            <!-- Sub-Total Row (e.g. Sub-Total Bill No. 1) -->
                            <t t-elif="row['is_subtotal']">
                                <tr style="font-weight: bold; background-color: #f0f0f0;">
                                    <td style="border: 1px solid #333; padding: 5px 4px; text-align: center;"></td>
                                    <td style="border: 1px solid #333; padding: 5px 6px; text-align: left;">
                                        <t t-out="row['name']"/>
                                    </td>
                                    <td style="border: 1px solid #333; padding: 5px 4px; text-align: center;"></td>
                                    <td style="border: 1px solid #333; padding: 5px 6px; text-align: right;"></td>
                                    <td style="border: 1px solid #333; padding: 5px 6px; text-align: right;"></td>
                                    <td style="border: 1px solid #333; padding: 5px 6px; text-align: right;">
                                        <t t-out="row['total_price']"/>
                                    </td>
                                </tr>
                            </t>

                            <!-- Standard Work Item Row -->
                            <t t-else="">
                                <tr>
                                    <td style="border: 1px solid #333; padding: 5px 4px; text-align: center;">
                                        <t t-out="row['bill_no']"/>
                                    </td>
                                    <td style="border: 1px solid #333; padding: 5px 6px; text-align: left;">
                                        <t t-out="row['name']"/>
                                    </td>
                                    <td style="border: 1px solid #333; padding: 5px 4px; text-align: center;">
                                        <t t-out="row['unit']"/>
                                    </td>
                                    <td style="border: 1px solid #333; padding: 5px 6px; text-align: right;">
                                        <t t-out="row['quantity']"/>
                                    </td>
                                    <td style="border: 1px solid #333; padding: 5px 6px; text-align: right;">
                                        <t t-out="row['unit_price']"/>
                                    </td>
                                    <td style="border: 1px solid #333; padding: 5px 6px; text-align: right;">
                                        <t t-out="row['total_price']"/>
                                    </td>
                                </tr>
                            </t>
                        </t>

                        <!-- Summary Header Row -->
                        <tr style="font-weight: bold; background-color: #f7f7f7; border-top: 2px solid #333;">
                            <td style="border: 1px solid #333; padding: 5px 4px; text-align: center;"></td>
                            <td style="border: 1px solid #333; padding: 5px 6px; text-align: left;">Summary</td>
                            <td style="border: 1px solid #333; padding: 5px 4px; text-align: center;"></td>
                            <td style="border: 1px solid #333; padding: 5px 6px; text-align: right;"></td>
                            <td style="border: 1px solid #333; padding: 5px 6px; text-align: right;"></td>
                            <td style="border: 1px solid #333; padding: 5px 6px; text-align: right;"></td>
                        </tr>

                        <!-- Summary per Bill Section -->
                        <t t-foreach="report_data['summaries']" t-as="sum_item">
                            <tr>
                                <td style="border: 1px solid #333; padding: 5px 4px; text-align: center; font-weight: bold;">
                                    <t t-out="sum_item['num']"/>
                                </td>
                                <td style="border: 1px solid #333; padding: 5px 6px; text-align: left;">
                                    <t t-out="sum_item['title']"/>
                                </td>
                                <td style="border: 1px solid #333; padding: 5px 4px; text-align: center;"></td>
                                <td style="border: 1px solid #333; padding: 5px 6px; text-align: right;"></td>
                                <td style="border: 1px solid #333; padding: 5px 6px; text-align: right;"></td>
                                <td style="border: 1px solid #333; padding: 5px 6px; text-align: right; font-weight: bold;">
                                    <t t-out="sum_item['amount']"/>
                                </td>
                            </tr>
                        </t>

                        <!-- Summary Total Before VAT -->
                        <tr style="font-weight: bold; border-top: 2px solid #333;">
                            <td style="border: 1px solid #333; padding: 5px 4px; text-align: center;">I</td>
                            <td style="border: 1px solid #333; padding: 5px 6px; text-align: left;">Summary Total Before VAT</td>
                            <td style="border: 1px solid #333; padding: 5px 4px; text-align: center;"></td>
                            <td style="border: 1px solid #333; padding: 5px 6px; text-align: right;"></td>
                            <td style="border: 1px solid #333; padding: 5px 6px; text-align: right;"></td>
                            <td style="border: 1px solid #333; padding: 5px 6px; text-align: right;">
                                <t t-out="report_data['total_before_vat']"/>
                            </td>
                        </tr>

                        <!-- VAT -->
                        <tr style="font-weight: bold;">
                            <td style="border: 1px solid #333; padding: 5px 4px; text-align: center;">II</td>
                            <td style="border: 1px solid #333; padding: 5px 6px; text-align: left;">VAT (15%)</td>
                            <td style="border: 1px solid #333; padding: 5px 4px; text-align: center;"></td>
                            <td style="border: 1px solid #333; padding: 5px 6px; text-align: right;"></td>
                            <td style="border: 1px solid #333; padding: 5px 6px; text-align: right;"></td>
                            <td style="border: 1px solid #333; padding: 5px 6px; text-align: right;">
                                <t t-out="report_data['vat_amount']"/>
                            </td>
                        </tr>

                        <!-- GRAND TOTAL -->
                        <tr style="font-weight: bold; background-color: #f2f2f2; font-size: 10pt;">
                            <td style="border: 1px solid #333; padding: 6px 4px; text-align: center;">III</td>
                            <td style="border: 1px solid #333; padding: 6px 6px; text-align: left;">GRAND TOTAL</td>
                            <td style="border: 1px solid #333; padding: 6px 4px; text-align: center;"></td>
                            <td style="border: 1px solid #333; padding: 6px 6px; text-align: right;"></td>
                            <td style="border: 1px solid #333; padding: 6px 6px; text-align: right;"></td>
                            <td style="border: 1px solid #333; padding: 6px 6px; text-align: right; color: #000;">
                                <t t-out="report_data['grand_total']"/>
                            </td>
                        </tr>
                    </tbody>
                </table>

                <!-- Stamp and Signatures Section -->
                <div style="margin-top: 40px; page-break-inside: avoid;">
                    <table style="width: 100%; border: none;">
                        <tr>
                            <td style="width: 50%; vertical-align: top; padding: 8px 15px; border: none;">
                                <div style="font-weight: bold; margin-bottom: 25px; text-transform: uppercase;">Prepared By (Contractor):</div>
                                <div style="margin-bottom: 12px;">Name: ____________________________________</div>
                                <div style="margin-bottom: 25px;">Signature: _______________________________</div>
                                <div>Date: ____________________ Stamp:</div>
                            </td>
                            <td style="width: 50%; vertical-align: top; padding: 8px 15px; border: none;">
                                <div style="font-weight: bold; margin-bottom: 25px; text-transform: uppercase;">Approved By (Client / Consultant):</div>
                                <div style="margin-bottom: 12px;">Name: ____________________________________</div>
                                <div style="margin-bottom: 25px;">Signature: _______________________________</div>
                                <div>Date: ____________________ Stamp:</div>
                            </td>
                        </tr>
                    </table>
                </div>

                <div class="oe_structure"/>
            </div>
        </t>
    </template>

    <!-- 1. Original BOQ Report Template -->
    <template id="report_boq_original_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="report_data" t-value="o._get_boq_report_data('original')"/>
                <t t-call="mefs_bill_of_quantity.report_boq_document"/>
            </t>
        </t>
    </template>

    <!-- 2. Current BOQ Report Template -->
    <template id="report_boq_current_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="report_data" t-value="o._get_boq_report_data('current')"/>
                <t t-call="mefs_bill_of_quantity.report_boq_document"/>
            </t>
        </t>
    </template>

    <!-- Legacy Alias Template -->
    <template id="report_boq_template">
        <t t-call="mefs_bill_of_quantity.report_boq_original_template"/>
    </template>
</odoo>
