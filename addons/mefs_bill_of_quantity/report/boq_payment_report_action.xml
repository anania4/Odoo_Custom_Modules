<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Paperformat: Landscape A4 with tight engineering margins -->
    <record id="paperformat_boq_payment_landscape" model="report.paperformat">
        <field name="name">BOQ Payment Landscape A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">5</field>
        <field name="dpi">90</field>
    </record>

    <!-- Report Action -->
    <record id="action_report_mefs_boq_payment" model="ir.actions.report">
        <field name="name">Interim Payment Certificate (IPC)</field>
        <field name="model">mefs.boq.payment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">mefs_bill_of_quantity.report_boq_payment_template</field>
        <field name="report_file">mefs_bill_of_quantity.report_boq_payment_template</field>
        <field name="print_report_name">'IPC - %s' % (object.name)</field>
        <field name="paperformat_id" ref="mefs_bill_of_quantity.paperformat_boq_payment_landscape"/>
        <field name="binding_model_id" ref="model_mefs_boq_payment"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
