<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="project_project_view_form_inherit_boq" model="ir.ui.view">
        <field name="name">project.project.form.inherit.boq</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="%(action_mefs_boq)d" type="action" groups="mefs_bill_of_quantity.group_mefs_boq_user" class="oe_stat_button" icon="fa-list-ol" context="{'default_project_id': id, 'search_default_project_id': id}">
                    <div class="o_stat_info">
                        <field name="boq_count" class="o_stat_value" nolabel="1"/>
                        <span class="o_stat_text">BOQs</span>
                    </div>
                    <div class="o_stat_info" role="sub">
                        <field name="boq_total" class="o_stat_text" nolabel="1"/>
                    </div>
                </button>
                <button name="%(action_mefs_boq_payment)d" type="action" groups="mefs_bill_of_quantity.group_mefs_boq_user" class="oe_stat_button" icon="fa-money" context="{'default_project_id': id, 'search_default_project_id': id}">
                    <div class="o_stat_info">
                        <field name="payment_count" class="o_stat_value" nolabel="1"/>
                        <span class="o_stat_text">BOQ Payments</span>
                    </div>
                </button>
            </div>

        </field>
    </record>

    <record id="view_task_form2_inherit_boq" model="ir.ui.view">
        <field name="name">project.task.form.inherit.boq</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="%(action_mefs_boq)d" type="action" groups="mefs_bill_of_quantity.group_mefs_boq_user" class="oe_stat_button" icon="fa-list-ol" context="{'search_default_project_id': project_id, 'search_default_task_id': id}">
                    <div class="o_stat_info">
                        <span class="o_stat_text">BOQs</span>
                    </div>
                </button>
            </div>
        </field>
    </record>
</odoo>
