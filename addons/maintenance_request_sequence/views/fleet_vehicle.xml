<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Replace the vehicle's Maintenance smart button with the Maintenance app requests -->
    <record id="view_fleet_vehicle_form_maintenance_request" model="ir.ui.view">
        <field name="name">fleet.vehicle.form.maintenance.request</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet_operations_pro.view_fleet_vehicle_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//button[@name='%(fleet_operations_pro.action_fleet_maintenance_vehicle)d']"
                position="replace"
            >
                <button
                    name="action_view_maintenance_requests"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-wrench"
                >
                    <field
                        name="maintenance_request_count"
                        widget="statinfo"
                        string="Maintenance"
                    />
                </button>
            </xpath>
        </field>
    </record>
</odoo>
