<odoo>
    <record model="ir.ui.view" id="hr_equipment_request_view_form">
        <field
            name="name"
        >maintenance.request.form (in maintenance_request_sequence)</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]" position="replace">
                <div class="oe_title">
                    <h1>
                        <field
                            name="code"
                            readonly="1"
                            invisible="code == '/'"
                            placeholder="MR/0000/00000"
                        />
                    </h1>
                    <label for="name" string="Request" />
                    <h2>
                        <field name="name" placeholder="e.g. Screen not working" />
                    </h2>
                </div>
            </xpath>
        </field>
    </record>
    <record model="ir.ui.view" id="hr_equipment_request_view_search">
        <field
            name="name"
        >maintenance.request.search (in maintenance_request_sequence)</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_search" />
        <field name="arch" type="xml">
            <field name="name" position="before">
                <field name="code" />
            </field>
        </field>
    </record>
    <record model="ir.ui.view" id="hr_equipment_request_view_tree">
        <field
            name="name"
        >maintenance.request.tree (in maintenance_request_sequence)</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_tree" />
        <field name="arch" type="xml">
            <field name="name" position="before">
                <field name="code" optional="show" />
            </field>
        </field>
    </record>
    <record model="ir.ui.view" id="hr_equipment_request_view_kanban">
        <field
            name="name"
        >maintenance.request.kanban (in maintenance_request_sequence)</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_kanban" />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <span class="text-muted">
                    <field name="code" />
                </span>
            </field>
        </field>
    </record>
</odoo>
