<odoo>
    <record model="ir.ui.view" id="hr_equipment_request_view_form">
        <field
            name="name"
        >maintenance.request.form (in maintenance_request_sequence)</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]" position="replace">
                <div class="oe_title">
                    <h1>
                        <field
                            name="code"
                            readonly="1"
                            invisible="code == '/'"
                            placeholder="MR/0000/00000"
                        />
                    </h1>
                    <label for="name" string="Request" />
                    <h2>
                        <field name="name" placeholder="e.g. Screen not working" />
                    </h2>
                </div>
            </xpath>
            <field name="equipment_id" position="before">
                <field name="asset_type" widget="radio" options="{'horizontal': true}" />
            </field>
            <field name="equipment_id" position="attributes">
                <attribute name="invisible">asset_type != 'machinery'</attribute>
                <attribute name="required">asset_type == 'machinery'</attribute>
                <attribute name="string">Machinery</attribute>
            </field>
            <field name="equipment_id" position="after">
                <field
                    name="vehicle_id"
                    invisible="asset_type != 'vehicle'"
                    required="asset_type == 'vehicle'"
                    options="{'no_create': True}"
                />
            </field>
        </field>
    </record>
    <record model="ir.ui.view" id="hr_equipment_request_view_search">
        <field
            name="name"
        >maintenance.request.search (in maintenance_request_sequence)</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_search" />
        <field name="arch" type="xml">
            <field name="name" position="before">
                <field name="code" />
            </field>
            <field name="equipment_id" position="after">
                <field name="vehicle_id" />
            </field>
            <filter name="done" position="after">
                <separator />
                <filter
                    string="Machinery"
                    name="filter_machinery"
                    domain="[('asset_type', '=', 'machinery')]"
                />
                <filter
                    string="Vehicles"
                    name="filter_vehicle"
                    domain="[('asset_type', '=', 'vehicle')]"
                />
            </filter>
            <xpath expr="//search" position="inside">
                <group expand="0" string="Group By">
                    <filter
                        string="Asset Type"
                        name="group_asset_type"
                        context="{'group_by': 'asset_type'}"
                    />
                    <filter
                        string="Vehicle"
                        name="group_vehicle"
                        context="{'group_by': 'vehicle_id'}"
                    />
                </group>
            </xpath>
        </field>
    </record>
    <record model="ir.ui.view" id="hr_equipment_request_view_tree">
        <field
            name="name"
        >maintenance.request.tree (in maintenance_request_sequence)</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_tree" />
        <field name="arch" type="xml">
            <field name="name" position="before">
                <field name="code" optional="show" />
            </field>
            <field name="name" position="after">
                <field name="asset_type" optional="show" />
                <field name="vehicle_id" optional="show" />
            </field>
        </field>
    </record>
    <record model="ir.ui.view" id="hr_equipment_request_view_kanban">
        <field
            name="name"
        >maintenance.request.kanban (in maintenance_request_sequence)</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_kanban" />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <span class="text-muted">
                    <field name="code" />
                </span>
                <span t-if="record.vehicle_id.raw_value">
                    Vehicle: <field name="vehicle_id" />
                </span>
            </field>
        </field>
    </record>
</odoo>
