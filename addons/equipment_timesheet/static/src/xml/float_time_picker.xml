<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="equipment_timesheet.TimePickerField" t-inherit="web.FloatTimeField" t-inherit-mode="primary">
        <xpath expr="//input" position="attributes">
            <attribute name="t-on-click">onInputClick</attribute>
            <attribute name="t-on-input">onInputTyped</attribute>
        </xpath>
    </t>

    <t t-name="equipment_timesheet.TimePickerPopover">
        <div class="d-flex align-items-center gap-1 p-2">
            <select class="o_hour_selection form-select form-select-sm w-auto" t-model="state.hours" t-on-change="onChange">
                <t t-foreach="availableHours" t-as="unit" t-key="unit[0]">
                    <option t-att-value="unit[0]" t-att-selected="unit[0] == state.hours" t-esc="unit[1]"/>
                </t>
            </select>
            <span>:</span>
            <select class="o_minute_selection form-select form-select-sm w-auto" t-model="state.minutes" t-on-change="onChange">
                <t t-foreach="availableMinutes" t-as="unit" t-key="unit[0]">
                    <option t-att-value="unit[0]" t-att-selected="unit[0] == state.minutes" t-esc="unit[1]"/>
                </t>
            </select>
        </div>
    </t>
</templates>
